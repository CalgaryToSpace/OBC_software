1815:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim_ex.c ****   if ((InputTrigger == TIM_TS_ITR0) || (InputTrigger == TIM_TS_ITR1) ||
1816:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim_ex.c ****       (InputTrigger == TIM_TS_ITR2) || (InputTrigger == TIM_TS_ITR3))
