1829:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim_ex.c ****   /* Disable Commutation Interrupt */
1830:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim_ex.c ****   __HAL_TIM_DISABLE_IT(htim, TIM_IT_COM);
1831:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim_ex.c **** 
1832:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim_ex.c ****   /* Disable Commutation DMA request */
1833:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim_ex.c ****   __HAL_TIM_DISABLE_DMA(htim, TIM_DMA_COM);
