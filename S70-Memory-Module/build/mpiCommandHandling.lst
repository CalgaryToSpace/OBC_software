 156:Core/Src/mpiCommandHandling.c **** void processFrameData(MpiFrame_t frame)
 157:Core/Src/mpiCommandHandling.c **** {
 158:Core/Src/mpiCommandHandling.c **** 
 159:Core/Src/mpiCommandHandling.c **** 	// Define an array of buffers for each variable in the structure that needs to be tested
