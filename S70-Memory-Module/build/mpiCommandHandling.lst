 167:Core/Src/mpiCommandHandling.c **** 			"Frame Counter: %u, Board Temperature: %u, Voltage ADC Reading: %u\n",
 168:Core/Src/mpiCommandHandling.c **** 			frame.frame_counter, frame.board_temperature,
 169:Core/Src/mpiCommandHandling.c **** 			frame.faceplate_voltage_adc_reading);
 170:Core/Src/mpiCommandHandling.c **** 
 171:Core/Src/mpiCommandHandling.c **** 	// Send formatted data over HLPUART for verification
 172:Core/Src/mpiCommandHandling.c **** 	// HAL_UART_Transmit(&hlpuart1, (uint8_t*)variable_buffer, strlen(variable_buffer), HAL_MAX_DELAY)
 173:Core/Src/mpiCommandHandling.c **** 	PRINT_STRING_UART(variable_buffer);
 174:Core/Src/mpiCommandHandling.c **** 
