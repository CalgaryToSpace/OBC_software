 120:Core/Src/mpiCommandHandling.c **** void processIncomingMPIFramesTask(void *pvParameters)
 121:Core/Src/mpiCommandHandling.c **** {
 122:Core/Src/mpiCommandHandling.c **** 	MpiFrame_t frame;
 123:Core/Src/mpiCommandHandling.c **** 
 124:Core/Src/mpiCommandHandling.c **** 	while (1)
 125:Core/Src/mpiCommandHandling.c **** 	{
 126:Core/Src/mpiCommandHandling.c **** 		// Wait until data is ready in the buffer
 127:Core/Src/mpiCommandHandling.c **** 		if (xSemaphoreTake(MPIFrameBuffer.dataReady, portMAX_DELAY) == pdTRUE)
 128:Core/Src/mpiCommandHandling.c **** 		{
 129:Core/Src/mpiCommandHandling.c **** 			// Read data from double buffer
 130:Core/Src/mpiCommandHandling.c **** 			uint32_t bytesRead = DoubleBuffer_Read(&MPIFrameBuffer, (uint8_t *)&frame, sizeof(MpiFrame_t));
 131:Core/Src/mpiCommandHandling.c **** 
 132:Core/Src/mpiCommandHandling.c **** 			if (bytesRead > 0)
 133:Core/Src/mpiCommandHandling.c **** 			{
 134:Core/Src/mpiCommandHandling.c **** 				processFrameData(frame);
 135:Core/Src/mpiCommandHandling.c **** 			}
 136:Core/Src/mpiCommandHandling.c **** 		}
 137:Core/Src/mpiCommandHandling.c **** 	}
 138:Core/Src/mpiCommandHandling.c **** 
 139:Core/Src/mpiCommandHandling.c **** 	// Add delay or yield to FreeRTOS if necessary
 140:Core/Src/mpiCommandHandling.c **** 	// vTaskDelay(pdMS_TO_TICKS(100));
 141:Core/Src/mpiCommandHandling.c **** 	taskYIELD(); // Yield to other tasks to prevent busy-waiting
 142:Core/Src/mpiCommandHandling.c **** }
