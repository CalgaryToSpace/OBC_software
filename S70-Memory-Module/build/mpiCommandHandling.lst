  20:Core/Src/mpiCommandHandling.c **** /**
  21:Core/Src/mpiCommandHandling.c ****  * Sends a command to the MPI over UART and returns back the MPI response code (success / fail)
  22:Core/Src/mpiCommandHandling.c ****  */
  23:Core/Src/mpiCommandHandling.c **** uint8_t sendTelecommand(uint8_t commandCode, const uint8_t *params)
  24:Core/Src/mpiCommandHandling.c **** {
  25:Core/Src/mpiCommandHandling.c **** 
  26:Core/Src/mpiCommandHandling.c **** 	size_t paramSize = sizeof(params);
  27:Core/Src/mpiCommandHandling.c **** 	uint8_t UART1_txBuffer[3 + paramSize]; // Buffer stores outgoing tele-command frame
  28:Core/Src/mpiCommandHandling.c **** 	uint8_t UART1_rxBuffer[4];			   // Buffer stores incoming tele-command response from the MPI (comm
  29:Core/Src/mpiCommandHandling.c **** 
ARM GAS  C:\Users\vaibh\AppData\Local\Temp\cc0zeCD4.s 			page 2


  30:Core/Src/mpiCommandHandling.c **** 	// Add “TC” bytes to the buffer (Tele-Command identifier)
  31:Core/Src/mpiCommandHandling.c **** 	UART1_txBuffer[0] = 0x54;
  32:Core/Src/mpiCommandHandling.c **** 	UART1_txBuffer[1] = 0x43;
  33:Core/Src/mpiCommandHandling.c **** 
  34:Core/Src/mpiCommandHandling.c **** 	// Add the command code to the buffer
  35:Core/Src/mpiCommandHandling.c **** 	UART1_txBuffer[2] = commandCode;
  36:Core/Src/mpiCommandHandling.c **** 
  37:Core/Src/mpiCommandHandling.c **** 	// Add the parameters to the buffer if any
  38:Core/Src/mpiCommandHandling.c **** 	if (paramSize != 0)
  39:Core/Src/mpiCommandHandling.c **** 	{
  40:Core/Src/mpiCommandHandling.c **** 		for (size_t i = 0; i < paramSize; i++)
  41:Core/Src/mpiCommandHandling.c **** 		{
  42:Core/Src/mpiCommandHandling.c **** 			UART1_txBuffer[3 + i] = params[i];
  43:Core/Src/mpiCommandHandling.c **** 		}
  44:Core/Src/mpiCommandHandling.c **** 	}
  45:Core/Src/mpiCommandHandling.c **** 
  46:Core/Src/mpiCommandHandling.c **** 	//	// Append parameters onto the TX buffer if any
  47:Core/Src/mpiCommandHandling.c **** 	//	if (parameters != 0xFF) {
  48:Core/Src/mpiCommandHandling.c **** 	//		UART1_txBuffer[3] = parameters;
  49:Core/Src/mpiCommandHandling.c **** 	//	}
  50:Core/Src/mpiCommandHandling.c **** 
  51:Core/Src/mpiCommandHandling.c **** 	// Transmit the command & receive echo from the MPI TODO: confirm why char* for size
  52:Core/Src/mpiCommandHandling.c **** 	HAL_UART_Transmit(&huart1, (uint8_t *)UART1_txBuffer, strlen((char *)UART1_txBuffer), 100);
  53:Core/Src/mpiCommandHandling.c **** 	HAL_UART_Receive_DMA(&huart1, UART1_rxBuffer, BUFFER_SIZE);
  54:Core/Src/mpiCommandHandling.c **** 
  55:Core/Src/mpiCommandHandling.c **** 	// Return the response code from the MPI TODO: confirm what exactly is echoed back, are parameters
  56:Core/Src/mpiCommandHandling.c **** 	return UART1_rxBuffer[(sizeof(UART1_rxBuffer) / sizeof(UART1_rxBuffer[0])) - 1];
  57:Core/Src/mpiCommandHandling.c **** }
