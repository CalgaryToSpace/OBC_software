5610:Core/Src/littlefs/lfs.c ****         }
5611:Core/Src/littlefs/lfs.c **** 
5612:Core/Src/littlefs/lfs.c ****         uint16_t major_version = (0xffff & (superblock.d.version >> 16));
5613:Core/Src/littlefs/lfs.c ****         uint16_t minor_version = (0xffff & (superblock.d.version >>  0));
