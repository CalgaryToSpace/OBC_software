5599:Core/Src/littlefs/lfs.c ****             }
5600:Core/Src/littlefs/lfs.c **** 
5601:Core/Src/littlefs/lfs.c ****             lfs->lfs1->root[0] = superblock.d.root[0];
5602:Core/Src/littlefs/lfs.c ****             lfs->lfs1->root[1] = superblock.d.root[1];
5603:Core/Src/littlefs/lfs.c ****         }
5604:Core/Src/littlefs/lfs.c **** 
5605:Core/Src/littlefs/lfs.c ****         if (err || memcmp(superblock.d.magic, "littlefs", 8) != 0) {
5606:Core/Src/littlefs/lfs.c ****             LFS_ERROR("Invalid superblock at {0x%"PRIx32", 0x%"PRIx32"}",
5607:Core/Src/littlefs/lfs.c ****                     0, 1);
