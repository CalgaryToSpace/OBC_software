 162:Core/Inc/./LittleFS/lfs_util.h **** // Find the sequence comparison of a and b, this is the distance
 163:Core/Inc/./LittleFS/lfs_util.h **** // between a and b ignoring overflow
 164:Core/Inc/./LittleFS/lfs_util.h **** static inline int lfs_scmp(uint32_t a, uint32_t b) {
