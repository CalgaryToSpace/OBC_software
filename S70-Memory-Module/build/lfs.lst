 116:Core/Inc/./LittleFS/lfs_util.h **** // Align to nearest multiple of a size
 117:Core/Inc/./LittleFS/lfs_util.h **** static inline uint32_t lfs_aligndown(uint32_t a, uint32_t alignment) {
 118:Core/Inc/./LittleFS/lfs_util.h ****     return a - (a % alignment);
 119:Core/Inc/./LittleFS/lfs_util.h **** }
 120:Core/Inc/./LittleFS/lfs_util.h **** 
 121:Core/Inc/./LittleFS/lfs_util.h **** static inline uint32_t lfs_alignup(uint32_t a, uint32_t alignment) {
 122:Core/Inc/./LittleFS/lfs_util.h ****     return lfs_aligndown(a + alignment-1, alignment);
 123:Core/Inc/./LittleFS/lfs_util.h **** }
 124:Core/Inc/./LittleFS/lfs_util.h **** 
 125:Core/Inc/./LittleFS/lfs_util.h **** // Find the smallest power of 2 greater than or equal to a
 126:Core/Inc/./LittleFS/lfs_util.h **** static inline uint32_t lfs_npw2(uint32_t a) {
 127:Core/Inc/./LittleFS/lfs_util.h **** #if !defined(LFS_NO_INTRINSICS) && (defined(__GNUC__) || defined(__CC_ARM))
 128:Core/Inc/./LittleFS/lfs_util.h ****     return 32 - __builtin_clz(a-1);
 129:Core/Inc/./LittleFS/lfs_util.h **** #else
 130:Core/Inc/./LittleFS/lfs_util.h ****     uint32_t r = 0;
 131:Core/Inc/./LittleFS/lfs_util.h ****     uint32_t s;
 132:Core/Inc/./LittleFS/lfs_util.h ****     a -= 1;
 133:Core/Inc/./LittleFS/lfs_util.h ****     s = (a > 0xffff) << 4; a >>= s; r |= s;
 134:Core/Inc/./LittleFS/lfs_util.h ****     s = (a > 0xff  ) << 3; a >>= s; r |= s;
 135:Core/Inc/./LittleFS/lfs_util.h ****     s = (a > 0xf   ) << 2; a >>= s; r |= s;
 136:Core/Inc/./LittleFS/lfs_util.h ****     s = (a > 0x3   ) << 1; a >>= s; r |= s;
 137:Core/Inc/./LittleFS/lfs_util.h ****     return (r | (a >> 1)) + 1;
 138:Core/Inc/./LittleFS/lfs_util.h **** #endif
 139:Core/Inc/./LittleFS/lfs_util.h **** }
