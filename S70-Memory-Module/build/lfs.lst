2039:Core/Src/littlefs/lfs.c ****                     }
2040:Core/Src/littlefs/lfs.c ****                     return err;
2041:Core/Src/littlefs/lfs.c ****                 }
2042:Core/Src/littlefs/lfs.c ****             }
2043:Core/Src/littlefs/lfs.c **** 
2044:Core/Src/littlefs/lfs.c ****             // complete commit with crc
2045:Core/Src/littlefs/lfs.c ****             err = lfs_dir_commitcrc(lfs, &commit);
2046:Core/Src/littlefs/lfs.c ****             if (err) {
2047:Core/Src/littlefs/lfs.c ****                 if (err == LFS_ERR_CORRUPT) {
2048:Core/Src/littlefs/lfs.c ****                     goto relocate;
2049:Core/Src/littlefs/lfs.c ****                 }
2050:Core/Src/littlefs/lfs.c ****                 return err;
2051:Core/Src/littlefs/lfs.c ****             }
2052:Core/Src/littlefs/lfs.c **** 
2053:Core/Src/littlefs/lfs.c ****             // successful compaction, swap dir pair to indicate most recent
2054:Core/Src/littlefs/lfs.c ****             LFS_ASSERT(commit.off % lfs->cfg->prog_size == 0);
2055:Core/Src/littlefs/lfs.c ****             lfs_pair_swap(dir->pair);
2056:Core/Src/littlefs/lfs.c ****             dir->count = end - begin;
2057:Core/Src/littlefs/lfs.c ****             dir->off = commit.off;
2058:Core/Src/littlefs/lfs.c ****             dir->etag = commit.ptag;
2059:Core/Src/littlefs/lfs.c ****             // update gstate
2060:Core/Src/littlefs/lfs.c ****             lfs->gdelta = (lfs_gstate_t){0};
2061:Core/Src/littlefs/lfs.c ****             if (!relocated) {
2062:Core/Src/littlefs/lfs.c ****                 lfs->gdisk = lfs->gstate;
