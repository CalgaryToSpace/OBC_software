2408:Core/Src/littlefs/lfs.c ****     }
2409:Core/Src/littlefs/lfs.c **** 
2410:Core/Src/littlefs/lfs.c ****     // commit was successful, but may require other changes in the
2411:Core/Src/littlefs/lfs.c ****     // filesystem, these would normally be tail recursive, but we have
2412:Core/Src/littlefs/lfs.c ****     // flattened them here avoid unbounded stack usage
2413:Core/Src/littlefs/lfs.c **** 
2414:Core/Src/littlefs/lfs.c ****     // need to drop?
2415:Core/Src/littlefs/lfs.c ****     if (state == LFS_OK_DROPPED) {
2416:Core/Src/littlefs/lfs.c ****         // steal state
2417:Core/Src/littlefs/lfs.c ****         int err = lfs_dir_getgstate(lfs, dir, &lfs->gdelta);
2418:Core/Src/littlefs/lfs.c ****         if (err) {
2419:Core/Src/littlefs/lfs.c ****             return err;
2420:Core/Src/littlefs/lfs.c ****         }
2421:Core/Src/littlefs/lfs.c **** 
2422:Core/Src/littlefs/lfs.c ****         // steal tail, note that this can't create a recursive drop
2423:Core/Src/littlefs/lfs.c ****         lpair[0] = pdir.pair[0];
2424:Core/Src/littlefs/lfs.c ****         lpair[1] = pdir.pair[1];
2425:Core/Src/littlefs/lfs.c ****         lfs_pair_tole32(dir->tail);
2426:Core/Src/littlefs/lfs.c ****         state = lfs_dir_relocatingcommit(lfs, &pdir, lpair, LFS_MKATTRS(
2427:Core/Src/littlefs/lfs.c ****                     {LFS_MKTAG(LFS_TYPE_TAIL + dir->split, 0x3ff, 8),
2428:Core/Src/littlefs/lfs.c ****                         dir->tail}),
2429:Core/Src/littlefs/lfs.c ****                 NULL);
2430:Core/Src/littlefs/lfs.c ****         lfs_pair_fromle32(dir->tail);
2431:Core/Src/littlefs/lfs.c ****         if (state < 0) {
2432:Core/Src/littlefs/lfs.c ****             return state;
2433:Core/Src/littlefs/lfs.c ****         }
2434:Core/Src/littlefs/lfs.c **** 
2435:Core/Src/littlefs/lfs.c ****         ldir = pdir;
2436:Core/Src/littlefs/lfs.c ****     }
2437:Core/Src/littlefs/lfs.c **** 
2438:Core/Src/littlefs/lfs.c ****     // need to relocate?
2439:Core/Src/littlefs/lfs.c ****     bool orphans = false;
2440:Core/Src/littlefs/lfs.c ****     while (state == LFS_OK_RELOCATED) {
2441:Core/Src/littlefs/lfs.c ****         LFS_DEBUG("Relocating {0x%"PRIx32", 0x%"PRIx32"} "
2442:Core/Src/littlefs/lfs.c ****                     "-> {0x%"PRIx32", 0x%"PRIx32"}",
2443:Core/Src/littlefs/lfs.c ****                 lpair[0], lpair[1], ldir.pair[0], ldir.pair[1]);
