5711:Core/Src/littlefs/lfs.c **** 
5712:Core/Src/littlefs/lfs.c ****                 bool isdir = (entry1.d.type == LFS1_TYPE_DIR);
5713:Core/Src/littlefs/lfs.c **** 
5714:Core/Src/littlefs/lfs.c ****                 // create entry in new dir
5715:Core/Src/littlefs/lfs.c ****                 err = lfs_dir_fetch(lfs, &dir2, lfs->root);
5716:Core/Src/littlefs/lfs.c ****                 if (err) {
5717:Core/Src/littlefs/lfs.c ****                     goto cleanup;
5718:Core/Src/littlefs/lfs.c ****                 }
