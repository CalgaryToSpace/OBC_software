5692:Core/Src/littlefs/lfs.c ****                         goto cleanup;
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 592


5693:Core/Src/littlefs/lfs.c ****                     }
5694:Core/Src/littlefs/lfs.c **** 
5695:Core/Src/littlefs/lfs.c ****                     if (moved) {
5696:Core/Src/littlefs/lfs.c ****                         continue;
5697:Core/Src/littlefs/lfs.c ****                     }
5698:Core/Src/littlefs/lfs.c **** 
5699:Core/Src/littlefs/lfs.c ****                     entry1.d.type &= ~0x80;
5700:Core/Src/littlefs/lfs.c ****                 }
5701:Core/Src/littlefs/lfs.c **** 
5702:Core/Src/littlefs/lfs.c ****                 // also fetch name
5703:Core/Src/littlefs/lfs.c ****                 char name[LFS_NAME_MAX+1];
5704:Core/Src/littlefs/lfs.c ****                 memset(name, 0, sizeof(name));
5705:Core/Src/littlefs/lfs.c ****                 err = lfs1_bd_read(lfs, dir1.pair[0],
5706:Core/Src/littlefs/lfs.c ****                         entry1.off + 4+entry1.d.elen+entry1.d.alen,
5707:Core/Src/littlefs/lfs.c ****                         name, entry1.d.nlen);
5708:Core/Src/littlefs/lfs.c ****                 if (err) {
