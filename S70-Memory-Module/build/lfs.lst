5364:Core/Src/littlefs/lfs.c **** static int lfs1_dir_fetch(lfs_t *lfs,
5365:Core/Src/littlefs/lfs.c ****         lfs1_dir_t *dir, const lfs_block_t pair[2]) {
5366:Core/Src/littlefs/lfs.c ****     // copy out pair, otherwise may be aliasing dir
5367:Core/Src/littlefs/lfs.c ****     const lfs_block_t tpair[2] = {pair[0], pair[1]};
5368:Core/Src/littlefs/lfs.c ****     bool valid = false;
5369:Core/Src/littlefs/lfs.c **** 
5370:Core/Src/littlefs/lfs.c ****     // check both blocks for the most recent revision
5371:Core/Src/littlefs/lfs.c ****     for (int i = 0; i < 2; i++) {
5372:Core/Src/littlefs/lfs.c ****         struct lfs1_disk_dir test;
5373:Core/Src/littlefs/lfs.c ****         int err = lfs1_bd_read(lfs, tpair[i], 0, &test, sizeof(test));
5374:Core/Src/littlefs/lfs.c ****         lfs1_dir_fromle32(&test);
5375:Core/Src/littlefs/lfs.c ****         if (err) {
5376:Core/Src/littlefs/lfs.c ****             if (err == LFS_ERR_CORRUPT) {
5377:Core/Src/littlefs/lfs.c ****                 continue;
5378:Core/Src/littlefs/lfs.c ****             }
5379:Core/Src/littlefs/lfs.c ****             return err;
5380:Core/Src/littlefs/lfs.c ****         }
5381:Core/Src/littlefs/lfs.c **** 
