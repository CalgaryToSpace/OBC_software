1641:Core/Src/littlefs/lfs.c **** static int lfs_dir_commitcrc(lfs_t *lfs, struct lfs_commit *commit) {
1642:Core/Src/littlefs/lfs.c ****     // align to program units
1643:Core/Src/littlefs/lfs.c ****     //
1644:Core/Src/littlefs/lfs.c ****     // this gets a bit complex as we have two types of crcs:
1645:Core/Src/littlefs/lfs.c ****     // - 5-word crc with fcrc to check following prog (middle of block)
1646:Core/Src/littlefs/lfs.c ****     // - 2-word crc with no following prog (end of block)
1647:Core/Src/littlefs/lfs.c ****     const lfs_off_t end = lfs_alignup(
1648:Core/Src/littlefs/lfs.c ****             lfs_min(commit->off + 5*sizeof(uint32_t), lfs->cfg->block_size),
1649:Core/Src/littlefs/lfs.c ****             lfs->cfg->prog_size);
1650:Core/Src/littlefs/lfs.c **** 
1651:Core/Src/littlefs/lfs.c ****     lfs_off_t off1 = 0;
1652:Core/Src/littlefs/lfs.c ****     uint32_t crc1 = 0;
1653:Core/Src/littlefs/lfs.c **** 
1654:Core/Src/littlefs/lfs.c ****     // create crc tags to fill up remainder of commit, note that
1655:Core/Src/littlefs/lfs.c ****     // padding is not crced, which lets fetches skip padding but
1656:Core/Src/littlefs/lfs.c ****     // makes committing a bit more complicated
1657:Core/Src/littlefs/lfs.c ****     while (commit->off < end) {
1658:Core/Src/littlefs/lfs.c ****         lfs_off_t noff = (
1659:Core/Src/littlefs/lfs.c ****                 lfs_min(end - (commit->off+sizeof(lfs_tag_t)), 0x3fe)
1660:Core/Src/littlefs/lfs.c ****                 + (commit->off+sizeof(lfs_tag_t)));
1661:Core/Src/littlefs/lfs.c ****         // too large for crc tag? need padding commits
1662:Core/Src/littlefs/lfs.c ****         if (noff < end) {
1663:Core/Src/littlefs/lfs.c ****             noff = lfs_min(noff, end - 5*sizeof(uint32_t));
1664:Core/Src/littlefs/lfs.c ****         }
1665:Core/Src/littlefs/lfs.c **** 
1666:Core/Src/littlefs/lfs.c ****         // space for fcrc?
1667:Core/Src/littlefs/lfs.c ****         uint8_t eperturb = (uint8_t)-1;
1668:Core/Src/littlefs/lfs.c ****         if (noff >= end && noff <= lfs->cfg->block_size - lfs->cfg->prog_size) {
1669:Core/Src/littlefs/lfs.c ****             // first read the leading byte, this always contains a bit
1670:Core/Src/littlefs/lfs.c ****             // we can perturb to avoid writes that don't change the fcrc
1671:Core/Src/littlefs/lfs.c ****             int err = lfs_bd_read(lfs,
1672:Core/Src/littlefs/lfs.c ****                     NULL, &lfs->rcache, lfs->cfg->prog_size,
1673:Core/Src/littlefs/lfs.c ****                     commit->block, noff, &eperturb, 1);
1674:Core/Src/littlefs/lfs.c ****             if (err && err != LFS_ERR_CORRUPT) {
1675:Core/Src/littlefs/lfs.c ****                 return err;
1676:Core/Src/littlefs/lfs.c ****             }
1677:Core/Src/littlefs/lfs.c **** 
1678:Core/Src/littlefs/lfs.c ****         #ifdef LFS_MULTIVERSION
1679:Core/Src/littlefs/lfs.c ****             // unfortunately fcrcs break mdir fetching < lfs2.1, so only write
1680:Core/Src/littlefs/lfs.c ****             // these if we're a >= lfs2.1 filesystem
1681:Core/Src/littlefs/lfs.c ****             if (lfs_fs_disk_version(lfs) <= 0x00020000) {
1682:Core/Src/littlefs/lfs.c ****                 // don't write fcrc
1683:Core/Src/littlefs/lfs.c ****             } else
1684:Core/Src/littlefs/lfs.c ****         #endif
1685:Core/Src/littlefs/lfs.c ****             {
1686:Core/Src/littlefs/lfs.c ****                 // find the expected fcrc, don't bother avoiding a reread
1687:Core/Src/littlefs/lfs.c ****                 // of the eperturb, it should still be in our cache
1688:Core/Src/littlefs/lfs.c ****                 struct lfs_fcrc fcrc = {
1689:Core/Src/littlefs/lfs.c ****                     .size = lfs->cfg->prog_size,
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 46


1690:Core/Src/littlefs/lfs.c ****                     .crc = 0xffffffff
1691:Core/Src/littlefs/lfs.c ****                 };
1692:Core/Src/littlefs/lfs.c ****                 err = lfs_bd_crc(lfs,
1693:Core/Src/littlefs/lfs.c ****                         NULL, &lfs->rcache, lfs->cfg->prog_size,
1694:Core/Src/littlefs/lfs.c ****                         commit->block, noff, fcrc.size, &fcrc.crc);
1695:Core/Src/littlefs/lfs.c ****                 if (err && err != LFS_ERR_CORRUPT) {
1696:Core/Src/littlefs/lfs.c ****                     return err;
1697:Core/Src/littlefs/lfs.c ****                 }
1698:Core/Src/littlefs/lfs.c **** 
1699:Core/Src/littlefs/lfs.c ****                 lfs_fcrc_tole32(&fcrc);
1700:Core/Src/littlefs/lfs.c ****                 err = lfs_dir_commitattr(lfs, commit,
1701:Core/Src/littlefs/lfs.c ****                         LFS_MKTAG(LFS_TYPE_FCRC, 0x3ff, sizeof(struct lfs_fcrc)),
1702:Core/Src/littlefs/lfs.c ****                         &fcrc);
1703:Core/Src/littlefs/lfs.c ****                 if (err) {
1704:Core/Src/littlefs/lfs.c ****                     return err;
1705:Core/Src/littlefs/lfs.c ****                 }
1706:Core/Src/littlefs/lfs.c ****             }
1707:Core/Src/littlefs/lfs.c ****         }
1708:Core/Src/littlefs/lfs.c **** 
1709:Core/Src/littlefs/lfs.c ****         // build commit crc
1710:Core/Src/littlefs/lfs.c ****         struct {
1711:Core/Src/littlefs/lfs.c ****             lfs_tag_t tag;
1712:Core/Src/littlefs/lfs.c ****             uint32_t crc;
1713:Core/Src/littlefs/lfs.c ****         } ccrc;
1714:Core/Src/littlefs/lfs.c ****         lfs_tag_t ntag = LFS_MKTAG(
1715:Core/Src/littlefs/lfs.c ****                 LFS_TYPE_CCRC + (((uint8_t)~eperturb) >> 7), 0x3ff,
1716:Core/Src/littlefs/lfs.c ****                 noff - (commit->off+sizeof(lfs_tag_t)));
1717:Core/Src/littlefs/lfs.c ****         ccrc.tag = lfs_tobe32(ntag ^ commit->ptag);
1718:Core/Src/littlefs/lfs.c ****         commit->crc = lfs_crc(commit->crc, &ccrc.tag, sizeof(lfs_tag_t));
1719:Core/Src/littlefs/lfs.c ****         ccrc.crc = lfs_tole32(commit->crc);
1720:Core/Src/littlefs/lfs.c **** 
1721:Core/Src/littlefs/lfs.c ****         int err = lfs_bd_prog(lfs,
1722:Core/Src/littlefs/lfs.c ****                 &lfs->pcache, &lfs->rcache, false,
1723:Core/Src/littlefs/lfs.c ****                 commit->block, commit->off, &ccrc, sizeof(ccrc));
1724:Core/Src/littlefs/lfs.c ****         if (err) {
1725:Core/Src/littlefs/lfs.c ****             return err;
1726:Core/Src/littlefs/lfs.c ****         }
1727:Core/Src/littlefs/lfs.c **** 
1728:Core/Src/littlefs/lfs.c ****         // keep track of non-padding checksum to verify
1729:Core/Src/littlefs/lfs.c ****         if (off1 == 0) {
1730:Core/Src/littlefs/lfs.c ****             off1 = commit->off + sizeof(lfs_tag_t);
1731:Core/Src/littlefs/lfs.c ****             crc1 = commit->crc;
1732:Core/Src/littlefs/lfs.c ****         }
1733:Core/Src/littlefs/lfs.c **** 
1734:Core/Src/littlefs/lfs.c ****         commit->off = noff;
1735:Core/Src/littlefs/lfs.c ****         // perturb valid bit?
1736:Core/Src/littlefs/lfs.c ****         commit->ptag = ntag ^ ((0x80UL & ~eperturb) << 24);
1737:Core/Src/littlefs/lfs.c ****         // reset crc for next commit
1738:Core/Src/littlefs/lfs.c ****         commit->crc = 0xffffffff;
1739:Core/Src/littlefs/lfs.c **** 
1740:Core/Src/littlefs/lfs.c ****         // manually flush here since we don't prog the padding, this confuses
1741:Core/Src/littlefs/lfs.c ****         // the caching layer
1742:Core/Src/littlefs/lfs.c ****         if (noff >= end || noff >= lfs->pcache.off + lfs->cfg->cache_size) {
1743:Core/Src/littlefs/lfs.c ****             // flush buffers
1744:Core/Src/littlefs/lfs.c ****             int err = lfs_bd_sync(lfs, &lfs->pcache, &lfs->rcache, false);
1745:Core/Src/littlefs/lfs.c ****             if (err) {
1746:Core/Src/littlefs/lfs.c ****                 return err;
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 47


1747:Core/Src/littlefs/lfs.c ****             }
1748:Core/Src/littlefs/lfs.c ****         }
1749:Core/Src/littlefs/lfs.c ****     }
1750:Core/Src/littlefs/lfs.c **** 
1751:Core/Src/littlefs/lfs.c ****     // successful commit, check checksums to make sure
1752:Core/Src/littlefs/lfs.c ****     //
1753:Core/Src/littlefs/lfs.c ****     // note that we don't need to check padding commits, worst
1754:Core/Src/littlefs/lfs.c ****     // case if they are corrupted we would have had to compact anyways
1755:Core/Src/littlefs/lfs.c ****     lfs_off_t off = commit->begin;
1756:Core/Src/littlefs/lfs.c ****     uint32_t crc = 0xffffffff;
1757:Core/Src/littlefs/lfs.c ****     int err = lfs_bd_crc(lfs,
1758:Core/Src/littlefs/lfs.c ****             NULL, &lfs->rcache, off1+sizeof(uint32_t),
1759:Core/Src/littlefs/lfs.c ****             commit->block, off, off1-off, &crc);
1760:Core/Src/littlefs/lfs.c ****     if (err) {
1761:Core/Src/littlefs/lfs.c ****         return err;
1762:Core/Src/littlefs/lfs.c ****     }
1763:Core/Src/littlefs/lfs.c **** 
1764:Core/Src/littlefs/lfs.c ****     // check non-padding commits against known crc
1765:Core/Src/littlefs/lfs.c ****     if (crc != crc1) {
1766:Core/Src/littlefs/lfs.c ****         return LFS_ERR_CORRUPT;
1767:Core/Src/littlefs/lfs.c ****     }
1768:Core/Src/littlefs/lfs.c **** 
1769:Core/Src/littlefs/lfs.c ****     // make sure to check crc in case we happen to pick
1770:Core/Src/littlefs/lfs.c ****     // up an unrelated crc (frozen block?)
1771:Core/Src/littlefs/lfs.c ****     err = lfs_bd_crc(lfs,
1772:Core/Src/littlefs/lfs.c ****             NULL, &lfs->rcache, sizeof(uint32_t),
1773:Core/Src/littlefs/lfs.c ****             commit->block, off1, sizeof(uint32_t), &crc);
1774:Core/Src/littlefs/lfs.c ****     if (err) {
1775:Core/Src/littlefs/lfs.c ****         return err;
1776:Core/Src/littlefs/lfs.c ****     }
1777:Core/Src/littlefs/lfs.c **** 
1778:Core/Src/littlefs/lfs.c ****     if (crc != 0) {
1779:Core/Src/littlefs/lfs.c ****         return LFS_ERR_CORRUPT;
1780:Core/Src/littlefs/lfs.c ****     }
1781:Core/Src/littlefs/lfs.c **** 
1782:Core/Src/littlefs/lfs.c ****     return 0;
1783:Core/Src/littlefs/lfs.c **** }
1784:Core/Src/littlefs/lfs.c **** #endif
