4901:Core/Src/littlefs/lfs.c ****     // something most likely went wrong in gstate calculation
4902:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(lfs_tag_type3(lfs->gdisk.tag) == LFS_TYPE_DELETE);
4903:Core/Src/littlefs/lfs.c **** 
