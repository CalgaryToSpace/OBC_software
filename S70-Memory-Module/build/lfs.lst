1464:Core/Src/littlefs/lfs.c **** static lfs_stag_t lfs_dir_find(lfs_t *lfs, lfs_mdir_t *dir,
1465:Core/Src/littlefs/lfs.c ****         const char **path, uint16_t *id) {
1466:Core/Src/littlefs/lfs.c ****     // we reduce path to a single name if we can find it
1467:Core/Src/littlefs/lfs.c ****     const char *name = *path;
1468:Core/Src/littlefs/lfs.c ****     if (id) {
1469:Core/Src/littlefs/lfs.c ****         *id = 0x3ff;
1470:Core/Src/littlefs/lfs.c ****     }
1471:Core/Src/littlefs/lfs.c **** 
1472:Core/Src/littlefs/lfs.c ****     // default to root dir
1473:Core/Src/littlefs/lfs.c ****     lfs_stag_t tag = LFS_MKTAG(LFS_TYPE_DIR, 0x3ff, 0);
1474:Core/Src/littlefs/lfs.c ****     dir->tail[0] = lfs->root[0];
1475:Core/Src/littlefs/lfs.c ****     dir->tail[1] = lfs->root[1];
1476:Core/Src/littlefs/lfs.c **** 
1477:Core/Src/littlefs/lfs.c ****     while (true) {
1478:Core/Src/littlefs/lfs.c **** nextname:
1479:Core/Src/littlefs/lfs.c ****         // skip slashes
1480:Core/Src/littlefs/lfs.c ****         name += strspn(name, "/");
1481:Core/Src/littlefs/lfs.c ****         lfs_size_t namelen = strcspn(name, "/");
1482:Core/Src/littlefs/lfs.c **** 
1483:Core/Src/littlefs/lfs.c ****         // skip '.' and root '..'
1484:Core/Src/littlefs/lfs.c ****         if ((namelen == 1 && memcmp(name, ".", 1) == 0) ||
1485:Core/Src/littlefs/lfs.c ****             (namelen == 2 && memcmp(name, "..", 2) == 0)) {
1486:Core/Src/littlefs/lfs.c ****             name += namelen;
1487:Core/Src/littlefs/lfs.c ****             goto nextname;
1488:Core/Src/littlefs/lfs.c ****         }
1489:Core/Src/littlefs/lfs.c **** 
1490:Core/Src/littlefs/lfs.c ****         // skip if matched by '..' in name
1491:Core/Src/littlefs/lfs.c ****         const char *suffix = name + namelen;
1492:Core/Src/littlefs/lfs.c ****         lfs_size_t sufflen;
1493:Core/Src/littlefs/lfs.c ****         int depth = 1;
1494:Core/Src/littlefs/lfs.c ****         while (true) {
1495:Core/Src/littlefs/lfs.c ****             suffix += strspn(suffix, "/");
1496:Core/Src/littlefs/lfs.c ****             sufflen = strcspn(suffix, "/");
1497:Core/Src/littlefs/lfs.c ****             if (sufflen == 0) {
1498:Core/Src/littlefs/lfs.c ****                 break;
1499:Core/Src/littlefs/lfs.c ****             }
1500:Core/Src/littlefs/lfs.c **** 
1501:Core/Src/littlefs/lfs.c ****             if (sufflen == 2 && memcmp(suffix, "..", 2) == 0) {
1502:Core/Src/littlefs/lfs.c ****                 depth -= 1;
1503:Core/Src/littlefs/lfs.c ****                 if (depth == 0) {
1504:Core/Src/littlefs/lfs.c ****                     name = suffix + sufflen;
1505:Core/Src/littlefs/lfs.c ****                     goto nextname;
1506:Core/Src/littlefs/lfs.c ****                 }
1507:Core/Src/littlefs/lfs.c ****             } else {
1508:Core/Src/littlefs/lfs.c ****                 depth += 1;
1509:Core/Src/littlefs/lfs.c ****             }
1510:Core/Src/littlefs/lfs.c **** 
1511:Core/Src/littlefs/lfs.c ****             suffix += sufflen;
1512:Core/Src/littlefs/lfs.c ****         }
1513:Core/Src/littlefs/lfs.c **** 
1514:Core/Src/littlefs/lfs.c ****         // found path
1515:Core/Src/littlefs/lfs.c ****         if (name[0] == '\0') {
1516:Core/Src/littlefs/lfs.c ****             return tag;
1517:Core/Src/littlefs/lfs.c ****         }
