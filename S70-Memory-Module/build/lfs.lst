3661:Core/Src/littlefs/lfs.c **** static lfs_soff_t lfs_file_seek_(lfs_t *lfs, lfs_file_t *file,
3662:Core/Src/littlefs/lfs.c ****         lfs_soff_t off, int whence) {
3663:Core/Src/littlefs/lfs.c ****     // find new pos
3664:Core/Src/littlefs/lfs.c ****     lfs_off_t npos = file->pos;
3665:Core/Src/littlefs/lfs.c ****     if (whence == LFS_SEEK_SET) {
3666:Core/Src/littlefs/lfs.c ****         npos = off;
3667:Core/Src/littlefs/lfs.c ****     } else if (whence == LFS_SEEK_CUR) {
3668:Core/Src/littlefs/lfs.c ****         if ((lfs_soff_t)file->pos + off < 0) {
3669:Core/Src/littlefs/lfs.c ****             return LFS_ERR_INVAL;
3670:Core/Src/littlefs/lfs.c ****         } else {
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 84


3671:Core/Src/littlefs/lfs.c ****             npos = file->pos + off;
3672:Core/Src/littlefs/lfs.c ****         }
3673:Core/Src/littlefs/lfs.c ****     } else if (whence == LFS_SEEK_END) {
3674:Core/Src/littlefs/lfs.c ****         lfs_soff_t res = lfs_file_size_(lfs, file) + off;
3675:Core/Src/littlefs/lfs.c ****         if (res < 0) {
3676:Core/Src/littlefs/lfs.c ****             return LFS_ERR_INVAL;
3677:Core/Src/littlefs/lfs.c ****         } else {
3678:Core/Src/littlefs/lfs.c ****             npos = res;
3679:Core/Src/littlefs/lfs.c ****         }
3680:Core/Src/littlefs/lfs.c ****     }
3681:Core/Src/littlefs/lfs.c **** 
3682:Core/Src/littlefs/lfs.c ****     if (npos > lfs->file_max) {
3683:Core/Src/littlefs/lfs.c ****         // file position out of range
3684:Core/Src/littlefs/lfs.c ****         return LFS_ERR_INVAL;
3685:Core/Src/littlefs/lfs.c ****     }
3686:Core/Src/littlefs/lfs.c **** 
3687:Core/Src/littlefs/lfs.c ****     if (file->pos == npos) {
3688:Core/Src/littlefs/lfs.c ****         // noop - position has not changed
3689:Core/Src/littlefs/lfs.c ****         return npos;
3690:Core/Src/littlefs/lfs.c ****     }
3691:Core/Src/littlefs/lfs.c **** 
3692:Core/Src/littlefs/lfs.c ****     // if we're only reading and our new offset is still in the file's cache
3693:Core/Src/littlefs/lfs.c ****     // we can avoid flushing and needing to reread the data
3694:Core/Src/littlefs/lfs.c ****     if (
3695:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
3696:Core/Src/littlefs/lfs.c ****         !(file->flags & LFS_F_WRITING)
3697:Core/Src/littlefs/lfs.c **** #else
3698:Core/Src/littlefs/lfs.c ****         true
3699:Core/Src/littlefs/lfs.c **** #endif
3700:Core/Src/littlefs/lfs.c ****             ) {
3701:Core/Src/littlefs/lfs.c ****         int oindex = lfs_ctz_index(lfs, &(lfs_off_t){file->pos});
3702:Core/Src/littlefs/lfs.c ****         lfs_off_t noff = npos;
3703:Core/Src/littlefs/lfs.c ****         int nindex = lfs_ctz_index(lfs, &noff);
3704:Core/Src/littlefs/lfs.c ****         if (oindex == nindex
3705:Core/Src/littlefs/lfs.c ****                 && noff >= file->cache.off
3706:Core/Src/littlefs/lfs.c ****                 && noff < file->cache.off + file->cache.size) {
3707:Core/Src/littlefs/lfs.c ****             file->pos = npos;
3708:Core/Src/littlefs/lfs.c ****             file->off = noff;
3709:Core/Src/littlefs/lfs.c ****             return npos;
3710:Core/Src/littlefs/lfs.c ****         }
3711:Core/Src/littlefs/lfs.c ****     }
3712:Core/Src/littlefs/lfs.c **** 
3713:Core/Src/littlefs/lfs.c ****     // write out everything beforehand, may be noop if rdonly
3714:Core/Src/littlefs/lfs.c ****     int err = lfs_file_flush(lfs, file);
3715:Core/Src/littlefs/lfs.c ****     if (err) {
3716:Core/Src/littlefs/lfs.c ****         return err;
3717:Core/Src/littlefs/lfs.c ****     }
3718:Core/Src/littlefs/lfs.c **** 
3719:Core/Src/littlefs/lfs.c ****     // update pos
3720:Core/Src/littlefs/lfs.c ****     file->pos = npos;
3721:Core/Src/littlefs/lfs.c ****     return npos;
3722:Core/Src/littlefs/lfs.c **** }
