2688:Core/Src/littlefs/lfs.c **** static int lfs_dir_open_(lfs_t *lfs, lfs_dir_t *dir, const char *path) {
2689:Core/Src/littlefs/lfs.c ****     lfs_stag_t tag = lfs_dir_find(lfs, &dir->m, &path, NULL);
