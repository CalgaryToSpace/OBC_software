1620:Core/Src/littlefs/lfs.c ****             err = lfs_bd_read(lfs,
1621:Core/Src/littlefs/lfs.c ****                     NULL, &lfs->rcache, dsize-sizeof(tag)-i,
1622:Core/Src/littlefs/lfs.c ****                     disk->block, disk->off+i, &dat, 1);
1623:Core/Src/littlefs/lfs.c ****             if (err) {
1624:Core/Src/littlefs/lfs.c ****                 return err;
1625:Core/Src/littlefs/lfs.c ****             }
1626:Core/Src/littlefs/lfs.c **** 
1627:Core/Src/littlefs/lfs.c ****             err = lfs_dir_commitprog(lfs, commit, &dat, 1);
1628:Core/Src/littlefs/lfs.c ****             if (err) {
1629:Core/Src/littlefs/lfs.c ****                 return err;
1630:Core/Src/littlefs/lfs.c ****             }
1631:Core/Src/littlefs/lfs.c ****         }
1632:Core/Src/littlefs/lfs.c ****     }
