2231:Core/Src/littlefs/lfs.c ****         if (err && err != LFS_ERR_NOENT) {
2232:Core/Src/littlefs/lfs.c ****             return err;
2233:Core/Src/littlefs/lfs.c ****         }
2234:Core/Src/littlefs/lfs.c **** 
2235:Core/Src/littlefs/lfs.c ****         if (err != LFS_ERR_NOENT && pdir->split) {
2236:Core/Src/littlefs/lfs.c ****             state = LFS_OK_DROPPED;
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 58


2237:Core/Src/littlefs/lfs.c ****             goto fixmlist;
