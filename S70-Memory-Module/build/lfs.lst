2839:Core/Src/littlefs/lfs.c **** /// File index list operations ///
2840:Core/Src/littlefs/lfs.c **** static int lfs_ctz_index(lfs_t *lfs, lfs_off_t *off) {
2841:Core/Src/littlefs/lfs.c ****     lfs_off_t size = *off;
2842:Core/Src/littlefs/lfs.c ****     lfs_off_t b = lfs->cfg->block_size - 2*4;
2843:Core/Src/littlefs/lfs.c ****     lfs_off_t i = size / b;
2844:Core/Src/littlefs/lfs.c ****     if (i == 0) {
2845:Core/Src/littlefs/lfs.c ****         return 0;
2846:Core/Src/littlefs/lfs.c ****     }
2847:Core/Src/littlefs/lfs.c **** 
2848:Core/Src/littlefs/lfs.c ****     i = (size - 4*(lfs_popc(i-1)+2)) / b;
2849:Core/Src/littlefs/lfs.c ****     *off = size - b*i - 4*lfs_popc(i);
2850:Core/Src/littlefs/lfs.c ****     return i;
2851:Core/Src/littlefs/lfs.c **** }
2852:Core/Src/littlefs/lfs.c **** 
2853:Core/Src/littlefs/lfs.c **** static int lfs_ctz_find(lfs_t *lfs,
2854:Core/Src/littlefs/lfs.c ****         const lfs_cache_t *pcache, lfs_cache_t *rcache,
2855:Core/Src/littlefs/lfs.c ****         lfs_block_t head, lfs_size_t size,
2856:Core/Src/littlefs/lfs.c ****         lfs_size_t pos, lfs_block_t *block, lfs_off_t *off) {
2857:Core/Src/littlefs/lfs.c ****     if (size == 0) {
2858:Core/Src/littlefs/lfs.c ****         *block = LFS_BLOCK_NULL;
2859:Core/Src/littlefs/lfs.c ****         *off = 0;
2860:Core/Src/littlefs/lfs.c ****         return 0;
2861:Core/Src/littlefs/lfs.c ****     }
2862:Core/Src/littlefs/lfs.c **** 
2863:Core/Src/littlefs/lfs.c ****     lfs_off_t current = lfs_ctz_index(lfs, &(lfs_off_t){size-1});
2864:Core/Src/littlefs/lfs.c ****     lfs_off_t target = lfs_ctz_index(lfs, &pos);
2865:Core/Src/littlefs/lfs.c **** 
2866:Core/Src/littlefs/lfs.c ****     while (current > target) {
2867:Core/Src/littlefs/lfs.c ****         lfs_size_t skip = lfs_min(
2868:Core/Src/littlefs/lfs.c ****                 lfs_npw2(current-target+1) - 1,
2869:Core/Src/littlefs/lfs.c ****                 lfs_ctz(current));
2870:Core/Src/littlefs/lfs.c **** 
2871:Core/Src/littlefs/lfs.c ****         int err = lfs_bd_read(lfs,
2872:Core/Src/littlefs/lfs.c ****                 pcache, rcache, sizeof(head),
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 70


2873:Core/Src/littlefs/lfs.c ****                 head, 4*skip, &head, sizeof(head));
2874:Core/Src/littlefs/lfs.c ****         head = lfs_fromle32(head);
2875:Core/Src/littlefs/lfs.c ****         if (err) {
2876:Core/Src/littlefs/lfs.c ****             return err;
2877:Core/Src/littlefs/lfs.c ****         }
2878:Core/Src/littlefs/lfs.c **** 
2879:Core/Src/littlefs/lfs.c ****         current -= 1 << skip;
2880:Core/Src/littlefs/lfs.c ****     }
2881:Core/Src/littlefs/lfs.c **** 
2882:Core/Src/littlefs/lfs.c ****     *block = head;
2883:Core/Src/littlefs/lfs.c ****     *off = pos;
2884:Core/Src/littlefs/lfs.c ****     return 0;
2885:Core/Src/littlefs/lfs.c **** }
2886:Core/Src/littlefs/lfs.c **** 
2887:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
2888:Core/Src/littlefs/lfs.c **** static int lfs_ctz_extend(lfs_t *lfs,
2889:Core/Src/littlefs/lfs.c ****         lfs_cache_t *pcache, lfs_cache_t *rcache,
2890:Core/Src/littlefs/lfs.c ****         lfs_block_t head, lfs_size_t size,
2891:Core/Src/littlefs/lfs.c ****         lfs_block_t *block, lfs_off_t *off) {
2892:Core/Src/littlefs/lfs.c ****     while (true) {
2893:Core/Src/littlefs/lfs.c ****         // go ahead and grab a block
2894:Core/Src/littlefs/lfs.c ****         lfs_block_t nblock;
2895:Core/Src/littlefs/lfs.c ****         int err = lfs_alloc(lfs, &nblock);
2896:Core/Src/littlefs/lfs.c ****         if (err) {
2897:Core/Src/littlefs/lfs.c ****             return err;
2898:Core/Src/littlefs/lfs.c ****         }
2899:Core/Src/littlefs/lfs.c **** 
2900:Core/Src/littlefs/lfs.c ****         {
2901:Core/Src/littlefs/lfs.c ****             err = lfs_bd_erase(lfs, nblock);
2902:Core/Src/littlefs/lfs.c ****             if (err) {
2903:Core/Src/littlefs/lfs.c ****                 if (err == LFS_ERR_CORRUPT) {
2904:Core/Src/littlefs/lfs.c ****                     goto relocate;
2905:Core/Src/littlefs/lfs.c ****                 }
2906:Core/Src/littlefs/lfs.c ****                 return err;
2907:Core/Src/littlefs/lfs.c ****             }
2908:Core/Src/littlefs/lfs.c **** 
2909:Core/Src/littlefs/lfs.c ****             if (size == 0) {
2910:Core/Src/littlefs/lfs.c ****                 *block = nblock;
2911:Core/Src/littlefs/lfs.c ****                 *off = 0;
2912:Core/Src/littlefs/lfs.c ****                 return 0;
2913:Core/Src/littlefs/lfs.c ****             }
2914:Core/Src/littlefs/lfs.c **** 
2915:Core/Src/littlefs/lfs.c ****             lfs_size_t noff = size - 1;
2916:Core/Src/littlefs/lfs.c ****             lfs_off_t index = lfs_ctz_index(lfs, &noff);
2917:Core/Src/littlefs/lfs.c ****             noff = noff + 1;
2918:Core/Src/littlefs/lfs.c **** 
2919:Core/Src/littlefs/lfs.c ****             // just copy out the last block if it is incomplete
2920:Core/Src/littlefs/lfs.c ****             if (noff != lfs->cfg->block_size) {
2921:Core/Src/littlefs/lfs.c ****                 for (lfs_off_t i = 0; i < noff; i++) {
2922:Core/Src/littlefs/lfs.c ****                     uint8_t data;
2923:Core/Src/littlefs/lfs.c ****                     err = lfs_bd_read(lfs,
2924:Core/Src/littlefs/lfs.c ****                             NULL, rcache, noff-i,
2925:Core/Src/littlefs/lfs.c ****                             head, i, &data, 1);
2926:Core/Src/littlefs/lfs.c ****                     if (err) {
2927:Core/Src/littlefs/lfs.c ****                         return err;
2928:Core/Src/littlefs/lfs.c ****                     }
2929:Core/Src/littlefs/lfs.c **** 
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 71


2930:Core/Src/littlefs/lfs.c ****                     err = lfs_bd_prog(lfs,
2931:Core/Src/littlefs/lfs.c ****                             pcache, rcache, true,
2932:Core/Src/littlefs/lfs.c ****                             nblock, i, &data, 1);
2933:Core/Src/littlefs/lfs.c ****                     if (err) {
2934:Core/Src/littlefs/lfs.c ****                         if (err == LFS_ERR_CORRUPT) {
2935:Core/Src/littlefs/lfs.c ****                             goto relocate;
2936:Core/Src/littlefs/lfs.c ****                         }
2937:Core/Src/littlefs/lfs.c ****                         return err;
2938:Core/Src/littlefs/lfs.c ****                     }
2939:Core/Src/littlefs/lfs.c ****                 }
2940:Core/Src/littlefs/lfs.c **** 
2941:Core/Src/littlefs/lfs.c ****                 *block = nblock;
2942:Core/Src/littlefs/lfs.c ****                 *off = noff;
2943:Core/Src/littlefs/lfs.c ****                 return 0;
2944:Core/Src/littlefs/lfs.c ****             }
2945:Core/Src/littlefs/lfs.c **** 
2946:Core/Src/littlefs/lfs.c ****             // append block
2947:Core/Src/littlefs/lfs.c ****             index += 1;
2948:Core/Src/littlefs/lfs.c ****             lfs_size_t skips = lfs_ctz(index) + 1;
2949:Core/Src/littlefs/lfs.c ****             lfs_block_t nhead = head;
2950:Core/Src/littlefs/lfs.c ****             for (lfs_off_t i = 0; i < skips; i++) {
2951:Core/Src/littlefs/lfs.c ****                 nhead = lfs_tole32(nhead);
2952:Core/Src/littlefs/lfs.c ****                 err = lfs_bd_prog(lfs, pcache, rcache, true,
2953:Core/Src/littlefs/lfs.c ****                         nblock, 4*i, &nhead, 4);
2954:Core/Src/littlefs/lfs.c ****                 nhead = lfs_fromle32(nhead);
2955:Core/Src/littlefs/lfs.c ****                 if (err) {
2956:Core/Src/littlefs/lfs.c ****                     if (err == LFS_ERR_CORRUPT) {
2957:Core/Src/littlefs/lfs.c ****                         goto relocate;
2958:Core/Src/littlefs/lfs.c ****                     }
2959:Core/Src/littlefs/lfs.c ****                     return err;
2960:Core/Src/littlefs/lfs.c ****                 }
2961:Core/Src/littlefs/lfs.c **** 
2962:Core/Src/littlefs/lfs.c ****                 if (i != skips-1) {
2963:Core/Src/littlefs/lfs.c ****                     err = lfs_bd_read(lfs,
2964:Core/Src/littlefs/lfs.c ****                             NULL, rcache, sizeof(nhead),
2965:Core/Src/littlefs/lfs.c ****                             nhead, 4*i, &nhead, sizeof(nhead));
2966:Core/Src/littlefs/lfs.c ****                     nhead = lfs_fromle32(nhead);
2967:Core/Src/littlefs/lfs.c ****                     if (err) {
2968:Core/Src/littlefs/lfs.c ****                         return err;
2969:Core/Src/littlefs/lfs.c ****                     }
2970:Core/Src/littlefs/lfs.c ****                 }
2971:Core/Src/littlefs/lfs.c ****             }
2972:Core/Src/littlefs/lfs.c **** 
2973:Core/Src/littlefs/lfs.c ****             *block = nblock;
2974:Core/Src/littlefs/lfs.c ****             *off = 4*skips;
2975:Core/Src/littlefs/lfs.c ****             return 0;
2976:Core/Src/littlefs/lfs.c ****         }
2977:Core/Src/littlefs/lfs.c **** 
2978:Core/Src/littlefs/lfs.c **** relocate:
2979:Core/Src/littlefs/lfs.c ****         LFS_DEBUG("Bad block at 0x%"PRIx32, nblock);
2980:Core/Src/littlefs/lfs.c **** 
2981:Core/Src/littlefs/lfs.c ****         // just clear cache and try a new block
2982:Core/Src/littlefs/lfs.c ****         lfs_cache_drop(lfs, pcache);
2983:Core/Src/littlefs/lfs.c ****     }
2984:Core/Src/littlefs/lfs.c **** }
2985:Core/Src/littlefs/lfs.c **** #endif
2986:Core/Src/littlefs/lfs.c **** 
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 72


2987:Core/Src/littlefs/lfs.c **** static int lfs_ctz_traverse(lfs_t *lfs,
2988:Core/Src/littlefs/lfs.c ****         const lfs_cache_t *pcache, lfs_cache_t *rcache,
2989:Core/Src/littlefs/lfs.c ****         lfs_block_t head, lfs_size_t size,
2990:Core/Src/littlefs/lfs.c ****         int (*cb)(void*, lfs_block_t), void *data) {
2991:Core/Src/littlefs/lfs.c ****     if (size == 0) {
2992:Core/Src/littlefs/lfs.c ****         return 0;
2993:Core/Src/littlefs/lfs.c ****     }
2994:Core/Src/littlefs/lfs.c **** 
2995:Core/Src/littlefs/lfs.c ****     lfs_off_t index = lfs_ctz_index(lfs, &(lfs_off_t){size-1});
2996:Core/Src/littlefs/lfs.c **** 
2997:Core/Src/littlefs/lfs.c ****     while (true) {
2998:Core/Src/littlefs/lfs.c ****         int err = cb(data, head);
2999:Core/Src/littlefs/lfs.c ****         if (err) {
3000:Core/Src/littlefs/lfs.c ****             return err;
3001:Core/Src/littlefs/lfs.c ****         }
3002:Core/Src/littlefs/lfs.c **** 
3003:Core/Src/littlefs/lfs.c ****         if (index == 0) {
3004:Core/Src/littlefs/lfs.c ****             return 0;
3005:Core/Src/littlefs/lfs.c ****         }
3006:Core/Src/littlefs/lfs.c **** 
3007:Core/Src/littlefs/lfs.c ****         lfs_block_t heads[2];
3008:Core/Src/littlefs/lfs.c ****         int count = 2 - (index & 1);
3009:Core/Src/littlefs/lfs.c ****         err = lfs_bd_read(lfs,
3010:Core/Src/littlefs/lfs.c ****                 pcache, rcache, count*sizeof(head),
3011:Core/Src/littlefs/lfs.c ****                 head, 0, &heads, count*sizeof(head));
3012:Core/Src/littlefs/lfs.c ****         heads[0] = lfs_fromle32(heads[0]);
3013:Core/Src/littlefs/lfs.c ****         heads[1] = lfs_fromle32(heads[1]);
3014:Core/Src/littlefs/lfs.c ****         if (err) {
3015:Core/Src/littlefs/lfs.c ****             return err;
3016:Core/Src/littlefs/lfs.c ****         }
3017:Core/Src/littlefs/lfs.c **** 
3018:Core/Src/littlefs/lfs.c ****         for (int i = 0; i < count-1; i++) {
3019:Core/Src/littlefs/lfs.c ****             err = cb(data, heads[i]);
3020:Core/Src/littlefs/lfs.c ****             if (err) {
3021:Core/Src/littlefs/lfs.c ****                 return err;
3022:Core/Src/littlefs/lfs.c ****             }
3023:Core/Src/littlefs/lfs.c ****         }
3024:Core/Src/littlefs/lfs.c **** 
3025:Core/Src/littlefs/lfs.c ****         head = heads[count-1];
3026:Core/Src/littlefs/lfs.c ****         index -= count;
3027:Core/Src/littlefs/lfs.c ****     }
3028:Core/Src/littlefs/lfs.c **** }
3029:Core/Src/littlefs/lfs.c **** 
3030:Core/Src/littlefs/lfs.c **** 
3031:Core/Src/littlefs/lfs.c **** /// Top level file operations ///
3032:Core/Src/littlefs/lfs.c **** static int lfs_file_opencfg_(lfs_t *lfs, lfs_file_t *file,
3033:Core/Src/littlefs/lfs.c ****         const char *path, int flags,
3034:Core/Src/littlefs/lfs.c ****         const struct lfs_file_config *cfg) {
3035:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
3036:Core/Src/littlefs/lfs.c ****     // deorphan if we haven't yet, needed at most once after poweron
3037:Core/Src/littlefs/lfs.c ****     if ((flags & LFS_O_WRONLY) == LFS_O_WRONLY) {
3038:Core/Src/littlefs/lfs.c ****         int err = lfs_fs_forceconsistency(lfs);
3039:Core/Src/littlefs/lfs.c ****         if (err) {
3040:Core/Src/littlefs/lfs.c ****             return err;
3041:Core/Src/littlefs/lfs.c ****         }
3042:Core/Src/littlefs/lfs.c ****     }
3043:Core/Src/littlefs/lfs.c **** #else
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 73


3044:Core/Src/littlefs/lfs.c ****     LFS_ASSERT((flags & LFS_O_RDONLY) == LFS_O_RDONLY);
3045:Core/Src/littlefs/lfs.c **** #endif
3046:Core/Src/littlefs/lfs.c **** 
3047:Core/Src/littlefs/lfs.c ****     // setup simple file details
3048:Core/Src/littlefs/lfs.c ****     int err;
3049:Core/Src/littlefs/lfs.c ****     file->cfg = cfg;
3050:Core/Src/littlefs/lfs.c ****     file->flags = flags;
3051:Core/Src/littlefs/lfs.c ****     file->pos = 0;
3052:Core/Src/littlefs/lfs.c ****     file->off = 0;
3053:Core/Src/littlefs/lfs.c ****     file->cache.buffer = NULL;
3054:Core/Src/littlefs/lfs.c **** 
3055:Core/Src/littlefs/lfs.c ****     // allocate entry for file if it doesn't exist
3056:Core/Src/littlefs/lfs.c ****     lfs_stag_t tag = lfs_dir_find(lfs, &file->m, &path, &file->id);
3057:Core/Src/littlefs/lfs.c ****     if (tag < 0 && !(tag == LFS_ERR_NOENT && file->id != 0x3ff)) {
3058:Core/Src/littlefs/lfs.c ****         err = tag;
3059:Core/Src/littlefs/lfs.c ****         goto cleanup;
3060:Core/Src/littlefs/lfs.c ****     }
3061:Core/Src/littlefs/lfs.c **** 
3062:Core/Src/littlefs/lfs.c ****     // get id, add to list of mdirs to catch update changes
3063:Core/Src/littlefs/lfs.c ****     file->type = LFS_TYPE_REG;
3064:Core/Src/littlefs/lfs.c ****     lfs_mlist_append(lfs, (struct lfs_mlist *)file);
3065:Core/Src/littlefs/lfs.c **** 
3066:Core/Src/littlefs/lfs.c **** #ifdef LFS_READONLY
3067:Core/Src/littlefs/lfs.c ****     if (tag == LFS_ERR_NOENT) {
3068:Core/Src/littlefs/lfs.c ****         err = LFS_ERR_NOENT;
3069:Core/Src/littlefs/lfs.c ****         goto cleanup;
3070:Core/Src/littlefs/lfs.c **** #else
3071:Core/Src/littlefs/lfs.c ****     if (tag == LFS_ERR_NOENT) {
3072:Core/Src/littlefs/lfs.c ****         if (!(flags & LFS_O_CREAT)) {
3073:Core/Src/littlefs/lfs.c ****             err = LFS_ERR_NOENT;
3074:Core/Src/littlefs/lfs.c ****             goto cleanup;
3075:Core/Src/littlefs/lfs.c ****         }
3076:Core/Src/littlefs/lfs.c **** 
3077:Core/Src/littlefs/lfs.c ****         // check that name fits
3078:Core/Src/littlefs/lfs.c ****         lfs_size_t nlen = strlen(path);
3079:Core/Src/littlefs/lfs.c ****         if (nlen > lfs->name_max) {
3080:Core/Src/littlefs/lfs.c ****             err = LFS_ERR_NAMETOOLONG;
3081:Core/Src/littlefs/lfs.c ****             goto cleanup;
3082:Core/Src/littlefs/lfs.c ****         }
3083:Core/Src/littlefs/lfs.c **** 
3084:Core/Src/littlefs/lfs.c ****         // get next slot and create entry to remember name
3085:Core/Src/littlefs/lfs.c ****         err = lfs_dir_commit(lfs, &file->m, LFS_MKATTRS(
3086:Core/Src/littlefs/lfs.c ****                 {LFS_MKTAG(LFS_TYPE_CREATE, file->id, 0), NULL},
3087:Core/Src/littlefs/lfs.c ****                 {LFS_MKTAG(LFS_TYPE_REG, file->id, nlen), path},
3088:Core/Src/littlefs/lfs.c ****                 {LFS_MKTAG(LFS_TYPE_INLINESTRUCT, file->id, 0), NULL}));
3089:Core/Src/littlefs/lfs.c **** 
3090:Core/Src/littlefs/lfs.c ****         // it may happen that the file name doesn't fit in the metadata blocks, e.g., a 256 byte fi
3091:Core/Src/littlefs/lfs.c ****         // not fit in a 128 byte block.
3092:Core/Src/littlefs/lfs.c ****         err = (err == LFS_ERR_NOSPC) ? LFS_ERR_NAMETOOLONG : err;
3093:Core/Src/littlefs/lfs.c ****         if (err) {
3094:Core/Src/littlefs/lfs.c ****             goto cleanup;
3095:Core/Src/littlefs/lfs.c ****         }
3096:Core/Src/littlefs/lfs.c **** 
3097:Core/Src/littlefs/lfs.c ****         tag = LFS_MKTAG(LFS_TYPE_INLINESTRUCT, 0, 0);
3098:Core/Src/littlefs/lfs.c ****     } else if (flags & LFS_O_EXCL) {
3099:Core/Src/littlefs/lfs.c ****         err = LFS_ERR_EXIST;
3100:Core/Src/littlefs/lfs.c ****         goto cleanup;
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 74


3101:Core/Src/littlefs/lfs.c **** #endif
3102:Core/Src/littlefs/lfs.c ****     } else if (lfs_tag_type3(tag) != LFS_TYPE_REG) {
3103:Core/Src/littlefs/lfs.c ****         err = LFS_ERR_ISDIR;
3104:Core/Src/littlefs/lfs.c ****         goto cleanup;
3105:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
3106:Core/Src/littlefs/lfs.c ****     } else if (flags & LFS_O_TRUNC) {
3107:Core/Src/littlefs/lfs.c ****         // truncate if requested
3108:Core/Src/littlefs/lfs.c ****         tag = LFS_MKTAG(LFS_TYPE_INLINESTRUCT, file->id, 0);
3109:Core/Src/littlefs/lfs.c ****         file->flags |= LFS_F_DIRTY;
3110:Core/Src/littlefs/lfs.c **** #endif
3111:Core/Src/littlefs/lfs.c ****     } else {
3112:Core/Src/littlefs/lfs.c ****         // try to load what's on disk, if it's inlined we'll fix it later
3113:Core/Src/littlefs/lfs.c ****         tag = lfs_dir_get(lfs, &file->m, LFS_MKTAG(0x700, 0x3ff, 0),
3114:Core/Src/littlefs/lfs.c ****                 LFS_MKTAG(LFS_TYPE_STRUCT, file->id, 8), &file->ctz);
3115:Core/Src/littlefs/lfs.c ****         if (tag < 0) {
3116:Core/Src/littlefs/lfs.c ****             err = tag;
3117:Core/Src/littlefs/lfs.c ****             goto cleanup;
3118:Core/Src/littlefs/lfs.c ****         }
3119:Core/Src/littlefs/lfs.c ****         lfs_ctz_fromle32(&file->ctz);
3120:Core/Src/littlefs/lfs.c ****     }
3121:Core/Src/littlefs/lfs.c **** 
3122:Core/Src/littlefs/lfs.c ****     // fetch attrs
3123:Core/Src/littlefs/lfs.c ****     for (unsigned i = 0; i < file->cfg->attr_count; i++) {
3124:Core/Src/littlefs/lfs.c ****         // if opened for read / read-write operations
3125:Core/Src/littlefs/lfs.c ****         if ((file->flags & LFS_O_RDONLY) == LFS_O_RDONLY) {
3126:Core/Src/littlefs/lfs.c ****             lfs_stag_t res = lfs_dir_get(lfs, &file->m,
3127:Core/Src/littlefs/lfs.c ****                     LFS_MKTAG(0x7ff, 0x3ff, 0),
3128:Core/Src/littlefs/lfs.c ****                     LFS_MKTAG(LFS_TYPE_USERATTR + file->cfg->attrs[i].type,
3129:Core/Src/littlefs/lfs.c ****                         file->id, file->cfg->attrs[i].size),
3130:Core/Src/littlefs/lfs.c ****                         file->cfg->attrs[i].buffer);
3131:Core/Src/littlefs/lfs.c ****             if (res < 0 && res != LFS_ERR_NOENT) {
3132:Core/Src/littlefs/lfs.c ****                 err = res;
3133:Core/Src/littlefs/lfs.c ****                 goto cleanup;
3134:Core/Src/littlefs/lfs.c ****             }
3135:Core/Src/littlefs/lfs.c ****         }
3136:Core/Src/littlefs/lfs.c **** 
3137:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
3138:Core/Src/littlefs/lfs.c ****         // if opened for write / read-write operations
3139:Core/Src/littlefs/lfs.c ****         if ((file->flags & LFS_O_WRONLY) == LFS_O_WRONLY) {
3140:Core/Src/littlefs/lfs.c ****             if (file->cfg->attrs[i].size > lfs->attr_max) {
3141:Core/Src/littlefs/lfs.c ****                 err = LFS_ERR_NOSPC;
3142:Core/Src/littlefs/lfs.c ****                 goto cleanup;
3143:Core/Src/littlefs/lfs.c ****             }
3144:Core/Src/littlefs/lfs.c **** 
3145:Core/Src/littlefs/lfs.c ****             file->flags |= LFS_F_DIRTY;
3146:Core/Src/littlefs/lfs.c ****         }
3147:Core/Src/littlefs/lfs.c **** #endif
3148:Core/Src/littlefs/lfs.c ****     }
3149:Core/Src/littlefs/lfs.c **** 
3150:Core/Src/littlefs/lfs.c ****     // allocate buffer if needed
3151:Core/Src/littlefs/lfs.c ****     if (file->cfg->buffer) {
3152:Core/Src/littlefs/lfs.c ****         file->cache.buffer = file->cfg->buffer;
3153:Core/Src/littlefs/lfs.c ****     } else {
3154:Core/Src/littlefs/lfs.c ****         file->cache.buffer = lfs_malloc(lfs->cfg->cache_size);
3155:Core/Src/littlefs/lfs.c ****         if (!file->cache.buffer) {
3156:Core/Src/littlefs/lfs.c ****             err = LFS_ERR_NOMEM;
3157:Core/Src/littlefs/lfs.c ****             goto cleanup;
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 75


3158:Core/Src/littlefs/lfs.c ****         }
3159:Core/Src/littlefs/lfs.c ****     }
3160:Core/Src/littlefs/lfs.c **** 
3161:Core/Src/littlefs/lfs.c ****     // zero to avoid information leak
3162:Core/Src/littlefs/lfs.c ****     lfs_cache_zero(lfs, &file->cache);
3163:Core/Src/littlefs/lfs.c **** 
3164:Core/Src/littlefs/lfs.c ****     if (lfs_tag_type3(tag) == LFS_TYPE_INLINESTRUCT) {
3165:Core/Src/littlefs/lfs.c ****         // load inline files
3166:Core/Src/littlefs/lfs.c ****         file->ctz.head = LFS_BLOCK_INLINE;
3167:Core/Src/littlefs/lfs.c ****         file->ctz.size = lfs_tag_size(tag);
3168:Core/Src/littlefs/lfs.c ****         file->flags |= LFS_F_INLINE;
3169:Core/Src/littlefs/lfs.c ****         file->cache.block = file->ctz.head;
3170:Core/Src/littlefs/lfs.c ****         file->cache.off = 0;
3171:Core/Src/littlefs/lfs.c ****         file->cache.size = lfs->cfg->cache_size;
3172:Core/Src/littlefs/lfs.c **** 
3173:Core/Src/littlefs/lfs.c ****         // don't always read (may be new/trunc file)
3174:Core/Src/littlefs/lfs.c ****         if (file->ctz.size > 0) {
3175:Core/Src/littlefs/lfs.c ****             lfs_stag_t res = lfs_dir_get(lfs, &file->m,
3176:Core/Src/littlefs/lfs.c ****                     LFS_MKTAG(0x700, 0x3ff, 0),
3177:Core/Src/littlefs/lfs.c ****                     LFS_MKTAG(LFS_TYPE_STRUCT, file->id,
3178:Core/Src/littlefs/lfs.c ****                         lfs_min(file->cache.size, 0x3fe)),
3179:Core/Src/littlefs/lfs.c ****                     file->cache.buffer);
3180:Core/Src/littlefs/lfs.c ****             if (res < 0) {
3181:Core/Src/littlefs/lfs.c ****                 err = res;
3182:Core/Src/littlefs/lfs.c ****                 goto cleanup;
3183:Core/Src/littlefs/lfs.c ****             }
3184:Core/Src/littlefs/lfs.c ****         }
3185:Core/Src/littlefs/lfs.c ****     }
3186:Core/Src/littlefs/lfs.c **** 
3187:Core/Src/littlefs/lfs.c ****     return 0;
3188:Core/Src/littlefs/lfs.c **** 
3189:Core/Src/littlefs/lfs.c **** cleanup:
3190:Core/Src/littlefs/lfs.c ****     // clean up lingering resources
3191:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
3192:Core/Src/littlefs/lfs.c ****     file->flags |= LFS_F_ERRED;
3193:Core/Src/littlefs/lfs.c **** #endif
3194:Core/Src/littlefs/lfs.c ****     lfs_file_close_(lfs, file);
3195:Core/Src/littlefs/lfs.c ****     return err;
3196:Core/Src/littlefs/lfs.c **** }
3197:Core/Src/littlefs/lfs.c **** 
3198:Core/Src/littlefs/lfs.c **** #ifndef LFS_NO_MALLOC
3199:Core/Src/littlefs/lfs.c **** static int lfs_file_open_(lfs_t *lfs, lfs_file_t *file,
3200:Core/Src/littlefs/lfs.c ****         const char *path, int flags) {
3201:Core/Src/littlefs/lfs.c ****     static const struct lfs_file_config defaults = {0};
3202:Core/Src/littlefs/lfs.c ****     int err = lfs_file_opencfg_(lfs, file, path, flags, &defaults);
3203:Core/Src/littlefs/lfs.c ****     return err;
3204:Core/Src/littlefs/lfs.c **** }
3205:Core/Src/littlefs/lfs.c **** #endif
3206:Core/Src/littlefs/lfs.c **** 
3207:Core/Src/littlefs/lfs.c **** static int lfs_file_close_(lfs_t *lfs, lfs_file_t *file) {
3208:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
3209:Core/Src/littlefs/lfs.c ****     int err = lfs_file_sync_(lfs, file);
3210:Core/Src/littlefs/lfs.c **** #else
3211:Core/Src/littlefs/lfs.c ****     int err = 0;
3212:Core/Src/littlefs/lfs.c **** #endif
3213:Core/Src/littlefs/lfs.c **** 
3214:Core/Src/littlefs/lfs.c ****     // remove from list of mdirs
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 76


3215:Core/Src/littlefs/lfs.c ****     lfs_mlist_remove(lfs, (struct lfs_mlist*)file);
