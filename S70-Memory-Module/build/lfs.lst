2239:Core/Src/littlefs/lfs.c ****     }
2240:Core/Src/littlefs/lfs.c **** 
2241:Core/Src/littlefs/lfs.c ****     if (dir->erased) {
2242:Core/Src/littlefs/lfs.c ****         // try to commit
2243:Core/Src/littlefs/lfs.c ****         struct lfs_commit commit = {
2244:Core/Src/littlefs/lfs.c ****             .block = dir->pair[0],
2245:Core/Src/littlefs/lfs.c ****             .off = dir->off,
2246:Core/Src/littlefs/lfs.c ****             .ptag = dir->etag,
2247:Core/Src/littlefs/lfs.c ****             .crc = 0xffffffff,
2248:Core/Src/littlefs/lfs.c **** 
