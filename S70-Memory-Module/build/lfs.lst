4571:Core/Src/littlefs/lfs.c **** /// Filesystem filesystem operations ///
4572:Core/Src/littlefs/lfs.c **** static int lfs_fs_stat_(lfs_t *lfs, struct lfs_fsinfo *fsinfo) {
4573:Core/Src/littlefs/lfs.c ****     // if the superblock is up-to-date, we must be on the most recent
4574:Core/Src/littlefs/lfs.c ****     // minor version of littlefs
4575:Core/Src/littlefs/lfs.c ****     if (!lfs_gstate_needssuperblock(&lfs->gstate)) {
4576:Core/Src/littlefs/lfs.c ****         fsinfo->disk_version = lfs_fs_disk_version(lfs);
4577:Core/Src/littlefs/lfs.c **** 
4578:Core/Src/littlefs/lfs.c ****     // otherwise we need to read the minor version on disk
4579:Core/Src/littlefs/lfs.c ****     } else {
4580:Core/Src/littlefs/lfs.c ****         // fetch the superblock
4581:Core/Src/littlefs/lfs.c ****         lfs_mdir_t dir;
4582:Core/Src/littlefs/lfs.c ****         int err = lfs_dir_fetch(lfs, &dir, lfs->root);
4583:Core/Src/littlefs/lfs.c ****         if (err) {
4584:Core/Src/littlefs/lfs.c ****             return err;
4585:Core/Src/littlefs/lfs.c ****         }
4586:Core/Src/littlefs/lfs.c **** 
4587:Core/Src/littlefs/lfs.c ****         lfs_superblock_t superblock;
4588:Core/Src/littlefs/lfs.c ****         lfs_stag_t tag = lfs_dir_get(lfs, &dir, LFS_MKTAG(0x7ff, 0x3ff, 0),
4589:Core/Src/littlefs/lfs.c ****                 LFS_MKTAG(LFS_TYPE_INLINESTRUCT, 0, sizeof(superblock)),
4590:Core/Src/littlefs/lfs.c ****                 &superblock);
4591:Core/Src/littlefs/lfs.c ****         if (tag < 0) {
4592:Core/Src/littlefs/lfs.c ****             return tag;
4593:Core/Src/littlefs/lfs.c ****         }
4594:Core/Src/littlefs/lfs.c ****         lfs_superblock_fromle32(&superblock);
4595:Core/Src/littlefs/lfs.c **** 
4596:Core/Src/littlefs/lfs.c ****         // read the on-disk version
4597:Core/Src/littlefs/lfs.c ****         fsinfo->disk_version = superblock.version;
4598:Core/Src/littlefs/lfs.c ****     }
4599:Core/Src/littlefs/lfs.c **** 
4600:Core/Src/littlefs/lfs.c ****     // filesystem geometry
4601:Core/Src/littlefs/lfs.c ****     fsinfo->block_size = lfs->cfg->block_size;
4602:Core/Src/littlefs/lfs.c ****     fsinfo->block_count = lfs->block_count;
4603:Core/Src/littlefs/lfs.c **** 
4604:Core/Src/littlefs/lfs.c ****     // other on-disk configuration, we cache all of these for internal use
4605:Core/Src/littlefs/lfs.c ****     fsinfo->name_max = lfs->name_max;
4606:Core/Src/littlefs/lfs.c ****     fsinfo->file_max = lfs->file_max;
4607:Core/Src/littlefs/lfs.c ****     fsinfo->attr_max = lfs->attr_max;
4608:Core/Src/littlefs/lfs.c **** 
4609:Core/Src/littlefs/lfs.c ****     return 0;
4610:Core/Src/littlefs/lfs.c **** }
