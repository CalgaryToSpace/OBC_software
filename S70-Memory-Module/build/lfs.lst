1576:Core/Src/littlefs/lfs.c **** static int lfs_dir_commitprog(lfs_t *lfs, struct lfs_commit *commit,
1577:Core/Src/littlefs/lfs.c ****         const void *buffer, lfs_size_t size) {
1578:Core/Src/littlefs/lfs.c ****     int err = lfs_bd_prog(lfs,
1579:Core/Src/littlefs/lfs.c ****             &lfs->pcache, &lfs->rcache, false,
1580:Core/Src/littlefs/lfs.c ****             commit->block, commit->off ,
1581:Core/Src/littlefs/lfs.c ****             (const uint8_t*)buffer, size);
1582:Core/Src/littlefs/lfs.c ****     if (err) {
1583:Core/Src/littlefs/lfs.c ****         return err;
1584:Core/Src/littlefs/lfs.c ****     }
1585:Core/Src/littlefs/lfs.c **** 
1586:Core/Src/littlefs/lfs.c ****     commit->crc = lfs_crc(commit->crc, buffer, size);
1587:Core/Src/littlefs/lfs.c ****     commit->off += size;
1588:Core/Src/littlefs/lfs.c ****     return 0;
1589:Core/Src/littlefs/lfs.c **** }
1590:Core/Src/littlefs/lfs.c **** #endif
1591:Core/Src/littlefs/lfs.c **** 
1592:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
1593:Core/Src/littlefs/lfs.c **** static int lfs_dir_commitattr(lfs_t *lfs, struct lfs_commit *commit,
1594:Core/Src/littlefs/lfs.c ****         lfs_tag_t tag, const void *buffer) {
1595:Core/Src/littlefs/lfs.c ****     // check if we fit
1596:Core/Src/littlefs/lfs.c ****     lfs_size_t dsize = lfs_tag_dsize(tag);
1597:Core/Src/littlefs/lfs.c ****     if (commit->off + dsize > commit->end) {
1598:Core/Src/littlefs/lfs.c ****         return LFS_ERR_NOSPC;
1599:Core/Src/littlefs/lfs.c ****     }
1600:Core/Src/littlefs/lfs.c **** 
1601:Core/Src/littlefs/lfs.c ****     // write out tag
1602:Core/Src/littlefs/lfs.c ****     lfs_tag_t ntag = lfs_tobe32((tag & 0x7fffffff) ^ commit->ptag);
1603:Core/Src/littlefs/lfs.c ****     int err = lfs_dir_commitprog(lfs, commit, &ntag, sizeof(ntag));
1604:Core/Src/littlefs/lfs.c ****     if (err) {
1605:Core/Src/littlefs/lfs.c ****         return err;
1606:Core/Src/littlefs/lfs.c ****     }
1607:Core/Src/littlefs/lfs.c **** 
1608:Core/Src/littlefs/lfs.c ****     if (!(tag & 0x80000000)) {
1609:Core/Src/littlefs/lfs.c ****         // from memory
1610:Core/Src/littlefs/lfs.c ****         err = lfs_dir_commitprog(lfs, commit, buffer, dsize-sizeof(tag));
1611:Core/Src/littlefs/lfs.c ****         if (err) {
1612:Core/Src/littlefs/lfs.c ****             return err;
1613:Core/Src/littlefs/lfs.c ****         }
1614:Core/Src/littlefs/lfs.c ****     } else {
1615:Core/Src/littlefs/lfs.c ****         // from disk
1616:Core/Src/littlefs/lfs.c ****         const struct lfs_diskoff *disk = buffer;
1617:Core/Src/littlefs/lfs.c ****         for (lfs_off_t i = 0; i < dsize-sizeof(tag); i++) {
1618:Core/Src/littlefs/lfs.c ****             // rely on caching to make this efficient
