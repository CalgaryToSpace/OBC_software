5054:Core/Src/littlefs/lfs.c **** 
5055:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
5056:Core/Src/littlefs/lfs.c **** static int lfs_fs_forceconsistency(lfs_t *lfs) {
5057:Core/Src/littlefs/lfs.c ****     int err = lfs_fs_desuperblock(lfs);
5058:Core/Src/littlefs/lfs.c ****     if (err) {
5059:Core/Src/littlefs/lfs.c ****         return err;
