  31:Core/Src/littlefs/lfs.c **** static inline void lfs_cache_drop(lfs_t *lfs, lfs_cache_t *rcache) {
  32:Core/Src/littlefs/lfs.c ****     // do not zero, cheaper if cache is readonly or only going to be
  33:Core/Src/littlefs/lfs.c ****     // written with identical data (during relocates)
  34:Core/Src/littlefs/lfs.c ****     (void)lfs;
  35:Core/Src/littlefs/lfs.c ****     rcache->block = LFS_BLOCK_NULL;
  36:Core/Src/littlefs/lfs.c **** }
  37:Core/Src/littlefs/lfs.c **** 
  38:Core/Src/littlefs/lfs.c **** static inline void lfs_cache_zero(lfs_t *lfs, lfs_cache_t *pcache) {
  39:Core/Src/littlefs/lfs.c ****     // zero to avoid information leak
  40:Core/Src/littlefs/lfs.c ****     memset(pcache->buffer, 0xff, lfs->cfg->cache_size);
  41:Core/Src/littlefs/lfs.c ****     pcache->block = LFS_BLOCK_NULL;
  42:Core/Src/littlefs/lfs.c **** }
  43:Core/Src/littlefs/lfs.c **** 
  44:Core/Src/littlefs/lfs.c **** static int lfs_bd_read(lfs_t *lfs,
  45:Core/Src/littlefs/lfs.c ****         const lfs_cache_t *pcache, lfs_cache_t *rcache, lfs_size_t hint,
  46:Core/Src/littlefs/lfs.c ****         lfs_block_t block, lfs_off_t off,
  47:Core/Src/littlefs/lfs.c ****         void *buffer, lfs_size_t size) {
  48:Core/Src/littlefs/lfs.c ****     uint8_t *data = buffer;
  49:Core/Src/littlefs/lfs.c ****     if (off+size > lfs->cfg->block_size
  50:Core/Src/littlefs/lfs.c ****             || (lfs->block_count && block >= lfs->block_count)) {
  51:Core/Src/littlefs/lfs.c ****         return LFS_ERR_CORRUPT;
  52:Core/Src/littlefs/lfs.c ****     }
  53:Core/Src/littlefs/lfs.c **** 
  54:Core/Src/littlefs/lfs.c ****     while (size > 0) {
  55:Core/Src/littlefs/lfs.c ****         lfs_size_t diff = size;
  56:Core/Src/littlefs/lfs.c **** 
  57:Core/Src/littlefs/lfs.c ****         if (pcache && block == pcache->block &&
  58:Core/Src/littlefs/lfs.c ****                 off < pcache->off + pcache->size) {
  59:Core/Src/littlefs/lfs.c ****             if (off >= pcache->off) {
  60:Core/Src/littlefs/lfs.c ****                 // is already in pcache?
  61:Core/Src/littlefs/lfs.c ****                 diff = lfs_min(diff, pcache->size - (off-pcache->off));
  62:Core/Src/littlefs/lfs.c ****                 memcpy(data, &pcache->buffer[off-pcache->off], diff);
  63:Core/Src/littlefs/lfs.c **** 
  64:Core/Src/littlefs/lfs.c ****                 data += diff;
  65:Core/Src/littlefs/lfs.c ****                 off += diff;
  66:Core/Src/littlefs/lfs.c ****                 size -= diff;
  67:Core/Src/littlefs/lfs.c ****                 continue;
  68:Core/Src/littlefs/lfs.c ****             }
  69:Core/Src/littlefs/lfs.c **** 
  70:Core/Src/littlefs/lfs.c ****             // pcache takes priority
  71:Core/Src/littlefs/lfs.c ****             diff = lfs_min(diff, pcache->off-off);
  72:Core/Src/littlefs/lfs.c ****         }
  73:Core/Src/littlefs/lfs.c **** 
  74:Core/Src/littlefs/lfs.c ****         if (block == rcache->block &&
  75:Core/Src/littlefs/lfs.c ****                 off < rcache->off + rcache->size) {
  76:Core/Src/littlefs/lfs.c ****             if (off >= rcache->off) {
  77:Core/Src/littlefs/lfs.c ****                 // is already in rcache?
  78:Core/Src/littlefs/lfs.c ****                 diff = lfs_min(diff, rcache->size - (off-rcache->off));
  79:Core/Src/littlefs/lfs.c ****                 memcpy(data, &rcache->buffer[off-rcache->off], diff);
  80:Core/Src/littlefs/lfs.c **** 
  81:Core/Src/littlefs/lfs.c ****                 data += diff;
  82:Core/Src/littlefs/lfs.c ****                 off += diff;
  83:Core/Src/littlefs/lfs.c ****                 size -= diff;
  84:Core/Src/littlefs/lfs.c ****                 continue;
  85:Core/Src/littlefs/lfs.c ****             }
  86:Core/Src/littlefs/lfs.c **** 
  87:Core/Src/littlefs/lfs.c ****             // rcache takes priority
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 3


  88:Core/Src/littlefs/lfs.c ****             diff = lfs_min(diff, rcache->off-off);
  89:Core/Src/littlefs/lfs.c ****         }
  90:Core/Src/littlefs/lfs.c **** 
  91:Core/Src/littlefs/lfs.c ****         if (size >= hint && off % lfs->cfg->read_size == 0 &&
  92:Core/Src/littlefs/lfs.c ****                 size >= lfs->cfg->read_size) {
  93:Core/Src/littlefs/lfs.c ****             // bypass cache?
  94:Core/Src/littlefs/lfs.c ****             diff = lfs_aligndown(diff, lfs->cfg->read_size);
  95:Core/Src/littlefs/lfs.c ****             int err = lfs->cfg->read(lfs->cfg, block, off, data, diff);
  96:Core/Src/littlefs/lfs.c ****             if (err) {
  97:Core/Src/littlefs/lfs.c ****                 return err;
  98:Core/Src/littlefs/lfs.c ****             }
  99:Core/Src/littlefs/lfs.c **** 
 100:Core/Src/littlefs/lfs.c ****             data += diff;
 101:Core/Src/littlefs/lfs.c ****             off += diff;
 102:Core/Src/littlefs/lfs.c ****             size -= diff;
 103:Core/Src/littlefs/lfs.c ****             continue;
 104:Core/Src/littlefs/lfs.c ****         }
 105:Core/Src/littlefs/lfs.c **** 
 106:Core/Src/littlefs/lfs.c ****         // load to cache, first condition can no longer fail
 107:Core/Src/littlefs/lfs.c ****         LFS_ASSERT(!lfs->block_count || block < lfs->block_count);
 108:Core/Src/littlefs/lfs.c ****         rcache->block = block;
 109:Core/Src/littlefs/lfs.c ****         rcache->off = lfs_aligndown(off, lfs->cfg->read_size);
 110:Core/Src/littlefs/lfs.c ****         rcache->size = lfs_min(
 111:Core/Src/littlefs/lfs.c ****                 lfs_min(
 112:Core/Src/littlefs/lfs.c ****                     lfs_alignup(off+hint, lfs->cfg->read_size),
 113:Core/Src/littlefs/lfs.c ****                     lfs->cfg->block_size)
 114:Core/Src/littlefs/lfs.c ****                 - rcache->off,
 115:Core/Src/littlefs/lfs.c ****                 lfs->cfg->cache_size);
 116:Core/Src/littlefs/lfs.c ****         int err = lfs->cfg->read(lfs->cfg, rcache->block,
 117:Core/Src/littlefs/lfs.c ****                 rcache->off, rcache->buffer, rcache->size);
 118:Core/Src/littlefs/lfs.c ****         LFS_ASSERT(err <= 0);
 119:Core/Src/littlefs/lfs.c ****         if (err) {
 120:Core/Src/littlefs/lfs.c ****             return err;
 121:Core/Src/littlefs/lfs.c ****         }
 122:Core/Src/littlefs/lfs.c ****     }
 123:Core/Src/littlefs/lfs.c **** 
 124:Core/Src/littlefs/lfs.c ****     return 0;
 125:Core/Src/littlefs/lfs.c **** }
 126:Core/Src/littlefs/lfs.c **** 
 127:Core/Src/littlefs/lfs.c **** static int lfs_bd_cmp(lfs_t *lfs,
 128:Core/Src/littlefs/lfs.c ****         const lfs_cache_t *pcache, lfs_cache_t *rcache, lfs_size_t hint,
 129:Core/Src/littlefs/lfs.c ****         lfs_block_t block, lfs_off_t off,
 130:Core/Src/littlefs/lfs.c ****         const void *buffer, lfs_size_t size) {
 131:Core/Src/littlefs/lfs.c ****     const uint8_t *data = buffer;
 132:Core/Src/littlefs/lfs.c ****     lfs_size_t diff = 0;
 133:Core/Src/littlefs/lfs.c **** 
 134:Core/Src/littlefs/lfs.c ****     for (lfs_off_t i = 0; i < size; i += diff) {
 135:Core/Src/littlefs/lfs.c ****         uint8_t dat[8];
 136:Core/Src/littlefs/lfs.c **** 
 137:Core/Src/littlefs/lfs.c ****         diff = lfs_min(size-i, sizeof(dat));
 138:Core/Src/littlefs/lfs.c ****         int err = lfs_bd_read(lfs,
 139:Core/Src/littlefs/lfs.c ****                 pcache, rcache, hint-i,
 140:Core/Src/littlefs/lfs.c ****                 block, off+i, &dat, diff);
 141:Core/Src/littlefs/lfs.c ****         if (err) {
 142:Core/Src/littlefs/lfs.c ****             return err;
 143:Core/Src/littlefs/lfs.c ****         }
 144:Core/Src/littlefs/lfs.c **** 
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 4


 145:Core/Src/littlefs/lfs.c ****         int res = memcmp(dat, data + i, diff);
 146:Core/Src/littlefs/lfs.c ****         if (res) {
 147:Core/Src/littlefs/lfs.c ****             return res < 0 ? LFS_CMP_LT : LFS_CMP_GT;
 148:Core/Src/littlefs/lfs.c ****         }
 149:Core/Src/littlefs/lfs.c ****     }
 150:Core/Src/littlefs/lfs.c **** 
 151:Core/Src/littlefs/lfs.c ****     return LFS_CMP_EQ;
 152:Core/Src/littlefs/lfs.c **** }
 153:Core/Src/littlefs/lfs.c **** 
 154:Core/Src/littlefs/lfs.c **** static int lfs_bd_crc(lfs_t *lfs,
 155:Core/Src/littlefs/lfs.c ****         const lfs_cache_t *pcache, lfs_cache_t *rcache, lfs_size_t hint,
 156:Core/Src/littlefs/lfs.c ****         lfs_block_t block, lfs_off_t off, lfs_size_t size, uint32_t *crc) {
 157:Core/Src/littlefs/lfs.c ****     lfs_size_t diff = 0;
 158:Core/Src/littlefs/lfs.c **** 
 159:Core/Src/littlefs/lfs.c ****     for (lfs_off_t i = 0; i < size; i += diff) {
 160:Core/Src/littlefs/lfs.c ****         uint8_t dat[8];
 161:Core/Src/littlefs/lfs.c ****         diff = lfs_min(size-i, sizeof(dat));
 162:Core/Src/littlefs/lfs.c ****         int err = lfs_bd_read(lfs,
 163:Core/Src/littlefs/lfs.c ****                 pcache, rcache, hint-i,
 164:Core/Src/littlefs/lfs.c ****                 block, off+i, &dat, diff);
 165:Core/Src/littlefs/lfs.c ****         if (err) {
 166:Core/Src/littlefs/lfs.c ****             return err;
 167:Core/Src/littlefs/lfs.c ****         }
 168:Core/Src/littlefs/lfs.c **** 
 169:Core/Src/littlefs/lfs.c ****         *crc = lfs_crc(*crc, &dat, diff);
 170:Core/Src/littlefs/lfs.c ****     }
 171:Core/Src/littlefs/lfs.c **** 
 172:Core/Src/littlefs/lfs.c ****     return 0;
 173:Core/Src/littlefs/lfs.c **** }
 174:Core/Src/littlefs/lfs.c **** 
 175:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
 176:Core/Src/littlefs/lfs.c **** static int lfs_bd_flush(lfs_t *lfs,
 177:Core/Src/littlefs/lfs.c ****         lfs_cache_t *pcache, lfs_cache_t *rcache, bool validate) {
 178:Core/Src/littlefs/lfs.c ****     if (pcache->block != LFS_BLOCK_NULL && pcache->block != LFS_BLOCK_INLINE) {
 179:Core/Src/littlefs/lfs.c ****         LFS_ASSERT(pcache->block < lfs->block_count);
 180:Core/Src/littlefs/lfs.c ****         lfs_size_t diff = lfs_alignup(pcache->size, lfs->cfg->prog_size);
 181:Core/Src/littlefs/lfs.c ****         int err = lfs->cfg->prog(lfs->cfg, pcache->block,
 182:Core/Src/littlefs/lfs.c ****                 pcache->off, pcache->buffer, diff);
 183:Core/Src/littlefs/lfs.c ****         LFS_ASSERT(err <= 0);
 184:Core/Src/littlefs/lfs.c ****         if (err) {
 185:Core/Src/littlefs/lfs.c ****             return err;
 186:Core/Src/littlefs/lfs.c ****         }
 187:Core/Src/littlefs/lfs.c **** 
 188:Core/Src/littlefs/lfs.c ****         if (validate) {
 189:Core/Src/littlefs/lfs.c ****             // check data on disk
 190:Core/Src/littlefs/lfs.c ****             lfs_cache_drop(lfs, rcache);
 191:Core/Src/littlefs/lfs.c ****             int res = lfs_bd_cmp(lfs,
 192:Core/Src/littlefs/lfs.c ****                     NULL, rcache, diff,
 193:Core/Src/littlefs/lfs.c ****                     pcache->block, pcache->off, pcache->buffer, diff);
 194:Core/Src/littlefs/lfs.c ****             if (res < 0) {
 195:Core/Src/littlefs/lfs.c ****                 return res;
 196:Core/Src/littlefs/lfs.c ****             }
 197:Core/Src/littlefs/lfs.c **** 
 198:Core/Src/littlefs/lfs.c ****             if (res != LFS_CMP_EQ) {
 199:Core/Src/littlefs/lfs.c ****                 return LFS_ERR_CORRUPT;
 200:Core/Src/littlefs/lfs.c ****             }
 201:Core/Src/littlefs/lfs.c ****         }
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 5


 202:Core/Src/littlefs/lfs.c **** 
 203:Core/Src/littlefs/lfs.c ****         lfs_cache_zero(lfs, pcache);
 204:Core/Src/littlefs/lfs.c ****     }
 205:Core/Src/littlefs/lfs.c **** 
 206:Core/Src/littlefs/lfs.c ****     return 0;
 207:Core/Src/littlefs/lfs.c **** }
 208:Core/Src/littlefs/lfs.c **** #endif
 209:Core/Src/littlefs/lfs.c **** 
 210:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
 211:Core/Src/littlefs/lfs.c **** static int lfs_bd_sync(lfs_t *lfs,
 212:Core/Src/littlefs/lfs.c ****         lfs_cache_t *pcache, lfs_cache_t *rcache, bool validate) {
 213:Core/Src/littlefs/lfs.c ****     lfs_cache_drop(lfs, rcache);
 214:Core/Src/littlefs/lfs.c **** 
 215:Core/Src/littlefs/lfs.c ****     int err = lfs_bd_flush(lfs, pcache, rcache, validate);
 216:Core/Src/littlefs/lfs.c ****     if (err) {
 217:Core/Src/littlefs/lfs.c ****         return err;
 218:Core/Src/littlefs/lfs.c ****     }
 219:Core/Src/littlefs/lfs.c **** 
 220:Core/Src/littlefs/lfs.c ****     err = lfs->cfg->sync(lfs->cfg);
 221:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(err <= 0);
 222:Core/Src/littlefs/lfs.c ****     return err;
 223:Core/Src/littlefs/lfs.c **** }
 224:Core/Src/littlefs/lfs.c **** #endif
 225:Core/Src/littlefs/lfs.c **** 
 226:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
 227:Core/Src/littlefs/lfs.c **** static int lfs_bd_prog(lfs_t *lfs,
 228:Core/Src/littlefs/lfs.c ****         lfs_cache_t *pcache, lfs_cache_t *rcache, bool validate,
 229:Core/Src/littlefs/lfs.c ****         lfs_block_t block, lfs_off_t off,
 230:Core/Src/littlefs/lfs.c ****         const void *buffer, lfs_size_t size) {
 231:Core/Src/littlefs/lfs.c ****     const uint8_t *data = buffer;
 232:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(block == LFS_BLOCK_INLINE || block < lfs->block_count);
 233:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(off + size <= lfs->cfg->block_size);
 234:Core/Src/littlefs/lfs.c **** 
 235:Core/Src/littlefs/lfs.c ****     while (size > 0) {
 236:Core/Src/littlefs/lfs.c ****         if (block == pcache->block &&
 237:Core/Src/littlefs/lfs.c ****                 off >= pcache->off &&
 238:Core/Src/littlefs/lfs.c ****                 off < pcache->off + lfs->cfg->cache_size) {
 239:Core/Src/littlefs/lfs.c ****             // already fits in pcache?
 240:Core/Src/littlefs/lfs.c ****             lfs_size_t diff = lfs_min(size,
 241:Core/Src/littlefs/lfs.c ****                     lfs->cfg->cache_size - (off-pcache->off));
 242:Core/Src/littlefs/lfs.c ****             memcpy(&pcache->buffer[off-pcache->off], data, diff);
 243:Core/Src/littlefs/lfs.c **** 
 244:Core/Src/littlefs/lfs.c ****             data += diff;
 245:Core/Src/littlefs/lfs.c ****             off += diff;
 246:Core/Src/littlefs/lfs.c ****             size -= diff;
 247:Core/Src/littlefs/lfs.c **** 
 248:Core/Src/littlefs/lfs.c ****             pcache->size = lfs_max(pcache->size, off - pcache->off);
 249:Core/Src/littlefs/lfs.c ****             if (pcache->size == lfs->cfg->cache_size) {
 250:Core/Src/littlefs/lfs.c ****                 // eagerly flush out pcache if we fill up
 251:Core/Src/littlefs/lfs.c ****                 int err = lfs_bd_flush(lfs, pcache, rcache, validate);
 252:Core/Src/littlefs/lfs.c ****                 if (err) {
 253:Core/Src/littlefs/lfs.c ****                     return err;
 254:Core/Src/littlefs/lfs.c ****                 }
 255:Core/Src/littlefs/lfs.c ****             }
 256:Core/Src/littlefs/lfs.c **** 
 257:Core/Src/littlefs/lfs.c ****             continue;
 258:Core/Src/littlefs/lfs.c ****         }
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 6


 259:Core/Src/littlefs/lfs.c **** 
 260:Core/Src/littlefs/lfs.c ****         // pcache must have been flushed, either by programming and
 261:Core/Src/littlefs/lfs.c ****         // entire block or manually flushing the pcache
 262:Core/Src/littlefs/lfs.c ****         LFS_ASSERT(pcache->block == LFS_BLOCK_NULL);
 263:Core/Src/littlefs/lfs.c **** 
 264:Core/Src/littlefs/lfs.c ****         // prepare pcache, first condition can no longer fail
 265:Core/Src/littlefs/lfs.c ****         pcache->block = block;
 266:Core/Src/littlefs/lfs.c ****         pcache->off = lfs_aligndown(off, lfs->cfg->prog_size);
 267:Core/Src/littlefs/lfs.c ****         pcache->size = 0;
 268:Core/Src/littlefs/lfs.c ****     }
 269:Core/Src/littlefs/lfs.c **** 
 270:Core/Src/littlefs/lfs.c ****     return 0;
 271:Core/Src/littlefs/lfs.c **** }
 272:Core/Src/littlefs/lfs.c **** #endif
 273:Core/Src/littlefs/lfs.c **** 
 274:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
 275:Core/Src/littlefs/lfs.c **** static int lfs_bd_erase(lfs_t *lfs, lfs_block_t block) {
 276:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(block < lfs->block_count);
 277:Core/Src/littlefs/lfs.c ****     int err = lfs->cfg->erase(lfs->cfg, block);
 278:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(err <= 0);
 279:Core/Src/littlefs/lfs.c ****     return err;
 280:Core/Src/littlefs/lfs.c **** }
 281:Core/Src/littlefs/lfs.c **** #endif
