3617:Core/Src/littlefs/lfs.c **** static lfs_ssize_t lfs_file_write_(lfs_t *lfs, lfs_file_t *file,
3618:Core/Src/littlefs/lfs.c ****         const void *buffer, lfs_size_t size) {
3619:Core/Src/littlefs/lfs.c ****     LFS_ASSERT((file->flags & LFS_O_WRONLY) == LFS_O_WRONLY);
3620:Core/Src/littlefs/lfs.c **** 
3621:Core/Src/littlefs/lfs.c ****     if (file->flags & LFS_F_READING) {
3622:Core/Src/littlefs/lfs.c ****         // drop any reads
3623:Core/Src/littlefs/lfs.c ****         int err = lfs_file_flush(lfs, file);
3624:Core/Src/littlefs/lfs.c ****         if (err) {
3625:Core/Src/littlefs/lfs.c ****             return err;
3626:Core/Src/littlefs/lfs.c ****         }
3627:Core/Src/littlefs/lfs.c ****     }
3628:Core/Src/littlefs/lfs.c **** 
3629:Core/Src/littlefs/lfs.c ****     if ((file->flags & LFS_O_APPEND) && file->pos < file->ctz.size) {
3630:Core/Src/littlefs/lfs.c ****         file->pos = file->ctz.size;
3631:Core/Src/littlefs/lfs.c ****     }
3632:Core/Src/littlefs/lfs.c **** 
3633:Core/Src/littlefs/lfs.c ****     if (file->pos + size > lfs->file_max) {
3634:Core/Src/littlefs/lfs.c ****         // Larger than file limit?
3635:Core/Src/littlefs/lfs.c ****         return LFS_ERR_FBIG;
3636:Core/Src/littlefs/lfs.c ****     }
3637:Core/Src/littlefs/lfs.c **** 
3638:Core/Src/littlefs/lfs.c ****     if (!(file->flags & LFS_F_WRITING) && file->pos > file->ctz.size) {
3639:Core/Src/littlefs/lfs.c ****         // fill with zeros
3640:Core/Src/littlefs/lfs.c ****         lfs_off_t pos = file->pos;
3641:Core/Src/littlefs/lfs.c ****         file->pos = file->ctz.size;
3642:Core/Src/littlefs/lfs.c **** 
3643:Core/Src/littlefs/lfs.c ****         while (file->pos < pos) {
3644:Core/Src/littlefs/lfs.c ****             lfs_ssize_t res = lfs_file_flushedwrite(lfs, file, &(uint8_t){0}, 1);
3645:Core/Src/littlefs/lfs.c ****             if (res < 0) {
3646:Core/Src/littlefs/lfs.c ****                 return res;
3647:Core/Src/littlefs/lfs.c ****             }
3648:Core/Src/littlefs/lfs.c ****         }
3649:Core/Src/littlefs/lfs.c ****     }
3650:Core/Src/littlefs/lfs.c **** 
3651:Core/Src/littlefs/lfs.c ****     lfs_ssize_t nsize = lfs_file_flushedwrite(lfs, file, buffer, size);
3652:Core/Src/littlefs/lfs.c ****     if (nsize < 0) {
3653:Core/Src/littlefs/lfs.c ****         return nsize;
3654:Core/Src/littlefs/lfs.c ****     }
3655:Core/Src/littlefs/lfs.c **** 
3656:Core/Src/littlefs/lfs.c ****     file->flags &= ~LFS_F_ERRED;
3657:Core/Src/littlefs/lfs.c ****     return nsize;
3658:Core/Src/littlefs/lfs.c **** }
3659:Core/Src/littlefs/lfs.c **** #endif
