 143:Core/Inc/./LittleFS/lfs_util.h **** static inline uint32_t lfs_ctz(uint32_t a) {
 144:Core/Inc/./LittleFS/lfs_util.h **** #if !defined(LFS_NO_INTRINSICS) && defined(__GNUC__)
