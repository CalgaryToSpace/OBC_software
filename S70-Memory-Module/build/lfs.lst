4612:Core/Src/littlefs/lfs.c **** int lfs_fs_traverse_(lfs_t *lfs,
4613:Core/Src/littlefs/lfs.c ****         int (*cb)(void *data, lfs_block_t block), void *data,
4614:Core/Src/littlefs/lfs.c ****         bool includeorphans) {
4615:Core/Src/littlefs/lfs.c ****     // iterate over metadata pairs
