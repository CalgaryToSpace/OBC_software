3226:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
3227:Core/Src/littlefs/lfs.c **** static int lfs_file_relocate(lfs_t *lfs, lfs_file_t *file) {
3228:Core/Src/littlefs/lfs.c ****     while (true) {
3229:Core/Src/littlefs/lfs.c ****         // just relocate what exists into new block
3230:Core/Src/littlefs/lfs.c ****         lfs_block_t nblock;
3231:Core/Src/littlefs/lfs.c ****         int err = lfs_alloc(lfs, &nblock);
3232:Core/Src/littlefs/lfs.c ****         if (err) {
3233:Core/Src/littlefs/lfs.c ****             return err;
3234:Core/Src/littlefs/lfs.c ****         }
3235:Core/Src/littlefs/lfs.c **** 
3236:Core/Src/littlefs/lfs.c ****         err = lfs_bd_erase(lfs, nblock);
3237:Core/Src/littlefs/lfs.c ****         if (err) {
3238:Core/Src/littlefs/lfs.c ****             if (err == LFS_ERR_CORRUPT) {
3239:Core/Src/littlefs/lfs.c ****                 goto relocate;
3240:Core/Src/littlefs/lfs.c ****             }
3241:Core/Src/littlefs/lfs.c ****             return err;
3242:Core/Src/littlefs/lfs.c ****         }
3243:Core/Src/littlefs/lfs.c **** 
3244:Core/Src/littlefs/lfs.c ****         // either read from dirty cache or disk
3245:Core/Src/littlefs/lfs.c ****         for (lfs_off_t i = 0; i < file->off; i++) {
3246:Core/Src/littlefs/lfs.c ****             uint8_t data;
3247:Core/Src/littlefs/lfs.c ****             if (file->flags & LFS_F_INLINE) {
3248:Core/Src/littlefs/lfs.c ****                 err = lfs_dir_getread(lfs, &file->m,
3249:Core/Src/littlefs/lfs.c ****                         // note we evict inline files before they can be dirty
3250:Core/Src/littlefs/lfs.c ****                         NULL, &file->cache, file->off-i,
3251:Core/Src/littlefs/lfs.c ****                         LFS_MKTAG(0xfff, 0x1ff, 0),
3252:Core/Src/littlefs/lfs.c ****                         LFS_MKTAG(LFS_TYPE_INLINESTRUCT, file->id, 0),
3253:Core/Src/littlefs/lfs.c ****                         i, &data, 1);
3254:Core/Src/littlefs/lfs.c ****                 if (err) {
3255:Core/Src/littlefs/lfs.c ****                     return err;
3256:Core/Src/littlefs/lfs.c ****                 }
3257:Core/Src/littlefs/lfs.c ****             } else {
3258:Core/Src/littlefs/lfs.c ****                 err = lfs_bd_read(lfs,
3259:Core/Src/littlefs/lfs.c ****                         &file->cache, &lfs->rcache, file->off-i,
3260:Core/Src/littlefs/lfs.c ****                         file->block, i, &data, 1);
3261:Core/Src/littlefs/lfs.c ****                 if (err) {
3262:Core/Src/littlefs/lfs.c ****                     return err;
3263:Core/Src/littlefs/lfs.c ****                 }
3264:Core/Src/littlefs/lfs.c ****             }
3265:Core/Src/littlefs/lfs.c **** 
3266:Core/Src/littlefs/lfs.c ****             err = lfs_bd_prog(lfs,
3267:Core/Src/littlefs/lfs.c ****                     &lfs->pcache, &lfs->rcache, true,
3268:Core/Src/littlefs/lfs.c ****                     nblock, i, &data, 1);
3269:Core/Src/littlefs/lfs.c ****             if (err) {
3270:Core/Src/littlefs/lfs.c ****                 if (err == LFS_ERR_CORRUPT) {
3271:Core/Src/littlefs/lfs.c ****                     goto relocate;
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 77


3272:Core/Src/littlefs/lfs.c ****                 }
3273:Core/Src/littlefs/lfs.c ****                 return err;
3274:Core/Src/littlefs/lfs.c ****             }
3275:Core/Src/littlefs/lfs.c ****         }
3276:Core/Src/littlefs/lfs.c **** 
3277:Core/Src/littlefs/lfs.c ****         // copy over new state of file
3278:Core/Src/littlefs/lfs.c ****         memcpy(file->cache.buffer, lfs->pcache.buffer, lfs->cfg->cache_size);
3279:Core/Src/littlefs/lfs.c ****         file->cache.block = lfs->pcache.block;
3280:Core/Src/littlefs/lfs.c ****         file->cache.off = lfs->pcache.off;
3281:Core/Src/littlefs/lfs.c ****         file->cache.size = lfs->pcache.size;
3282:Core/Src/littlefs/lfs.c ****         lfs_cache_zero(lfs, &lfs->pcache);
3283:Core/Src/littlefs/lfs.c **** 
3284:Core/Src/littlefs/lfs.c ****         file->block = nblock;
3285:Core/Src/littlefs/lfs.c ****         file->flags |= LFS_F_WRITING;
3286:Core/Src/littlefs/lfs.c ****         return 0;
3287:Core/Src/littlefs/lfs.c **** 
3288:Core/Src/littlefs/lfs.c **** relocate:
3289:Core/Src/littlefs/lfs.c ****         LFS_DEBUG("Bad block at 0x%"PRIx32, nblock);
3290:Core/Src/littlefs/lfs.c **** 
3291:Core/Src/littlefs/lfs.c ****         // just clear cache and try a new block
3292:Core/Src/littlefs/lfs.c ****         lfs_cache_drop(lfs, &lfs->pcache);
3293:Core/Src/littlefs/lfs.c ****     }
3294:Core/Src/littlefs/lfs.c **** }
3295:Core/Src/littlefs/lfs.c **** #endif
3296:Core/Src/littlefs/lfs.c **** 
3297:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
3298:Core/Src/littlefs/lfs.c **** static int lfs_file_outline(lfs_t *lfs, lfs_file_t *file) {
3299:Core/Src/littlefs/lfs.c ****     file->off = file->pos;
3300:Core/Src/littlefs/lfs.c ****     lfs_alloc_ckpoint(lfs);
3301:Core/Src/littlefs/lfs.c ****     int err = lfs_file_relocate(lfs, file);
3302:Core/Src/littlefs/lfs.c ****     if (err) {
3303:Core/Src/littlefs/lfs.c ****         return err;
3304:Core/Src/littlefs/lfs.c ****     }
3305:Core/Src/littlefs/lfs.c **** 
3306:Core/Src/littlefs/lfs.c ****     file->flags &= ~LFS_F_INLINE;
3307:Core/Src/littlefs/lfs.c ****     return 0;
3308:Core/Src/littlefs/lfs.c **** }
3309:Core/Src/littlefs/lfs.c **** #endif
3310:Core/Src/littlefs/lfs.c **** 
3311:Core/Src/littlefs/lfs.c **** static int lfs_file_flush(lfs_t *lfs, lfs_file_t *file) {
3312:Core/Src/littlefs/lfs.c ****     if (file->flags & LFS_F_READING) {
3313:Core/Src/littlefs/lfs.c ****         if (!(file->flags & LFS_F_INLINE)) {
3314:Core/Src/littlefs/lfs.c ****             lfs_cache_drop(lfs, &file->cache);
3315:Core/Src/littlefs/lfs.c ****         }
3316:Core/Src/littlefs/lfs.c ****         file->flags &= ~LFS_F_READING;
3317:Core/Src/littlefs/lfs.c ****     }
3318:Core/Src/littlefs/lfs.c **** 
3319:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
3320:Core/Src/littlefs/lfs.c ****     if (file->flags & LFS_F_WRITING) {
3321:Core/Src/littlefs/lfs.c ****         lfs_off_t pos = file->pos;
3322:Core/Src/littlefs/lfs.c **** 
3323:Core/Src/littlefs/lfs.c ****         if (!(file->flags & LFS_F_INLINE)) {
3324:Core/Src/littlefs/lfs.c ****             // copy over anything after current branch
3325:Core/Src/littlefs/lfs.c ****             lfs_file_t orig = {
3326:Core/Src/littlefs/lfs.c ****                 .ctz.head = file->ctz.head,
3327:Core/Src/littlefs/lfs.c ****                 .ctz.size = file->ctz.size,
3328:Core/Src/littlefs/lfs.c ****                 .flags = LFS_O_RDONLY,
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 78


3329:Core/Src/littlefs/lfs.c ****                 .pos = file->pos,
3330:Core/Src/littlefs/lfs.c ****                 .cache = lfs->rcache,
3331:Core/Src/littlefs/lfs.c ****             };
3332:Core/Src/littlefs/lfs.c ****             lfs_cache_drop(lfs, &lfs->rcache);
3333:Core/Src/littlefs/lfs.c **** 
3334:Core/Src/littlefs/lfs.c ****             while (file->pos < file->ctz.size) {
3335:Core/Src/littlefs/lfs.c ****                 // copy over a byte at a time, leave it up to caching
3336:Core/Src/littlefs/lfs.c ****                 // to make this efficient
3337:Core/Src/littlefs/lfs.c ****                 uint8_t data;
3338:Core/Src/littlefs/lfs.c ****                 lfs_ssize_t res = lfs_file_flushedread(lfs, &orig, &data, 1);
3339:Core/Src/littlefs/lfs.c ****                 if (res < 0) {
3340:Core/Src/littlefs/lfs.c ****                     return res;
3341:Core/Src/littlefs/lfs.c ****                 }
3342:Core/Src/littlefs/lfs.c **** 
3343:Core/Src/littlefs/lfs.c ****                 res = lfs_file_flushedwrite(lfs, file, &data, 1);
3344:Core/Src/littlefs/lfs.c ****                 if (res < 0) {
3345:Core/Src/littlefs/lfs.c ****                     return res;
3346:Core/Src/littlefs/lfs.c ****                 }
3347:Core/Src/littlefs/lfs.c **** 
3348:Core/Src/littlefs/lfs.c ****                 // keep our reference to the rcache in sync
3349:Core/Src/littlefs/lfs.c ****                 if (lfs->rcache.block != LFS_BLOCK_NULL) {
3350:Core/Src/littlefs/lfs.c ****                     lfs_cache_drop(lfs, &orig.cache);
3351:Core/Src/littlefs/lfs.c ****                     lfs_cache_drop(lfs, &lfs->rcache);
3352:Core/Src/littlefs/lfs.c ****                 }
3353:Core/Src/littlefs/lfs.c ****             }
3354:Core/Src/littlefs/lfs.c **** 
3355:Core/Src/littlefs/lfs.c ****             // write out what we have
3356:Core/Src/littlefs/lfs.c ****             while (true) {
3357:Core/Src/littlefs/lfs.c ****                 int err = lfs_bd_flush(lfs, &file->cache, &lfs->rcache, true);
3358:Core/Src/littlefs/lfs.c ****                 if (err) {
3359:Core/Src/littlefs/lfs.c ****                     if (err == LFS_ERR_CORRUPT) {
3360:Core/Src/littlefs/lfs.c ****                         goto relocate;
3361:Core/Src/littlefs/lfs.c ****                     }
3362:Core/Src/littlefs/lfs.c ****                     return err;
3363:Core/Src/littlefs/lfs.c ****                 }
3364:Core/Src/littlefs/lfs.c **** 
3365:Core/Src/littlefs/lfs.c ****                 break;
3366:Core/Src/littlefs/lfs.c **** 
3367:Core/Src/littlefs/lfs.c **** relocate:
3368:Core/Src/littlefs/lfs.c ****                 LFS_DEBUG("Bad block at 0x%"PRIx32, file->block);
3369:Core/Src/littlefs/lfs.c ****                 err = lfs_file_relocate(lfs, file);
3370:Core/Src/littlefs/lfs.c ****                 if (err) {
3371:Core/Src/littlefs/lfs.c ****                     return err;
3372:Core/Src/littlefs/lfs.c ****                 }
3373:Core/Src/littlefs/lfs.c ****             }
3374:Core/Src/littlefs/lfs.c ****         } else {
3375:Core/Src/littlefs/lfs.c ****             file->pos = lfs_max(file->pos, file->ctz.size);
3376:Core/Src/littlefs/lfs.c ****         }
3377:Core/Src/littlefs/lfs.c **** 
3378:Core/Src/littlefs/lfs.c ****         // actual file updates
3379:Core/Src/littlefs/lfs.c ****         file->ctz.head = file->block;
3380:Core/Src/littlefs/lfs.c ****         file->ctz.size = file->pos;
3381:Core/Src/littlefs/lfs.c ****         file->flags &= ~LFS_F_WRITING;
3382:Core/Src/littlefs/lfs.c ****         file->flags |= LFS_F_DIRTY;
3383:Core/Src/littlefs/lfs.c **** 
3384:Core/Src/littlefs/lfs.c ****         file->pos = pos;
3385:Core/Src/littlefs/lfs.c ****     }
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 79


3386:Core/Src/littlefs/lfs.c **** #endif
3387:Core/Src/littlefs/lfs.c **** 
3388:Core/Src/littlefs/lfs.c ****     return 0;
3389:Core/Src/littlefs/lfs.c **** }
3390:Core/Src/littlefs/lfs.c **** 
3391:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
3392:Core/Src/littlefs/lfs.c **** static int lfs_file_sync_(lfs_t *lfs, lfs_file_t *file) {
3393:Core/Src/littlefs/lfs.c ****     if (file->flags & LFS_F_ERRED) {
3394:Core/Src/littlefs/lfs.c ****         // it's not safe to do anything if our file errored
3395:Core/Src/littlefs/lfs.c ****         return 0;
3396:Core/Src/littlefs/lfs.c ****     }
3397:Core/Src/littlefs/lfs.c **** 
3398:Core/Src/littlefs/lfs.c ****     int err = lfs_file_flush(lfs, file);
3399:Core/Src/littlefs/lfs.c ****     if (err) {
3400:Core/Src/littlefs/lfs.c ****         file->flags |= LFS_F_ERRED;
3401:Core/Src/littlefs/lfs.c ****         return err;
3402:Core/Src/littlefs/lfs.c ****     }
3403:Core/Src/littlefs/lfs.c **** 
3404:Core/Src/littlefs/lfs.c **** 
3405:Core/Src/littlefs/lfs.c ****     if ((file->flags & LFS_F_DIRTY) &&
3406:Core/Src/littlefs/lfs.c ****             !lfs_pair_isnull(file->m.pair)) {
3407:Core/Src/littlefs/lfs.c ****         // before we commit metadata, we need sync the disk to make sure
3408:Core/Src/littlefs/lfs.c ****         // data writes don't complete after metadata writes
3409:Core/Src/littlefs/lfs.c ****         if (!(file->flags & LFS_F_INLINE)) {
3410:Core/Src/littlefs/lfs.c ****             err = lfs_bd_sync(lfs, &lfs->pcache, &lfs->rcache, false);
3411:Core/Src/littlefs/lfs.c ****             if (err) {
3412:Core/Src/littlefs/lfs.c ****                 return err;
3413:Core/Src/littlefs/lfs.c ****             }
3414:Core/Src/littlefs/lfs.c ****         }
3415:Core/Src/littlefs/lfs.c **** 
3416:Core/Src/littlefs/lfs.c ****         // update dir entry
3417:Core/Src/littlefs/lfs.c ****         uint16_t type;
3418:Core/Src/littlefs/lfs.c ****         const void *buffer;
3419:Core/Src/littlefs/lfs.c ****         lfs_size_t size;
3420:Core/Src/littlefs/lfs.c ****         struct lfs_ctz ctz;
3421:Core/Src/littlefs/lfs.c ****         if (file->flags & LFS_F_INLINE) {
3422:Core/Src/littlefs/lfs.c ****             // inline the whole file
3423:Core/Src/littlefs/lfs.c ****             type = LFS_TYPE_INLINESTRUCT;
3424:Core/Src/littlefs/lfs.c ****             buffer = file->cache.buffer;
3425:Core/Src/littlefs/lfs.c ****             size = file->ctz.size;
3426:Core/Src/littlefs/lfs.c ****         } else {
3427:Core/Src/littlefs/lfs.c ****             // update the ctz reference
3428:Core/Src/littlefs/lfs.c ****             type = LFS_TYPE_CTZSTRUCT;
3429:Core/Src/littlefs/lfs.c ****             // copy ctz so alloc will work during a relocate
3430:Core/Src/littlefs/lfs.c ****             ctz = file->ctz;
3431:Core/Src/littlefs/lfs.c ****             lfs_ctz_tole32(&ctz);
3432:Core/Src/littlefs/lfs.c ****             buffer = &ctz;
3433:Core/Src/littlefs/lfs.c ****             size = sizeof(ctz);
3434:Core/Src/littlefs/lfs.c ****         }
3435:Core/Src/littlefs/lfs.c **** 
3436:Core/Src/littlefs/lfs.c ****         // commit file data and attributes
3437:Core/Src/littlefs/lfs.c ****         err = lfs_dir_commit(lfs, &file->m, LFS_MKATTRS(
3438:Core/Src/littlefs/lfs.c ****                 {LFS_MKTAG(type, file->id, size), buffer},
3439:Core/Src/littlefs/lfs.c ****                 {LFS_MKTAG(LFS_FROM_USERATTRS, file->id,
3440:Core/Src/littlefs/lfs.c ****                     file->cfg->attr_count), file->cfg->attrs}));
3441:Core/Src/littlefs/lfs.c ****         if (err) {
3442:Core/Src/littlefs/lfs.c ****             file->flags |= LFS_F_ERRED;
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 80


3443:Core/Src/littlefs/lfs.c ****             return err;
3444:Core/Src/littlefs/lfs.c ****         }
3445:Core/Src/littlefs/lfs.c **** 
3446:Core/Src/littlefs/lfs.c ****         file->flags &= ~LFS_F_DIRTY;
3447:Core/Src/littlefs/lfs.c ****     }
3448:Core/Src/littlefs/lfs.c **** 
3449:Core/Src/littlefs/lfs.c ****     return 0;
3450:Core/Src/littlefs/lfs.c **** }
3451:Core/Src/littlefs/lfs.c **** #endif
3452:Core/Src/littlefs/lfs.c **** 
3453:Core/Src/littlefs/lfs.c **** static lfs_ssize_t lfs_file_flushedread(lfs_t *lfs, lfs_file_t *file,
3454:Core/Src/littlefs/lfs.c ****         void *buffer, lfs_size_t size) {
3455:Core/Src/littlefs/lfs.c ****     uint8_t *data = buffer;
3456:Core/Src/littlefs/lfs.c ****     lfs_size_t nsize = size;
3457:Core/Src/littlefs/lfs.c **** 
3458:Core/Src/littlefs/lfs.c ****     if (file->pos >= file->ctz.size) {
3459:Core/Src/littlefs/lfs.c ****         // eof if past end
3460:Core/Src/littlefs/lfs.c ****         return 0;
3461:Core/Src/littlefs/lfs.c ****     }
3462:Core/Src/littlefs/lfs.c **** 
3463:Core/Src/littlefs/lfs.c ****     size = lfs_min(size, file->ctz.size - file->pos);
3464:Core/Src/littlefs/lfs.c ****     nsize = size;
3465:Core/Src/littlefs/lfs.c **** 
3466:Core/Src/littlefs/lfs.c ****     while (nsize > 0) {
3467:Core/Src/littlefs/lfs.c ****         // check if we need a new block
3468:Core/Src/littlefs/lfs.c ****         if (!(file->flags & LFS_F_READING) ||
3469:Core/Src/littlefs/lfs.c ****                 file->off == lfs->cfg->block_size) {
3470:Core/Src/littlefs/lfs.c ****             if (!(file->flags & LFS_F_INLINE)) {
3471:Core/Src/littlefs/lfs.c ****                 int err = lfs_ctz_find(lfs, NULL, &file->cache,
3472:Core/Src/littlefs/lfs.c ****                         file->ctz.head, file->ctz.size,
3473:Core/Src/littlefs/lfs.c ****                         file->pos, &file->block, &file->off);
3474:Core/Src/littlefs/lfs.c ****                 if (err) {
3475:Core/Src/littlefs/lfs.c ****                     return err;
3476:Core/Src/littlefs/lfs.c ****                 }
3477:Core/Src/littlefs/lfs.c ****             } else {
3478:Core/Src/littlefs/lfs.c ****                 file->block = LFS_BLOCK_INLINE;
3479:Core/Src/littlefs/lfs.c ****                 file->off = file->pos;
3480:Core/Src/littlefs/lfs.c ****             }
3481:Core/Src/littlefs/lfs.c **** 
3482:Core/Src/littlefs/lfs.c ****             file->flags |= LFS_F_READING;
3483:Core/Src/littlefs/lfs.c ****         }
3484:Core/Src/littlefs/lfs.c **** 
3485:Core/Src/littlefs/lfs.c ****         // read as much as we can in current block
3486:Core/Src/littlefs/lfs.c ****         lfs_size_t diff = lfs_min(nsize, lfs->cfg->block_size - file->off);
3487:Core/Src/littlefs/lfs.c ****         if (file->flags & LFS_F_INLINE) {
3488:Core/Src/littlefs/lfs.c ****             int err = lfs_dir_getread(lfs, &file->m,
3489:Core/Src/littlefs/lfs.c ****                     NULL, &file->cache, lfs->cfg->block_size,
3490:Core/Src/littlefs/lfs.c ****                     LFS_MKTAG(0xfff, 0x1ff, 0),
3491:Core/Src/littlefs/lfs.c ****                     LFS_MKTAG(LFS_TYPE_INLINESTRUCT, file->id, 0),
3492:Core/Src/littlefs/lfs.c ****                     file->off, data, diff);
3493:Core/Src/littlefs/lfs.c ****             if (err) {
3494:Core/Src/littlefs/lfs.c ****                 return err;
3495:Core/Src/littlefs/lfs.c ****             }
3496:Core/Src/littlefs/lfs.c ****         } else {
3497:Core/Src/littlefs/lfs.c ****             int err = lfs_bd_read(lfs,
3498:Core/Src/littlefs/lfs.c ****                     NULL, &file->cache, lfs->cfg->block_size,
3499:Core/Src/littlefs/lfs.c ****                     file->block, file->off, data, diff);
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 81


3500:Core/Src/littlefs/lfs.c ****             if (err) {
3501:Core/Src/littlefs/lfs.c ****                 return err;
3502:Core/Src/littlefs/lfs.c ****             }
3503:Core/Src/littlefs/lfs.c ****         }
3504:Core/Src/littlefs/lfs.c **** 
3505:Core/Src/littlefs/lfs.c ****         file->pos += diff;
3506:Core/Src/littlefs/lfs.c ****         file->off += diff;
3507:Core/Src/littlefs/lfs.c ****         data += diff;
3508:Core/Src/littlefs/lfs.c ****         nsize -= diff;
3509:Core/Src/littlefs/lfs.c ****     }
3510:Core/Src/littlefs/lfs.c **** 
3511:Core/Src/littlefs/lfs.c ****     return size;
3512:Core/Src/littlefs/lfs.c **** }
3513:Core/Src/littlefs/lfs.c **** 
3514:Core/Src/littlefs/lfs.c **** static lfs_ssize_t lfs_file_read_(lfs_t *lfs, lfs_file_t *file,
3515:Core/Src/littlefs/lfs.c ****         void *buffer, lfs_size_t size) {
3516:Core/Src/littlefs/lfs.c ****     LFS_ASSERT((file->flags & LFS_O_RDONLY) == LFS_O_RDONLY);
3517:Core/Src/littlefs/lfs.c **** 
3518:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
3519:Core/Src/littlefs/lfs.c ****     if (file->flags & LFS_F_WRITING) {
3520:Core/Src/littlefs/lfs.c ****         // flush out any writes
