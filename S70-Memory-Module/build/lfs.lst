5644:Core/Src/littlefs/lfs.c **** 
5645:Core/Src/littlefs/lfs.c ****     {
5646:Core/Src/littlefs/lfs.c ****         // iterate through each directory, copying over entries
5647:Core/Src/littlefs/lfs.c ****         // into new directory
5648:Core/Src/littlefs/lfs.c ****         lfs1_dir_t dir1;
5649:Core/Src/littlefs/lfs.c ****         lfs_mdir_t dir2;
5650:Core/Src/littlefs/lfs.c ****         dir1.d.tail[0] = lfs->lfs1->root[0];
5651:Core/Src/littlefs/lfs.c ****         dir1.d.tail[1] = lfs->lfs1->root[1];
5652:Core/Src/littlefs/lfs.c ****         while (!lfs_pair_isnull(dir1.d.tail)) {
5653:Core/Src/littlefs/lfs.c ****             // iterate old dir
5654:Core/Src/littlefs/lfs.c ****             err = lfs1_dir_fetch(lfs, &dir1, dir1.d.tail);
5655:Core/Src/littlefs/lfs.c ****             if (err) {
5656:Core/Src/littlefs/lfs.c ****                 goto cleanup;
5657:Core/Src/littlefs/lfs.c ****             }
5658:Core/Src/littlefs/lfs.c **** 
5659:Core/Src/littlefs/lfs.c ****             // create new dir and bind as temporary pretend root
5660:Core/Src/littlefs/lfs.c ****             err = lfs_dir_alloc(lfs, &dir2);
5661:Core/Src/littlefs/lfs.c ****             if (err) {
5662:Core/Src/littlefs/lfs.c ****                 goto cleanup;
5663:Core/Src/littlefs/lfs.c ****             }
5664:Core/Src/littlefs/lfs.c **** 
5665:Core/Src/littlefs/lfs.c ****             dir2.rev = dir1.d.rev;
5666:Core/Src/littlefs/lfs.c ****             dir1.head[0] = dir1.pair[0];
5667:Core/Src/littlefs/lfs.c ****             dir1.head[1] = dir1.pair[1];
5668:Core/Src/littlefs/lfs.c ****             lfs->root[0] = dir2.pair[0];
5669:Core/Src/littlefs/lfs.c ****             lfs->root[1] = dir2.pair[1];
5670:Core/Src/littlefs/lfs.c **** 
5671:Core/Src/littlefs/lfs.c ****             err = lfs_dir_commit(lfs, &dir2, NULL, 0);
5672:Core/Src/littlefs/lfs.c ****             if (err) {
5673:Core/Src/littlefs/lfs.c ****                 goto cleanup;
5674:Core/Src/littlefs/lfs.c ****             }
5675:Core/Src/littlefs/lfs.c **** 
5676:Core/Src/littlefs/lfs.c ****             while (true) {
5677:Core/Src/littlefs/lfs.c ****                 lfs1_entry_t entry1;
5678:Core/Src/littlefs/lfs.c ****                 err = lfs1_dir_next(lfs, &dir1, &entry1);
5679:Core/Src/littlefs/lfs.c ****                 if (err && err != LFS_ERR_NOENT) {
5680:Core/Src/littlefs/lfs.c ****                     goto cleanup;
5681:Core/Src/littlefs/lfs.c ****                 }
5682:Core/Src/littlefs/lfs.c **** 
5683:Core/Src/littlefs/lfs.c ****                 if (err == LFS_ERR_NOENT) {
5684:Core/Src/littlefs/lfs.c ****                     break;
5685:Core/Src/littlefs/lfs.c ****                 }
5686:Core/Src/littlefs/lfs.c **** 
5687:Core/Src/littlefs/lfs.c ****                 // check that entry has not been moved
5688:Core/Src/littlefs/lfs.c ****                 if (entry1.d.type & 0x80) {
5689:Core/Src/littlefs/lfs.c ****                     int moved = lfs1_moved(lfs, &entry1.d.u);
5690:Core/Src/littlefs/lfs.c ****                     if (moved < 0) {
