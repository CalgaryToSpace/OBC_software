3218:Core/Src/littlefs/lfs.c ****     if (!file->cfg->buffer) {
3219:Core/Src/littlefs/lfs.c ****         lfs_free(file->cache.buffer);
3220:Core/Src/littlefs/lfs.c ****     }
3221:Core/Src/littlefs/lfs.c **** 
