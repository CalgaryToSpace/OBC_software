4545:Core/Src/littlefs/lfs.c ****     if (!lfs_gstate_iszero(&lfs->gstate)) {
4546:Core/Src/littlefs/lfs.c ****         LFS_DEBUG("Found pending gstate 0x%08"PRIx32"%08"PRIx32"%08"PRIx32,
4547:Core/Src/littlefs/lfs.c ****                 lfs->gstate.tag,
4548:Core/Src/littlefs/lfs.c ****                 lfs->gstate.pair[0],
