5159:Core/Src/littlefs/lfs.c ****         }
5160:Core/Src/littlefs/lfs.c ****     }
5161:Core/Src/littlefs/lfs.c **** 
5162:Core/Src/littlefs/lfs.c ****     // try to populate the lookahead buffer, unless it's already full
5163:Core/Src/littlefs/lfs.c ****     if (lfs->lookahead.size < 8*lfs->cfg->lookahead_size) {
