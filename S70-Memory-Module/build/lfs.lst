5455:Core/Src/littlefs/lfs.c **** /// littlefs v1 specific operations ///
5456:Core/Src/littlefs/lfs.c **** int lfs1_traverse(lfs_t *lfs, int (*cb)(void*, lfs_block_t), void *data) {
5457:Core/Src/littlefs/lfs.c ****     if (lfs_pair_isnull(lfs->lfs1->root)) {
5458:Core/Src/littlefs/lfs.c ****         return 0;
5459:Core/Src/littlefs/lfs.c ****     }
5460:Core/Src/littlefs/lfs.c **** 
5461:Core/Src/littlefs/lfs.c ****     // iterate over metadata pairs
5462:Core/Src/littlefs/lfs.c ****     lfs1_dir_t dir;
5463:Core/Src/littlefs/lfs.c ****     lfs1_entry_t entry;
5464:Core/Src/littlefs/lfs.c ****     lfs_block_t cwd[2] = {0, 1};
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 588


5465:Core/Src/littlefs/lfs.c **** 
5466:Core/Src/littlefs/lfs.c ****     while (true) {
5467:Core/Src/littlefs/lfs.c ****         for (int i = 0; i < 2; i++) {
5468:Core/Src/littlefs/lfs.c ****             int err = cb(data, cwd[i]);
5469:Core/Src/littlefs/lfs.c ****             if (err) {
5470:Core/Src/littlefs/lfs.c ****                 return err;
5471:Core/Src/littlefs/lfs.c ****             }
5472:Core/Src/littlefs/lfs.c ****         }
5473:Core/Src/littlefs/lfs.c **** 
5474:Core/Src/littlefs/lfs.c ****         int err = lfs1_dir_fetch(lfs, &dir, cwd);
5475:Core/Src/littlefs/lfs.c ****         if (err) {
5476:Core/Src/littlefs/lfs.c ****             return err;
5477:Core/Src/littlefs/lfs.c ****         }
5478:Core/Src/littlefs/lfs.c **** 
5479:Core/Src/littlefs/lfs.c ****         // iterate over contents
5480:Core/Src/littlefs/lfs.c ****         while (dir.off + sizeof(entry.d) <= (0x7fffffff & dir.d.size)-4) {
5481:Core/Src/littlefs/lfs.c ****             err = lfs1_bd_read(lfs, dir.pair[0], dir.off,
5482:Core/Src/littlefs/lfs.c ****                     &entry.d, sizeof(entry.d));
5483:Core/Src/littlefs/lfs.c ****             lfs1_entry_fromle32(&entry.d);
5484:Core/Src/littlefs/lfs.c ****             if (err) {
5485:Core/Src/littlefs/lfs.c ****                 return err;
5486:Core/Src/littlefs/lfs.c ****             }
5487:Core/Src/littlefs/lfs.c **** 
5488:Core/Src/littlefs/lfs.c ****             dir.off += lfs1_entry_size(&entry);
5489:Core/Src/littlefs/lfs.c ****             if ((0x70 & entry.d.type) == (0x70 & LFS1_TYPE_REG)) {
5490:Core/Src/littlefs/lfs.c ****                 err = lfs_ctz_traverse(lfs, NULL, &lfs->rcache,
5491:Core/Src/littlefs/lfs.c ****                         entry.d.u.file.head, entry.d.u.file.size, cb, data);
5492:Core/Src/littlefs/lfs.c ****                 if (err) {
5493:Core/Src/littlefs/lfs.c ****                     return err;
5494:Core/Src/littlefs/lfs.c ****                 }
5495:Core/Src/littlefs/lfs.c ****             }
5496:Core/Src/littlefs/lfs.c ****         }
5497:Core/Src/littlefs/lfs.c **** 
5498:Core/Src/littlefs/lfs.c ****         // we also need to check if we contain a threaded v2 directory
5499:Core/Src/littlefs/lfs.c ****         lfs_mdir_t dir2 = {.split=true, .tail={cwd[0], cwd[1]}};
5500:Core/Src/littlefs/lfs.c ****         while (dir2.split) {
5501:Core/Src/littlefs/lfs.c ****             err = lfs_dir_fetch(lfs, &dir2, dir2.tail);
5502:Core/Src/littlefs/lfs.c ****             if (err) {
5503:Core/Src/littlefs/lfs.c ****                 break;
5504:Core/Src/littlefs/lfs.c ****             }
5505:Core/Src/littlefs/lfs.c **** 
5506:Core/Src/littlefs/lfs.c ****             for (int i = 0; i < 2; i++) {
5507:Core/Src/littlefs/lfs.c ****                 err = cb(data, dir2.pair[i]);
5508:Core/Src/littlefs/lfs.c ****                 if (err) {
5509:Core/Src/littlefs/lfs.c ****                     return err;
5510:Core/Src/littlefs/lfs.c ****                 }
5511:Core/Src/littlefs/lfs.c ****             }
5512:Core/Src/littlefs/lfs.c ****         }
5513:Core/Src/littlefs/lfs.c **** 
5514:Core/Src/littlefs/lfs.c ****         cwd[0] = dir.d.tail[0];
5515:Core/Src/littlefs/lfs.c ****         cwd[1] = dir.d.tail[1];
5516:Core/Src/littlefs/lfs.c **** 
5517:Core/Src/littlefs/lfs.c ****         if (lfs_pair_isnull(cwd)) {
5518:Core/Src/littlefs/lfs.c ****             break;
5519:Core/Src/littlefs/lfs.c ****         }
5520:Core/Src/littlefs/lfs.c ****     }
5521:Core/Src/littlefs/lfs.c **** 
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 589


5522:Core/Src/littlefs/lfs.c ****     return 0;
5523:Core/Src/littlefs/lfs.c **** }
5524:Core/Src/littlefs/lfs.c **** 
5525:Core/Src/littlefs/lfs.c **** static int lfs1_moved(lfs_t *lfs, const void *e) {
5526:Core/Src/littlefs/lfs.c ****     if (lfs_pair_isnull(lfs->lfs1->root)) {
5527:Core/Src/littlefs/lfs.c ****         return 0;
5528:Core/Src/littlefs/lfs.c ****     }
5529:Core/Src/littlefs/lfs.c **** 
5530:Core/Src/littlefs/lfs.c ****     // skip superblock
5531:Core/Src/littlefs/lfs.c ****     lfs1_dir_t cwd;
5532:Core/Src/littlefs/lfs.c ****     int err = lfs1_dir_fetch(lfs, &cwd, (const lfs_block_t[2]){0, 1});
5533:Core/Src/littlefs/lfs.c ****     if (err) {
5534:Core/Src/littlefs/lfs.c ****         return err;
5535:Core/Src/littlefs/lfs.c ****     }
5536:Core/Src/littlefs/lfs.c **** 
5537:Core/Src/littlefs/lfs.c ****     // iterate over all directory directory entries
5538:Core/Src/littlefs/lfs.c ****     lfs1_entry_t entry;
5539:Core/Src/littlefs/lfs.c ****     while (!lfs_pair_isnull(cwd.d.tail)) {
5540:Core/Src/littlefs/lfs.c ****         err = lfs1_dir_fetch(lfs, &cwd, cwd.d.tail);
5541:Core/Src/littlefs/lfs.c ****         if (err) {
5542:Core/Src/littlefs/lfs.c ****             return err;
5543:Core/Src/littlefs/lfs.c ****         }
5544:Core/Src/littlefs/lfs.c **** 
5545:Core/Src/littlefs/lfs.c ****         while (true) {
5546:Core/Src/littlefs/lfs.c ****             err = lfs1_dir_next(lfs, &cwd, &entry);
5547:Core/Src/littlefs/lfs.c ****             if (err && err != LFS_ERR_NOENT) {
5548:Core/Src/littlefs/lfs.c ****                 return err;
5549:Core/Src/littlefs/lfs.c ****             }
5550:Core/Src/littlefs/lfs.c **** 
5551:Core/Src/littlefs/lfs.c ****             if (err == LFS_ERR_NOENT) {
5552:Core/Src/littlefs/lfs.c ****                 break;
5553:Core/Src/littlefs/lfs.c ****             }
5554:Core/Src/littlefs/lfs.c **** 
5555:Core/Src/littlefs/lfs.c ****             if (!(0x80 & entry.d.type) &&
5556:Core/Src/littlefs/lfs.c ****                  memcmp(&entry.d.u, e, sizeof(entry.d.u)) == 0) {
5557:Core/Src/littlefs/lfs.c ****                 return true;
5558:Core/Src/littlefs/lfs.c ****             }
5559:Core/Src/littlefs/lfs.c ****         }
5560:Core/Src/littlefs/lfs.c ****     }
5561:Core/Src/littlefs/lfs.c **** 
5562:Core/Src/littlefs/lfs.c ****     return false;
5563:Core/Src/littlefs/lfs.c **** }
