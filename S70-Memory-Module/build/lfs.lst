2255:Core/Src/littlefs/lfs.c ****         lfs_pair_tole32(dir->tail);
2256:Core/Src/littlefs/lfs.c ****         int err = lfs_dir_traverse(lfs,
2257:Core/Src/littlefs/lfs.c ****                 dir, dir->off, dir->etag, attrs, attrcount,
2258:Core/Src/littlefs/lfs.c ****                 0, 0, 0, 0, 0,
2259:Core/Src/littlefs/lfs.c ****                 lfs_dir_commit_commit, &(struct lfs_dir_commit_commit){
2260:Core/Src/littlefs/lfs.c ****                     lfs, &commit});
