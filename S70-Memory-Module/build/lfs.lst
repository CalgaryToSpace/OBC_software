4152:Core/Src/littlefs/lfs.c **** // common filesystem initialization
4153:Core/Src/littlefs/lfs.c **** static int lfs_init(lfs_t *lfs, const struct lfs_config *cfg) {
4154:Core/Src/littlefs/lfs.c ****     lfs->cfg = cfg;
4155:Core/Src/littlefs/lfs.c ****     lfs->block_count = cfg->block_count;  // May be 0
4156:Core/Src/littlefs/lfs.c ****     int err = 0;
4157:Core/Src/littlefs/lfs.c **** 
4158:Core/Src/littlefs/lfs.c **** #ifdef LFS_MULTIVERSION
4159:Core/Src/littlefs/lfs.c ****     // this driver only supports minor version < current minor version
4160:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(!lfs->cfg->disk_version || (
4161:Core/Src/littlefs/lfs.c ****             (0xffff & (lfs->cfg->disk_version >> 16))
4162:Core/Src/littlefs/lfs.c ****                     == LFS_DISK_VERSION_MAJOR
4163:Core/Src/littlefs/lfs.c ****                 && (0xffff & (lfs->cfg->disk_version >> 0))
4164:Core/Src/littlefs/lfs.c ****                     <= LFS_DISK_VERSION_MINOR));
4165:Core/Src/littlefs/lfs.c **** #endif
4166:Core/Src/littlefs/lfs.c **** 
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 96


4167:Core/Src/littlefs/lfs.c ****     // check that bool is a truthy-preserving type
4168:Core/Src/littlefs/lfs.c ****     //
4169:Core/Src/littlefs/lfs.c ****     // note the most common reason for this failure is a before-c99 compiler,
4170:Core/Src/littlefs/lfs.c ****     // which littlefs currently does not support
4171:Core/Src/littlefs/lfs.c ****     LFS_ASSERT((bool)0x80000000);
4172:Core/Src/littlefs/lfs.c **** 
4173:Core/Src/littlefs/lfs.c ****     // validate that the lfs-cfg sizes were initiated properly before
4174:Core/Src/littlefs/lfs.c ****     // performing any arithmetic logics with them
4175:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(lfs->cfg->read_size != 0);
4176:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(lfs->cfg->prog_size != 0);
4177:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(lfs->cfg->cache_size != 0);
4178:Core/Src/littlefs/lfs.c **** 
4179:Core/Src/littlefs/lfs.c ****     // check that block size is a multiple of cache size is a multiple
4180:Core/Src/littlefs/lfs.c ****     // of prog and read sizes
4181:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(lfs->cfg->cache_size % lfs->cfg->read_size == 0);
4182:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(lfs->cfg->cache_size % lfs->cfg->prog_size == 0);
4183:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(lfs->cfg->block_size % lfs->cfg->cache_size == 0);
4184:Core/Src/littlefs/lfs.c **** 
4185:Core/Src/littlefs/lfs.c ****     // check that the block size is large enough to fit all ctz pointers
4186:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(lfs->cfg->block_size >= 128);
4187:Core/Src/littlefs/lfs.c ****     // this is the exact calculation for all ctz pointers, if this fails
4188:Core/Src/littlefs/lfs.c ****     // and the simpler assert above does not, math must be broken
4189:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(4*lfs_npw2(0xffffffff / (lfs->cfg->block_size-2*4))
4190:Core/Src/littlefs/lfs.c ****             <= lfs->cfg->block_size);
4191:Core/Src/littlefs/lfs.c **** 
4192:Core/Src/littlefs/lfs.c ****     // block_cycles = 0 is no longer supported.
4193:Core/Src/littlefs/lfs.c ****     //
4194:Core/Src/littlefs/lfs.c ****     // block_cycles is the number of erase cycles before littlefs evicts
4195:Core/Src/littlefs/lfs.c ****     // metadata logs as a part of wear leveling. Suggested values are in the
4196:Core/Src/littlefs/lfs.c ****     // range of 100-1000, or set block_cycles to -1 to disable block-level
4197:Core/Src/littlefs/lfs.c ****     // wear-leveling.
4198:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(lfs->cfg->block_cycles != 0);
4199:Core/Src/littlefs/lfs.c **** 
4200:Core/Src/littlefs/lfs.c ****     // check that compact_thresh makes sense
4201:Core/Src/littlefs/lfs.c ****     //
4202:Core/Src/littlefs/lfs.c ****     // metadata can't be compacted below block_size/2, and metadata can't
4203:Core/Src/littlefs/lfs.c ****     // exceed a block_size
4204:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(lfs->cfg->compact_thresh == 0
4205:Core/Src/littlefs/lfs.c ****             || lfs->cfg->compact_thresh >= lfs->cfg->block_size/2);
4206:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(lfs->cfg->compact_thresh == (lfs_size_t)-1
4207:Core/Src/littlefs/lfs.c ****             || lfs->cfg->compact_thresh <= lfs->cfg->block_size);
4208:Core/Src/littlefs/lfs.c **** 
4209:Core/Src/littlefs/lfs.c ****     // setup read cache
4210:Core/Src/littlefs/lfs.c ****     if (lfs->cfg->read_buffer) {
4211:Core/Src/littlefs/lfs.c ****         lfs->rcache.buffer = lfs->cfg->read_buffer;
4212:Core/Src/littlefs/lfs.c ****     } else {
4213:Core/Src/littlefs/lfs.c ****         lfs->rcache.buffer = lfs_malloc(lfs->cfg->cache_size);
4214:Core/Src/littlefs/lfs.c ****         if (!lfs->rcache.buffer) {
4215:Core/Src/littlefs/lfs.c ****             err = LFS_ERR_NOMEM;
4216:Core/Src/littlefs/lfs.c ****             goto cleanup;
4217:Core/Src/littlefs/lfs.c ****         }
4218:Core/Src/littlefs/lfs.c ****     }
4219:Core/Src/littlefs/lfs.c **** 
4220:Core/Src/littlefs/lfs.c ****     // setup program cache
4221:Core/Src/littlefs/lfs.c ****     if (lfs->cfg->prog_buffer) {
