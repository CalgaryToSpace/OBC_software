2292:Core/Src/littlefs/lfs.c **** 
2293:Core/Src/littlefs/lfs.c ****         // finalize commit with the crc
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 59


