1794:Core/Src/littlefs/lfs.c ****     }
1795:Core/Src/littlefs/lfs.c **** 
1796:Core/Src/littlefs/lfs.c ****     // zero for reproducibility in case initial block is unreadable
1797:Core/Src/littlefs/lfs.c ****     dir->rev = 0;
1798:Core/Src/littlefs/lfs.c **** 
