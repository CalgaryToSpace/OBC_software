2590:Core/Src/littlefs/lfs.c **** /// Top level directory operations ///
2591:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
2592:Core/Src/littlefs/lfs.c **** static int lfs_mkdir_(lfs_t *lfs, const char *path) {
2593:Core/Src/littlefs/lfs.c ****     // deorphan if we haven't yet, needed at most once after poweron
2594:Core/Src/littlefs/lfs.c ****     int err = lfs_fs_forceconsistency(lfs);
2595:Core/Src/littlefs/lfs.c ****     if (err) {
2596:Core/Src/littlefs/lfs.c ****         return err;
2597:Core/Src/littlefs/lfs.c ****     }
2598:Core/Src/littlefs/lfs.c **** 
2599:Core/Src/littlefs/lfs.c ****     struct lfs_mlist cwd;
2600:Core/Src/littlefs/lfs.c ****     cwd.next = lfs->mlist;
2601:Core/Src/littlefs/lfs.c ****     uint16_t id;
2602:Core/Src/littlefs/lfs.c ****     err = lfs_dir_find(lfs, &cwd.m, &path, &id);
2603:Core/Src/littlefs/lfs.c ****     if (!(err == LFS_ERR_NOENT && id != 0x3ff)) {
2604:Core/Src/littlefs/lfs.c ****         return (err < 0) ? err : LFS_ERR_EXIST;
2605:Core/Src/littlefs/lfs.c ****     }
2606:Core/Src/littlefs/lfs.c **** 
2607:Core/Src/littlefs/lfs.c ****     // check that name fits
2608:Core/Src/littlefs/lfs.c ****     lfs_size_t nlen = strlen(path);
2609:Core/Src/littlefs/lfs.c ****     if (nlen > lfs->name_max) {
2610:Core/Src/littlefs/lfs.c ****         return LFS_ERR_NAMETOOLONG;
2611:Core/Src/littlefs/lfs.c ****     }
2612:Core/Src/littlefs/lfs.c **** 
2613:Core/Src/littlefs/lfs.c ****     // build up new directory
2614:Core/Src/littlefs/lfs.c ****     lfs_alloc_ckpoint(lfs);
2615:Core/Src/littlefs/lfs.c ****     lfs_mdir_t dir;
2616:Core/Src/littlefs/lfs.c ****     err = lfs_dir_alloc(lfs, &dir);
2617:Core/Src/littlefs/lfs.c ****     if (err) {
2618:Core/Src/littlefs/lfs.c ****         return err;
2619:Core/Src/littlefs/lfs.c ****     }
2620:Core/Src/littlefs/lfs.c **** 
2621:Core/Src/littlefs/lfs.c ****     // find end of list
2622:Core/Src/littlefs/lfs.c ****     lfs_mdir_t pred = cwd.m;
2623:Core/Src/littlefs/lfs.c ****     while (pred.split) {
2624:Core/Src/littlefs/lfs.c ****         err = lfs_dir_fetch(lfs, &pred, pred.tail);
2625:Core/Src/littlefs/lfs.c ****         if (err) {
2626:Core/Src/littlefs/lfs.c ****             return err;
2627:Core/Src/littlefs/lfs.c ****         }
2628:Core/Src/littlefs/lfs.c ****     }
2629:Core/Src/littlefs/lfs.c **** 
2630:Core/Src/littlefs/lfs.c ****     // setup dir
2631:Core/Src/littlefs/lfs.c ****     lfs_pair_tole32(pred.tail);
2632:Core/Src/littlefs/lfs.c ****     err = lfs_dir_commit(lfs, &dir, LFS_MKATTRS(
2633:Core/Src/littlefs/lfs.c ****             {LFS_MKTAG(LFS_TYPE_SOFTTAIL, 0x3ff, 8), pred.tail}));
2634:Core/Src/littlefs/lfs.c ****     lfs_pair_fromle32(pred.tail);
2635:Core/Src/littlefs/lfs.c ****     if (err) {
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 65


2636:Core/Src/littlefs/lfs.c ****         return err;
2637:Core/Src/littlefs/lfs.c ****     }
2638:Core/Src/littlefs/lfs.c **** 
2639:Core/Src/littlefs/lfs.c ****     // current block not end of list?
2640:Core/Src/littlefs/lfs.c ****     if (cwd.m.split) {
2641:Core/Src/littlefs/lfs.c ****         // update tails, this creates a desync
2642:Core/Src/littlefs/lfs.c ****         err = lfs_fs_preporphans(lfs, +1);
2643:Core/Src/littlefs/lfs.c ****         if (err) {
2644:Core/Src/littlefs/lfs.c ****             return err;
2645:Core/Src/littlefs/lfs.c ****         }
2646:Core/Src/littlefs/lfs.c **** 
2647:Core/Src/littlefs/lfs.c ****         // it's possible our predecessor has to be relocated, and if
2648:Core/Src/littlefs/lfs.c ****         // our parent is our predecessor's predecessor, this could have
2649:Core/Src/littlefs/lfs.c ****         // caused our parent to go out of date, fortunately we can hook
2650:Core/Src/littlefs/lfs.c ****         // ourselves into littlefs to catch this
2651:Core/Src/littlefs/lfs.c ****         cwd.type = 0;
2652:Core/Src/littlefs/lfs.c ****         cwd.id = 0;
2653:Core/Src/littlefs/lfs.c ****         lfs->mlist = &cwd;
2654:Core/Src/littlefs/lfs.c **** 
2655:Core/Src/littlefs/lfs.c ****         lfs_pair_tole32(dir.pair);
2656:Core/Src/littlefs/lfs.c ****         err = lfs_dir_commit(lfs, &pred, LFS_MKATTRS(
2657:Core/Src/littlefs/lfs.c ****                 {LFS_MKTAG(LFS_TYPE_SOFTTAIL, 0x3ff, 8), dir.pair}));
2658:Core/Src/littlefs/lfs.c ****         lfs_pair_fromle32(dir.pair);
2659:Core/Src/littlefs/lfs.c ****         if (err) {
2660:Core/Src/littlefs/lfs.c ****             lfs->mlist = cwd.next;
2661:Core/Src/littlefs/lfs.c ****             return err;
2662:Core/Src/littlefs/lfs.c ****         }
2663:Core/Src/littlefs/lfs.c **** 
2664:Core/Src/littlefs/lfs.c ****         lfs->mlist = cwd.next;
2665:Core/Src/littlefs/lfs.c ****         err = lfs_fs_preporphans(lfs, -1);
2666:Core/Src/littlefs/lfs.c ****         if (err) {
2667:Core/Src/littlefs/lfs.c ****             return err;
2668:Core/Src/littlefs/lfs.c ****         }
2669:Core/Src/littlefs/lfs.c ****     }
2670:Core/Src/littlefs/lfs.c **** 
2671:Core/Src/littlefs/lfs.c ****     // now insert into our parent block
2672:Core/Src/littlefs/lfs.c ****     lfs_pair_tole32(dir.pair);
2673:Core/Src/littlefs/lfs.c ****     err = lfs_dir_commit(lfs, &cwd.m, LFS_MKATTRS(
2674:Core/Src/littlefs/lfs.c ****             {LFS_MKTAG(LFS_TYPE_CREATE, id, 0), NULL},
2675:Core/Src/littlefs/lfs.c ****             {LFS_MKTAG(LFS_TYPE_DIR, id, nlen), path},
2676:Core/Src/littlefs/lfs.c ****             {LFS_MKTAG(LFS_TYPE_DIRSTRUCT, id, 8), dir.pair},
2677:Core/Src/littlefs/lfs.c ****             {LFS_MKTAG_IF(!cwd.m.split,
2678:Core/Src/littlefs/lfs.c ****                 LFS_TYPE_SOFTTAIL, 0x3ff, 8), dir.pair}));
2679:Core/Src/littlefs/lfs.c ****     lfs_pair_fromle32(dir.pair);
