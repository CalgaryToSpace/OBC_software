4553:Core/Src/littlefs/lfs.c **** 
4554:Core/Src/littlefs/lfs.c ****     // setup free lookahead, to distribute allocations uniformly across
4555:Core/Src/littlefs/lfs.c ****     // boots, we start the allocator at a random location
4556:Core/Src/littlefs/lfs.c ****     lfs->lookahead.start = lfs->seed % lfs->block_count;
