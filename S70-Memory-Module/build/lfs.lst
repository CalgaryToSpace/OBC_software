2325:Core/Src/littlefs/lfs.c **** fixmlist:;
2326:Core/Src/littlefs/lfs.c ****     // this complicated bit of logic is for fixing up any active
2327:Core/Src/littlefs/lfs.c ****     // metadata-pairs that we may have affected
2328:Core/Src/littlefs/lfs.c ****     //
2329:Core/Src/littlefs/lfs.c ****     // note we have to make two passes since the mdir passed to
2330:Core/Src/littlefs/lfs.c ****     // lfs_dir_commit could also be in this list, and even then
2331:Core/Src/littlefs/lfs.c ****     // we need to copy the pair so they don't get clobbered if we refetch
2332:Core/Src/littlefs/lfs.c ****     // our mdir.
2333:Core/Src/littlefs/lfs.c ****     lfs_block_t oldpair[2] = {pair[0], pair[1]};
2334:Core/Src/littlefs/lfs.c ****     for (struct lfs_mlist *d = lfs->mlist; d; d = d->next) {
2335:Core/Src/littlefs/lfs.c ****         if (lfs_pair_cmp(d->m.pair, oldpair) == 0) {
