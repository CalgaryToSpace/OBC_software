3768:Core/Src/littlefs/lfs.c ****                     file->ctz.head, file->ctz.size,
3769:Core/Src/littlefs/lfs.c ****                     size-1, &file->block, &(lfs_off_t){0});
3770:Core/Src/littlefs/lfs.c ****             if (err) {
