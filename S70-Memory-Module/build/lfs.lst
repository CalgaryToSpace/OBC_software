1786:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
1787:Core/Src/littlefs/lfs.c **** static int lfs_dir_alloc(lfs_t *lfs, lfs_mdir_t *dir) {
1788:Core/Src/littlefs/lfs.c ****     // allocate pair of dir blocks (backwards, so we write block 1 first)
1789:Core/Src/littlefs/lfs.c ****     for (int i = 0; i < 2; i++) {
