5383:Core/Src/littlefs/lfs.c ****             continue;
5384:Core/Src/littlefs/lfs.c ****         }
5385:Core/Src/littlefs/lfs.c **** 
5386:Core/Src/littlefs/lfs.c ****         if ((0x7fffffff & test.size) < sizeof(test)+4 ||
5387:Core/Src/littlefs/lfs.c ****             (0x7fffffff & test.size) > lfs->cfg->block_size) {
5388:Core/Src/littlefs/lfs.c ****             continue;
5389:Core/Src/littlefs/lfs.c ****         }
5390:Core/Src/littlefs/lfs.c **** 
5391:Core/Src/littlefs/lfs.c ****         uint32_t crc = 0xffffffff;
5392:Core/Src/littlefs/lfs.c ****         lfs1_dir_tole32(&test);
5393:Core/Src/littlefs/lfs.c ****         lfs1_crc(&crc, &test, sizeof(test));
5394:Core/Src/littlefs/lfs.c ****         lfs1_dir_fromle32(&test);
5395:Core/Src/littlefs/lfs.c ****         err = lfs1_bd_crc(lfs, tpair[i], sizeof(test),
5396:Core/Src/littlefs/lfs.c ****                 (0x7fffffff & test.size) - sizeof(test), &crc);
5397:Core/Src/littlefs/lfs.c ****         if (err) {
5398:Core/Src/littlefs/lfs.c ****             if (err == LFS_ERR_CORRUPT) {
5399:Core/Src/littlefs/lfs.c ****                 continue;
5400:Core/Src/littlefs/lfs.c ****             }
5401:Core/Src/littlefs/lfs.c ****             return err;
5402:Core/Src/littlefs/lfs.c ****         }
5403:Core/Src/littlefs/lfs.c **** 
5404:Core/Src/littlefs/lfs.c ****         if (crc != 0) {
5405:Core/Src/littlefs/lfs.c ****             continue;
