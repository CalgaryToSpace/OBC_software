4924:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
4925:Core/Src/littlefs/lfs.c **** static int lfs_fs_deorphan(lfs_t *lfs, bool powerloss) {
4926:Core/Src/littlefs/lfs.c ****     if (!lfs_gstate_hasorphans(&lfs->gstate)) {
4927:Core/Src/littlefs/lfs.c ****         return 0;
4928:Core/Src/littlefs/lfs.c ****     }
4929:Core/Src/littlefs/lfs.c **** 
4930:Core/Src/littlefs/lfs.c ****     // Check for orphans in two separate passes:
4931:Core/Src/littlefs/lfs.c ****     // - 1 for half-orphans (relocations)
4932:Core/Src/littlefs/lfs.c ****     // - 2 for full-orphans (removes/renames)
4933:Core/Src/littlefs/lfs.c ****     //
4934:Core/Src/littlefs/lfs.c ****     // Two separate passes are needed as half-orphans can contain outdated
4935:Core/Src/littlefs/lfs.c ****     // references to full-orphans, effectively hiding them from the deorphan
4936:Core/Src/littlefs/lfs.c ****     // search.
4937:Core/Src/littlefs/lfs.c ****     //
4938:Core/Src/littlefs/lfs.c ****     int pass = 0;
4939:Core/Src/littlefs/lfs.c ****     while (pass < 2) {
4940:Core/Src/littlefs/lfs.c ****         // Fix any orphans
4941:Core/Src/littlefs/lfs.c ****         lfs_mdir_t pdir = {.split = true, .tail = {0, 1}};
4942:Core/Src/littlefs/lfs.c ****         lfs_mdir_t dir;
4943:Core/Src/littlefs/lfs.c ****         bool moreorphans = false;
4944:Core/Src/littlefs/lfs.c **** 
4945:Core/Src/littlefs/lfs.c ****         // iterate over all directory directory entries
4946:Core/Src/littlefs/lfs.c ****         while (!lfs_pair_isnull(pdir.tail)) {
4947:Core/Src/littlefs/lfs.c ****             int err = lfs_dir_fetch(lfs, &dir, pdir.tail);
4948:Core/Src/littlefs/lfs.c ****             if (err) {
4949:Core/Src/littlefs/lfs.c ****                 return err;
4950:Core/Src/littlefs/lfs.c ****             }
4951:Core/Src/littlefs/lfs.c **** 
4952:Core/Src/littlefs/lfs.c ****             // check head blocks for orphans
4953:Core/Src/littlefs/lfs.c ****             if (!pdir.split) {
4954:Core/Src/littlefs/lfs.c ****                 // check if we have a parent
4955:Core/Src/littlefs/lfs.c ****                 lfs_mdir_t parent;
4956:Core/Src/littlefs/lfs.c ****                 lfs_stag_t tag = lfs_fs_parent(lfs, pdir.tail, &parent);
4957:Core/Src/littlefs/lfs.c ****                 if (tag < 0 && tag != LFS_ERR_NOENT) {
4958:Core/Src/littlefs/lfs.c ****                     return tag;
4959:Core/Src/littlefs/lfs.c ****                 }
4960:Core/Src/littlefs/lfs.c **** 
4961:Core/Src/littlefs/lfs.c ****                 if (pass == 0 && tag != LFS_ERR_NOENT) {
4962:Core/Src/littlefs/lfs.c ****                     lfs_block_t pair[2];
4963:Core/Src/littlefs/lfs.c ****                     lfs_stag_t state = lfs_dir_get(lfs, &parent,
4964:Core/Src/littlefs/lfs.c ****                             LFS_MKTAG(0x7ff, 0x3ff, 0), tag, pair);
4965:Core/Src/littlefs/lfs.c ****                     if (state < 0) {
4966:Core/Src/littlefs/lfs.c ****                         return state;
4967:Core/Src/littlefs/lfs.c ****                     }
4968:Core/Src/littlefs/lfs.c ****                     lfs_pair_fromle32(pair);
4969:Core/Src/littlefs/lfs.c **** 
4970:Core/Src/littlefs/lfs.c ****                     if (!lfs_pair_issync(pair, pdir.tail)) {
4971:Core/Src/littlefs/lfs.c ****                         // we have desynced
4972:Core/Src/littlefs/lfs.c ****                         LFS_DEBUG("Fixing half-orphan "
4973:Core/Src/littlefs/lfs.c ****                                 "{0x%"PRIx32", 0x%"PRIx32"} "
4974:Core/Src/littlefs/lfs.c ****                                 "-> {0x%"PRIx32", 0x%"PRIx32"}",
4975:Core/Src/littlefs/lfs.c ****                                 pdir.tail[0], pdir.tail[1], pair[0], pair[1]);
4976:Core/Src/littlefs/lfs.c **** 
4977:Core/Src/littlefs/lfs.c ****                         // fix pending move in this pair? this looks like an
4978:Core/Src/littlefs/lfs.c ****                         // optimization but is in fact _required_ since
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 112


4979:Core/Src/littlefs/lfs.c ****                         // relocating may outdate the move.
4980:Core/Src/littlefs/lfs.c ****                         uint16_t moveid = 0x3ff;
4981:Core/Src/littlefs/lfs.c ****                         if (lfs_gstate_hasmovehere(&lfs->gstate, pdir.pair)) {
4982:Core/Src/littlefs/lfs.c ****                             moveid = lfs_tag_id(lfs->gstate.tag);
4983:Core/Src/littlefs/lfs.c ****                             LFS_DEBUG("Fixing move while fixing orphans "
4984:Core/Src/littlefs/lfs.c ****                                     "{0x%"PRIx32", 0x%"PRIx32"} 0x%"PRIx16"\n",
4985:Core/Src/littlefs/lfs.c ****                                     pdir.pair[0], pdir.pair[1], moveid);
4986:Core/Src/littlefs/lfs.c ****                             lfs_fs_prepmove(lfs, 0x3ff, NULL);
4987:Core/Src/littlefs/lfs.c ****                         }
4988:Core/Src/littlefs/lfs.c **** 
4989:Core/Src/littlefs/lfs.c ****                         lfs_pair_tole32(pair);
4990:Core/Src/littlefs/lfs.c ****                         state = lfs_dir_orphaningcommit(lfs, &pdir, LFS_MKATTRS(
4991:Core/Src/littlefs/lfs.c ****                                 {LFS_MKTAG_IF(moveid != 0x3ff,
4992:Core/Src/littlefs/lfs.c ****                                     LFS_TYPE_DELETE, moveid, 0), NULL},
4993:Core/Src/littlefs/lfs.c ****                                 {LFS_MKTAG(LFS_TYPE_SOFTTAIL, 0x3ff, 8),
4994:Core/Src/littlefs/lfs.c ****                                     pair}));
4995:Core/Src/littlefs/lfs.c ****                         lfs_pair_fromle32(pair);
4996:Core/Src/littlefs/lfs.c ****                         if (state < 0) {
4997:Core/Src/littlefs/lfs.c ****                             return state;
4998:Core/Src/littlefs/lfs.c ****                         }
4999:Core/Src/littlefs/lfs.c **** 
5000:Core/Src/littlefs/lfs.c ****                         // did our commit create more orphans?
5001:Core/Src/littlefs/lfs.c ****                         if (state == LFS_OK_ORPHANED) {
5002:Core/Src/littlefs/lfs.c ****                             moreorphans = true;
5003:Core/Src/littlefs/lfs.c ****                         }
5004:Core/Src/littlefs/lfs.c **** 
5005:Core/Src/littlefs/lfs.c ****                         // refetch tail
5006:Core/Src/littlefs/lfs.c ****                         continue;
5007:Core/Src/littlefs/lfs.c ****                     }
5008:Core/Src/littlefs/lfs.c ****                 }
5009:Core/Src/littlefs/lfs.c **** 
5010:Core/Src/littlefs/lfs.c ****                 // note we only check for full orphans if we may have had a
5011:Core/Src/littlefs/lfs.c ****                 // power-loss, otherwise orphans are created intentionally
5012:Core/Src/littlefs/lfs.c ****                 // during operations such as lfs_mkdir
5013:Core/Src/littlefs/lfs.c ****                 if (pass == 1 && tag == LFS_ERR_NOENT && powerloss) {
5014:Core/Src/littlefs/lfs.c ****                     // we are an orphan
5015:Core/Src/littlefs/lfs.c ****                     LFS_DEBUG("Fixing orphan {0x%"PRIx32", 0x%"PRIx32"}",
5016:Core/Src/littlefs/lfs.c ****                             pdir.tail[0], pdir.tail[1]);
5017:Core/Src/littlefs/lfs.c **** 
5018:Core/Src/littlefs/lfs.c ****                     // steal state
5019:Core/Src/littlefs/lfs.c ****                     err = lfs_dir_getgstate(lfs, &dir, &lfs->gdelta);
5020:Core/Src/littlefs/lfs.c ****                     if (err) {
5021:Core/Src/littlefs/lfs.c ****                         return err;
5022:Core/Src/littlefs/lfs.c ****                     }
5023:Core/Src/littlefs/lfs.c **** 
5024:Core/Src/littlefs/lfs.c ****                     // steal tail
5025:Core/Src/littlefs/lfs.c ****                     lfs_pair_tole32(dir.tail);
5026:Core/Src/littlefs/lfs.c ****                     int state = lfs_dir_orphaningcommit(lfs, &pdir, LFS_MKATTRS(
5027:Core/Src/littlefs/lfs.c ****                             {LFS_MKTAG(LFS_TYPE_TAIL + dir.split, 0x3ff, 8),
5028:Core/Src/littlefs/lfs.c ****                                 dir.tail}));
5029:Core/Src/littlefs/lfs.c ****                     lfs_pair_fromle32(dir.tail);
5030:Core/Src/littlefs/lfs.c ****                     if (state < 0) {
5031:Core/Src/littlefs/lfs.c ****                         return state;
5032:Core/Src/littlefs/lfs.c ****                     }
5033:Core/Src/littlefs/lfs.c **** 
5034:Core/Src/littlefs/lfs.c ****                     // did our commit create more orphans?
5035:Core/Src/littlefs/lfs.c ****                     if (state == LFS_OK_ORPHANED) {
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 113


5036:Core/Src/littlefs/lfs.c ****                         moreorphans = true;
5037:Core/Src/littlefs/lfs.c ****                     }
5038:Core/Src/littlefs/lfs.c **** 
5039:Core/Src/littlefs/lfs.c ****                     // refetch tail
5040:Core/Src/littlefs/lfs.c ****                     continue;
5041:Core/Src/littlefs/lfs.c ****                 }
5042:Core/Src/littlefs/lfs.c ****             }
5043:Core/Src/littlefs/lfs.c **** 
5044:Core/Src/littlefs/lfs.c ****             pdir = dir;
5045:Core/Src/littlefs/lfs.c ****         }
5046:Core/Src/littlefs/lfs.c **** 
5047:Core/Src/littlefs/lfs.c ****         pass = moreorphans ? 0 : pass+1;
5048:Core/Src/littlefs/lfs.c ****     }
5049:Core/Src/littlefs/lfs.c **** 
5050:Core/Src/littlefs/lfs.c ****     // mark orphans as fixed
5051:Core/Src/littlefs/lfs.c ****     return lfs_fs_preporphans(lfs, -lfs_gstate_getorphans(&lfs->gstate));
5052:Core/Src/littlefs/lfs.c **** }
