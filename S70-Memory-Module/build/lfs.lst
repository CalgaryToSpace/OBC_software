 705:Core/Src/littlefs/lfs.c **** /// Metadata pair and directory operations ///
 706:Core/Src/littlefs/lfs.c **** static lfs_stag_t lfs_dir_getslice(lfs_t *lfs, const lfs_mdir_t *dir,
 707:Core/Src/littlefs/lfs.c ****         lfs_tag_t gmask, lfs_tag_t gtag,
 708:Core/Src/littlefs/lfs.c ****         lfs_off_t goff, void *gbuffer, lfs_size_t gsize) {
 709:Core/Src/littlefs/lfs.c ****     lfs_off_t off = dir->off;
 710:Core/Src/littlefs/lfs.c ****     lfs_tag_t ntag = dir->etag;
 711:Core/Src/littlefs/lfs.c ****     lfs_stag_t gdiff = 0;
 712:Core/Src/littlefs/lfs.c **** 
 713:Core/Src/littlefs/lfs.c ****     // synthetic moves
 714:Core/Src/littlefs/lfs.c ****     if (lfs_gstate_hasmovehere(&lfs->gdisk, dir->pair) &&
 715:Core/Src/littlefs/lfs.c ****             lfs_tag_id(gmask) != 0) {
 716:Core/Src/littlefs/lfs.c ****         if (lfs_tag_id(lfs->gdisk.tag) == lfs_tag_id(gtag)) {
 717:Core/Src/littlefs/lfs.c ****             return LFS_ERR_NOENT;
 718:Core/Src/littlefs/lfs.c ****         } else if (lfs_tag_id(lfs->gdisk.tag) < lfs_tag_id(gtag)) {
 719:Core/Src/littlefs/lfs.c ****             gdiff -= LFS_MKTAG(0, 1, 0);
 720:Core/Src/littlefs/lfs.c ****         }
 721:Core/Src/littlefs/lfs.c ****     }
 722:Core/Src/littlefs/lfs.c **** 
 723:Core/Src/littlefs/lfs.c ****     // iterate over dir block backwards (for faster lookups)
 724:Core/Src/littlefs/lfs.c ****     while (off >= sizeof(lfs_tag_t) + lfs_tag_dsize(ntag)) {
 725:Core/Src/littlefs/lfs.c ****         off -= lfs_tag_dsize(ntag);
 726:Core/Src/littlefs/lfs.c ****         lfs_tag_t tag = ntag;
 727:Core/Src/littlefs/lfs.c ****         int err = lfs_bd_read(lfs,
 728:Core/Src/littlefs/lfs.c ****                 NULL, &lfs->rcache, sizeof(ntag),
 729:Core/Src/littlefs/lfs.c ****                 dir->pair[0], off, &ntag, sizeof(ntag));
 730:Core/Src/littlefs/lfs.c ****         if (err) {
 731:Core/Src/littlefs/lfs.c ****             return err;
 732:Core/Src/littlefs/lfs.c ****         }
 733:Core/Src/littlefs/lfs.c **** 
 734:Core/Src/littlefs/lfs.c ****         ntag = (lfs_frombe32(ntag) ^ tag) & 0x7fffffff;
 735:Core/Src/littlefs/lfs.c **** 
 736:Core/Src/littlefs/lfs.c ****         if (lfs_tag_id(gmask) != 0 &&
 737:Core/Src/littlefs/lfs.c ****                 lfs_tag_type1(tag) == LFS_TYPE_SPLICE &&
 738:Core/Src/littlefs/lfs.c ****                 lfs_tag_id(tag) <= lfs_tag_id(gtag - gdiff)) {
 739:Core/Src/littlefs/lfs.c ****             if (tag == (LFS_MKTAG(LFS_TYPE_CREATE, 0, 0) |
 740:Core/Src/littlefs/lfs.c ****                     (LFS_MKTAG(0, 0x3ff, 0) & (gtag - gdiff)))) {
 741:Core/Src/littlefs/lfs.c ****                 // found where we were created
 742:Core/Src/littlefs/lfs.c ****                 return LFS_ERR_NOENT;
 743:Core/Src/littlefs/lfs.c ****             }
 744:Core/Src/littlefs/lfs.c **** 
 745:Core/Src/littlefs/lfs.c ****             // move around splices
 746:Core/Src/littlefs/lfs.c ****             gdiff += LFS_MKTAG(0, lfs_tag_splice(tag), 0);
 747:Core/Src/littlefs/lfs.c ****         }
 748:Core/Src/littlefs/lfs.c **** 
 749:Core/Src/littlefs/lfs.c ****         if ((gmask & tag) == (gmask & (gtag - gdiff))) {
 750:Core/Src/littlefs/lfs.c ****             if (lfs_tag_isdelete(tag)) {
 751:Core/Src/littlefs/lfs.c ****                 return LFS_ERR_NOENT;
 752:Core/Src/littlefs/lfs.c ****             }
 753:Core/Src/littlefs/lfs.c **** 
 754:Core/Src/littlefs/lfs.c ****             lfs_size_t diff = lfs_min(lfs_tag_size(tag), gsize);
 755:Core/Src/littlefs/lfs.c ****             err = lfs_bd_read(lfs,
 756:Core/Src/littlefs/lfs.c ****                     NULL, &lfs->rcache, diff,
 757:Core/Src/littlefs/lfs.c ****                     dir->pair[0], off+sizeof(tag)+goff, gbuffer, diff);
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 26


 758:Core/Src/littlefs/lfs.c ****             if (err) {
 759:Core/Src/littlefs/lfs.c ****                 return err;
 760:Core/Src/littlefs/lfs.c ****             }
 761:Core/Src/littlefs/lfs.c **** 
