2073:Core/Src/littlefs/lfs.c ****         }
2074:Core/Src/littlefs/lfs.c **** 
2075:Core/Src/littlefs/lfs.c ****         // can't relocate superblock, filesystem is now frozen
2076:Core/Src/littlefs/lfs.c ****         if (lfs_pair_cmp(dir->pair, (const lfs_block_t[2]){0, 1}) == 0) {
2077:Core/Src/littlefs/lfs.c ****             LFS_WARN("Superblock 0x%"PRIx32" has become unwritable",
2078:Core/Src/littlefs/lfs.c ****                     dir->pair[1]);
2079:Core/Src/littlefs/lfs.c ****             return LFS_ERR_NOSPC;
2080:Core/Src/littlefs/lfs.c ****         }
2081:Core/Src/littlefs/lfs.c **** 
2082:Core/Src/littlefs/lfs.c ****         // relocate half of pair
2083:Core/Src/littlefs/lfs.c ****         int err = lfs_alloc(lfs, &dir->pair[1]);
2084:Core/Src/littlefs/lfs.c ****         if (err && (err != LFS_ERR_NOSPC || !tired)) {
2085:Core/Src/littlefs/lfs.c ****             return err;
2086:Core/Src/littlefs/lfs.c ****         }
2087:Core/Src/littlefs/lfs.c **** 
2088:Core/Src/littlefs/lfs.c ****         tired = false;
