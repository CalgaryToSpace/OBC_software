3531:Core/Src/littlefs/lfs.c **** 
3532:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
3533:Core/Src/littlefs/lfs.c **** static lfs_ssize_t lfs_file_flushedwrite(lfs_t *lfs, lfs_file_t *file,
3534:Core/Src/littlefs/lfs.c ****         const void *buffer, lfs_size_t size) {
3535:Core/Src/littlefs/lfs.c ****     const uint8_t *data = buffer;
3536:Core/Src/littlefs/lfs.c ****     lfs_size_t nsize = size;
3537:Core/Src/littlefs/lfs.c **** 
3538:Core/Src/littlefs/lfs.c ****     if ((file->flags & LFS_F_INLINE) &&
3539:Core/Src/littlefs/lfs.c ****             lfs_max(file->pos+nsize, file->ctz.size) > lfs->inline_max) {
3540:Core/Src/littlefs/lfs.c ****         // inline file doesn't fit anymore
3541:Core/Src/littlefs/lfs.c ****         int err = lfs_file_outline(lfs, file);
3542:Core/Src/littlefs/lfs.c ****         if (err) {
3543:Core/Src/littlefs/lfs.c ****             file->flags |= LFS_F_ERRED;
3544:Core/Src/littlefs/lfs.c ****             return err;
3545:Core/Src/littlefs/lfs.c ****         }
3546:Core/Src/littlefs/lfs.c ****     }
3547:Core/Src/littlefs/lfs.c **** 
3548:Core/Src/littlefs/lfs.c ****     while (nsize > 0) {
3549:Core/Src/littlefs/lfs.c ****         // check if we need a new block
3550:Core/Src/littlefs/lfs.c ****         if (!(file->flags & LFS_F_WRITING) ||
3551:Core/Src/littlefs/lfs.c ****                 file->off == lfs->cfg->block_size) {
3552:Core/Src/littlefs/lfs.c ****             if (!(file->flags & LFS_F_INLINE)) {
3553:Core/Src/littlefs/lfs.c ****                 if (!(file->flags & LFS_F_WRITING) && file->pos > 0) {
3554:Core/Src/littlefs/lfs.c ****                     // find out which block we're extending from
3555:Core/Src/littlefs/lfs.c ****                     int err = lfs_ctz_find(lfs, NULL, &file->cache,
3556:Core/Src/littlefs/lfs.c ****                             file->ctz.head, file->ctz.size,
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 82


3557:Core/Src/littlefs/lfs.c ****                             file->pos-1, &file->block, &(lfs_off_t){0});
3558:Core/Src/littlefs/lfs.c ****                     if (err) {
3559:Core/Src/littlefs/lfs.c ****                         file->flags |= LFS_F_ERRED;
3560:Core/Src/littlefs/lfs.c ****                         return err;
3561:Core/Src/littlefs/lfs.c ****                     }
3562:Core/Src/littlefs/lfs.c **** 
3563:Core/Src/littlefs/lfs.c ****                     // mark cache as dirty since we may have read data into it
3564:Core/Src/littlefs/lfs.c ****                     lfs_cache_zero(lfs, &file->cache);
3565:Core/Src/littlefs/lfs.c ****                 }
3566:Core/Src/littlefs/lfs.c **** 
3567:Core/Src/littlefs/lfs.c ****                 // extend file with new blocks
3568:Core/Src/littlefs/lfs.c ****                 lfs_alloc_ckpoint(lfs);
3569:Core/Src/littlefs/lfs.c ****                 int err = lfs_ctz_extend(lfs, &file->cache, &lfs->rcache,
3570:Core/Src/littlefs/lfs.c ****                         file->block, file->pos,
3571:Core/Src/littlefs/lfs.c ****                         &file->block, &file->off);
3572:Core/Src/littlefs/lfs.c ****                 if (err) {
3573:Core/Src/littlefs/lfs.c ****                     file->flags |= LFS_F_ERRED;
3574:Core/Src/littlefs/lfs.c ****                     return err;
3575:Core/Src/littlefs/lfs.c ****                 }
3576:Core/Src/littlefs/lfs.c ****             } else {
3577:Core/Src/littlefs/lfs.c ****                 file->block = LFS_BLOCK_INLINE;
3578:Core/Src/littlefs/lfs.c ****                 file->off = file->pos;
3579:Core/Src/littlefs/lfs.c ****             }
3580:Core/Src/littlefs/lfs.c **** 
3581:Core/Src/littlefs/lfs.c ****             file->flags |= LFS_F_WRITING;
3582:Core/Src/littlefs/lfs.c ****         }
3583:Core/Src/littlefs/lfs.c **** 
3584:Core/Src/littlefs/lfs.c ****         // program as much as we can in current block
3585:Core/Src/littlefs/lfs.c ****         lfs_size_t diff = lfs_min(nsize, lfs->cfg->block_size - file->off);
3586:Core/Src/littlefs/lfs.c ****         while (true) {
3587:Core/Src/littlefs/lfs.c ****             int err = lfs_bd_prog(lfs, &file->cache, &lfs->rcache, true,
3588:Core/Src/littlefs/lfs.c ****                     file->block, file->off, data, diff);
3589:Core/Src/littlefs/lfs.c ****             if (err) {
3590:Core/Src/littlefs/lfs.c ****                 if (err == LFS_ERR_CORRUPT) {
3591:Core/Src/littlefs/lfs.c ****                     goto relocate;
3592:Core/Src/littlefs/lfs.c ****                 }
3593:Core/Src/littlefs/lfs.c ****                 file->flags |= LFS_F_ERRED;
3594:Core/Src/littlefs/lfs.c ****                 return err;
3595:Core/Src/littlefs/lfs.c ****             }
3596:Core/Src/littlefs/lfs.c **** 
3597:Core/Src/littlefs/lfs.c ****             break;
3598:Core/Src/littlefs/lfs.c **** relocate:
3599:Core/Src/littlefs/lfs.c ****             err = lfs_file_relocate(lfs, file);
3600:Core/Src/littlefs/lfs.c ****             if (err) {
3601:Core/Src/littlefs/lfs.c ****                 file->flags |= LFS_F_ERRED;
3602:Core/Src/littlefs/lfs.c ****                 return err;
3603:Core/Src/littlefs/lfs.c ****             }
3604:Core/Src/littlefs/lfs.c ****         }
3605:Core/Src/littlefs/lfs.c **** 
3606:Core/Src/littlefs/lfs.c ****         file->pos += diff;
3607:Core/Src/littlefs/lfs.c ****         file->off += diff;
3608:Core/Src/littlefs/lfs.c ****         data += diff;
3609:Core/Src/littlefs/lfs.c ****         nsize -= diff;
3610:Core/Src/littlefs/lfs.c **** 
3611:Core/Src/littlefs/lfs.c ****         lfs_alloc_ckpoint(lfs);
3612:Core/Src/littlefs/lfs.c ****     }
3613:Core/Src/littlefs/lfs.c **** 
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 83


3614:Core/Src/littlefs/lfs.c ****     return size;
3615:Core/Src/littlefs/lfs.c **** }
