1800:Core/Src/littlefs/lfs.c ****     // the revision may be valid
1801:Core/Src/littlefs/lfs.c ****     int err = lfs_bd_read(lfs,
1802:Core/Src/littlefs/lfs.c ****             NULL, &lfs->rcache, sizeof(dir->rev),
