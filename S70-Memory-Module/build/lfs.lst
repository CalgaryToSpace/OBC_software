2090:Core/Src/littlefs/lfs.c ****     }
2091:Core/Src/littlefs/lfs.c **** 
2092:Core/Src/littlefs/lfs.c ****     return relocated ? LFS_OK_RELOCATED : 0;
2093:Core/Src/littlefs/lfs.c **** }
2094:Core/Src/littlefs/lfs.c **** #endif
2095:Core/Src/littlefs/lfs.c **** 
2096:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
2097:Core/Src/littlefs/lfs.c **** static int lfs_dir_splittingcompact(lfs_t *lfs, lfs_mdir_t *dir,
2098:Core/Src/littlefs/lfs.c ****         const struct lfs_mattr *attrs, int attrcount,
2099:Core/Src/littlefs/lfs.c ****         lfs_mdir_t *source, uint16_t begin, uint16_t end) {
2100:Core/Src/littlefs/lfs.c ****     while (true) {
2101:Core/Src/littlefs/lfs.c ****         // find size of first split, we do this by halving the split until
2102:Core/Src/littlefs/lfs.c ****         // the metadata is guaranteed to fit
2103:Core/Src/littlefs/lfs.c ****         //
2104:Core/Src/littlefs/lfs.c ****         // Note that this isn't a true binary search, we never increase the
2105:Core/Src/littlefs/lfs.c ****         // split size. This may result in poorly distributed metadata but isn't
2106:Core/Src/littlefs/lfs.c ****         // worth the extra code size or performance hit to fix.
2107:Core/Src/littlefs/lfs.c ****         lfs_size_t split = begin;
2108:Core/Src/littlefs/lfs.c ****         while (end - split > 1) {
2109:Core/Src/littlefs/lfs.c ****             lfs_size_t size = 0;
2110:Core/Src/littlefs/lfs.c ****             int err = lfs_dir_traverse(lfs,
2111:Core/Src/littlefs/lfs.c ****                     source, 0, 0xffffffff, attrs, attrcount,
2112:Core/Src/littlefs/lfs.c ****                     LFS_MKTAG(0x400, 0x3ff, 0),
2113:Core/Src/littlefs/lfs.c ****                     LFS_MKTAG(LFS_TYPE_NAME, 0, 0),
2114:Core/Src/littlefs/lfs.c ****                     split, end, -split,
2115:Core/Src/littlefs/lfs.c ****                     lfs_dir_commit_size, &size);
2116:Core/Src/littlefs/lfs.c ****             if (err) {
2117:Core/Src/littlefs/lfs.c ****                 return err;
2118:Core/Src/littlefs/lfs.c ****             }
2119:Core/Src/littlefs/lfs.c **** 
2120:Core/Src/littlefs/lfs.c ****             // space is complicated, we need room for:
2121:Core/Src/littlefs/lfs.c ****             //
2122:Core/Src/littlefs/lfs.c ****             // - tail:         4+2*4 = 12 bytes
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 56


2123:Core/Src/littlefs/lfs.c ****             // - gstate:       4+3*4 = 16 bytes
2124:Core/Src/littlefs/lfs.c ****             // - move delete:  4     = 4 bytes
2125:Core/Src/littlefs/lfs.c ****             // - crc:          4+4   = 8 bytes
2126:Core/Src/littlefs/lfs.c ****             //                 total = 40 bytes
2127:Core/Src/littlefs/lfs.c ****             //
2128:Core/Src/littlefs/lfs.c ****             // And we cap at half a block to avoid degenerate cases with
2129:Core/Src/littlefs/lfs.c ****             // nearly-full metadata blocks.
2130:Core/Src/littlefs/lfs.c ****             //
2131:Core/Src/littlefs/lfs.c ****             if (end - split < 0xff
2132:Core/Src/littlefs/lfs.c ****                     && size <= lfs_min(
2133:Core/Src/littlefs/lfs.c ****                         lfs->cfg->block_size - 40,
2134:Core/Src/littlefs/lfs.c ****                         lfs_alignup(
2135:Core/Src/littlefs/lfs.c ****                             (lfs->cfg->metadata_max
2136:Core/Src/littlefs/lfs.c ****                                 ? lfs->cfg->metadata_max
2137:Core/Src/littlefs/lfs.c ****                                 : lfs->cfg->block_size)/2,
2138:Core/Src/littlefs/lfs.c ****                             lfs->cfg->prog_size))) {
2139:Core/Src/littlefs/lfs.c ****                 break;
2140:Core/Src/littlefs/lfs.c ****             }
2141:Core/Src/littlefs/lfs.c **** 
2142:Core/Src/littlefs/lfs.c ****             split = split + ((end - split) / 2);
2143:Core/Src/littlefs/lfs.c ****         }
2144:Core/Src/littlefs/lfs.c **** 
2145:Core/Src/littlefs/lfs.c ****         if (split == begin) {
2146:Core/Src/littlefs/lfs.c ****             // no split needed
2147:Core/Src/littlefs/lfs.c ****             break;
2148:Core/Src/littlefs/lfs.c ****         }
2149:Core/Src/littlefs/lfs.c **** 
2150:Core/Src/littlefs/lfs.c ****         // split into two metadata pairs and continue
2151:Core/Src/littlefs/lfs.c ****         int err = lfs_dir_split(lfs, dir, attrs, attrcount,
2152:Core/Src/littlefs/lfs.c ****                 source, split, end);
2153:Core/Src/littlefs/lfs.c ****         if (err && err != LFS_ERR_NOSPC) {
2154:Core/Src/littlefs/lfs.c ****             return err;
2155:Core/Src/littlefs/lfs.c ****         }
2156:Core/Src/littlefs/lfs.c **** 
2157:Core/Src/littlefs/lfs.c ****         if (err) {
2158:Core/Src/littlefs/lfs.c ****             // we can't allocate a new block, try to compact with degraded
2159:Core/Src/littlefs/lfs.c ****             // performance
2160:Core/Src/littlefs/lfs.c ****             LFS_WARN("Unable to split {0x%"PRIx32", 0x%"PRIx32"}",
2161:Core/Src/littlefs/lfs.c ****                     dir->pair[0], dir->pair[1]);
2162:Core/Src/littlefs/lfs.c ****             break;
2163:Core/Src/littlefs/lfs.c ****         } else {
2164:Core/Src/littlefs/lfs.c ****             end = split;
2165:Core/Src/littlefs/lfs.c ****         }
2166:Core/Src/littlefs/lfs.c ****     }
2167:Core/Src/littlefs/lfs.c **** 
2168:Core/Src/littlefs/lfs.c ****     if (lfs_dir_needsrelocation(lfs, dir)
2169:Core/Src/littlefs/lfs.c ****             && lfs_pair_cmp(dir->pair, (const lfs_block_t[2]){0, 1}) == 0) {
2170:Core/Src/littlefs/lfs.c ****         // oh no! we're writing too much to the superblock,
2171:Core/Src/littlefs/lfs.c ****         // should we expand?
2172:Core/Src/littlefs/lfs.c ****         lfs_ssize_t size = lfs_fs_size_(lfs);
2173:Core/Src/littlefs/lfs.c ****         if (size < 0) {
2174:Core/Src/littlefs/lfs.c ****             return size;
2175:Core/Src/littlefs/lfs.c ****         }
2176:Core/Src/littlefs/lfs.c **** 
2177:Core/Src/littlefs/lfs.c ****         // littlefs cannot reclaim expanded superblocks, so expand cautiously
2178:Core/Src/littlefs/lfs.c ****         //
2179:Core/Src/littlefs/lfs.c ****         // if our filesystem is more than ~88% full, don't expand, this is
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 57


2180:Core/Src/littlefs/lfs.c ****         // somewhat arbitrary
2181:Core/Src/littlefs/lfs.c ****         if (lfs->block_count - size > lfs->block_count/8) {
2182:Core/Src/littlefs/lfs.c ****             LFS_DEBUG("Expanding superblock at rev %"PRIu32, dir->rev);
2183:Core/Src/littlefs/lfs.c ****             int err = lfs_dir_split(lfs, dir, attrs, attrcount,
2184:Core/Src/littlefs/lfs.c ****                     source, begin, end);
2185:Core/Src/littlefs/lfs.c ****             if (err && err != LFS_ERR_NOSPC) {
2186:Core/Src/littlefs/lfs.c ****                 return err;
2187:Core/Src/littlefs/lfs.c ****             }
2188:Core/Src/littlefs/lfs.c **** 
2189:Core/Src/littlefs/lfs.c ****             if (err) {
2190:Core/Src/littlefs/lfs.c ****                 // welp, we tried, if we ran out of space there's not much
2191:Core/Src/littlefs/lfs.c ****                 // we can do, we'll error later if we've become frozen
2192:Core/Src/littlefs/lfs.c ****                 LFS_WARN("Unable to expand superblock");
2193:Core/Src/littlefs/lfs.c ****             } else {
2194:Core/Src/littlefs/lfs.c ****                 end = begin;
2195:Core/Src/littlefs/lfs.c ****             }
2196:Core/Src/littlefs/lfs.c ****         }
2197:Core/Src/littlefs/lfs.c ****     }
2198:Core/Src/littlefs/lfs.c **** 
2199:Core/Src/littlefs/lfs.c ****     return lfs_dir_compact(lfs, dir, attrs, attrcount, source, begin, end);
2200:Core/Src/littlefs/lfs.c **** }
2201:Core/Src/littlefs/lfs.c **** #endif
2202:Core/Src/littlefs/lfs.c **** 
2203:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
2204:Core/Src/littlefs/lfs.c **** static int lfs_dir_relocatingcommit(lfs_t *lfs, lfs_mdir_t *dir,
2205:Core/Src/littlefs/lfs.c ****         const lfs_block_t pair[2],
2206:Core/Src/littlefs/lfs.c ****         const struct lfs_mattr *attrs, int attrcount,
2207:Core/Src/littlefs/lfs.c ****         lfs_mdir_t *pdir) {
2208:Core/Src/littlefs/lfs.c ****     int state = 0;
2209:Core/Src/littlefs/lfs.c **** 
2210:Core/Src/littlefs/lfs.c ****     // calculate changes to the directory
2211:Core/Src/littlefs/lfs.c ****     bool hasdelete = false;
2212:Core/Src/littlefs/lfs.c ****     for (int i = 0; i < attrcount; i++) {
2213:Core/Src/littlefs/lfs.c ****         if (lfs_tag_type3(attrs[i].tag) == LFS_TYPE_CREATE) {
