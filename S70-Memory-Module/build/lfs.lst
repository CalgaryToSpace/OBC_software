5633:Core/Src/littlefs/lfs.c **** /// v1 migration ///
5634:Core/Src/littlefs/lfs.c **** static int lfs_migrate_(lfs_t *lfs, const struct lfs_config *cfg) {
5635:Core/Src/littlefs/lfs.c ****     struct lfs1 lfs1;
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 591


5636:Core/Src/littlefs/lfs.c **** 
5637:Core/Src/littlefs/lfs.c ****     // Indeterminate filesystem size not allowed for migration.
5638:Core/Src/littlefs/lfs.c ****     LFS_ASSERT(cfg->block_count != 0);
5639:Core/Src/littlefs/lfs.c **** 
5640:Core/Src/littlefs/lfs.c ****     int err = lfs1_mount(lfs, &lfs1, cfg);
5641:Core/Src/littlefs/lfs.c ****     if (err) {
5642:Core/Src/littlefs/lfs.c ****         return err;
