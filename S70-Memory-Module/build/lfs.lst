2739:Core/Src/littlefs/lfs.c **** static int lfs_dir_read_(lfs_t *lfs, lfs_dir_t *dir, struct lfs_info *info) {
2740:Core/Src/littlefs/lfs.c ****     memset(info, 0, sizeof(*info));
2741:Core/Src/littlefs/lfs.c **** 
2742:Core/Src/littlefs/lfs.c ****     // special offset for '.' and '..'
2743:Core/Src/littlefs/lfs.c ****     if (dir->pos == 0) {
2744:Core/Src/littlefs/lfs.c ****         info->type = LFS_TYPE_DIR;
2745:Core/Src/littlefs/lfs.c ****         strcpy(info->name, ".");
2746:Core/Src/littlefs/lfs.c ****         dir->pos += 1;
2747:Core/Src/littlefs/lfs.c ****         return true;
2748:Core/Src/littlefs/lfs.c ****     } else if (dir->pos == 1) {
2749:Core/Src/littlefs/lfs.c ****         info->type = LFS_TYPE_DIR;
2750:Core/Src/littlefs/lfs.c ****         strcpy(info->name, "..");
2751:Core/Src/littlefs/lfs.c ****         dir->pos += 1;
2752:Core/Src/littlefs/lfs.c ****         return true;
2753:Core/Src/littlefs/lfs.c ****     }
2754:Core/Src/littlefs/lfs.c **** 
2755:Core/Src/littlefs/lfs.c ****     while (true) {
2756:Core/Src/littlefs/lfs.c ****         if (dir->id == dir->m.count) {
2757:Core/Src/littlefs/lfs.c ****             if (!dir->m.split) {
2758:Core/Src/littlefs/lfs.c ****                 return false;
2759:Core/Src/littlefs/lfs.c ****             }
2760:Core/Src/littlefs/lfs.c **** 
2761:Core/Src/littlefs/lfs.c ****             int err = lfs_dir_fetch(lfs, &dir->m, dir->m.tail);
2762:Core/Src/littlefs/lfs.c ****             if (err) {
2763:Core/Src/littlefs/lfs.c ****                 return err;
2764:Core/Src/littlefs/lfs.c ****             }
2765:Core/Src/littlefs/lfs.c **** 
2766:Core/Src/littlefs/lfs.c ****             dir->id = 0;
2767:Core/Src/littlefs/lfs.c ****         }
2768:Core/Src/littlefs/lfs.c **** 
2769:Core/Src/littlefs/lfs.c ****         int err = lfs_dir_getinfo(lfs, &dir->m, dir->id, info);
2770:Core/Src/littlefs/lfs.c ****         if (err && err != LFS_ERR_NOENT) {
2771:Core/Src/littlefs/lfs.c ****             return err;
2772:Core/Src/littlefs/lfs.c ****         }
2773:Core/Src/littlefs/lfs.c **** 
2774:Core/Src/littlefs/lfs.c ****         dir->id += 1;
2775:Core/Src/littlefs/lfs.c ****         if (err != LFS_ERR_NOENT) {
2776:Core/Src/littlefs/lfs.c ****             break;
2777:Core/Src/littlefs/lfs.c ****         }
2778:Core/Src/littlefs/lfs.c ****     }
2779:Core/Src/littlefs/lfs.c **** 
2780:Core/Src/littlefs/lfs.c ****     dir->pos += 1;
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 68


2781:Core/Src/littlefs/lfs.c ****     return true;
2782:Core/Src/littlefs/lfs.c **** }
2783:Core/Src/littlefs/lfs.c **** 
2784:Core/Src/littlefs/lfs.c **** static int lfs_dir_seek_(lfs_t *lfs, lfs_dir_t *dir, lfs_off_t off) {
2785:Core/Src/littlefs/lfs.c ****     // simply walk from head dir
2786:Core/Src/littlefs/lfs.c ****     int err = lfs_dir_rewind_(lfs, dir);
2787:Core/Src/littlefs/lfs.c ****     if (err) {
2788:Core/Src/littlefs/lfs.c ****         return err;
2789:Core/Src/littlefs/lfs.c ****     }
2790:Core/Src/littlefs/lfs.c **** 
2791:Core/Src/littlefs/lfs.c ****     // first two for ./..
2792:Core/Src/littlefs/lfs.c ****     dir->pos = lfs_min(2, off);
2793:Core/Src/littlefs/lfs.c ****     off -= dir->pos;
2794:Core/Src/littlefs/lfs.c **** 
2795:Core/Src/littlefs/lfs.c ****     // skip superblock entry
2796:Core/Src/littlefs/lfs.c ****     dir->id = (off > 0 && lfs_pair_cmp(dir->head, lfs->root) == 0);
2797:Core/Src/littlefs/lfs.c **** 
2798:Core/Src/littlefs/lfs.c ****     while (off > 0) {
2799:Core/Src/littlefs/lfs.c ****         if (dir->id == dir->m.count) {
2800:Core/Src/littlefs/lfs.c ****             if (!dir->m.split) {
2801:Core/Src/littlefs/lfs.c ****                 return LFS_ERR_INVAL;
2802:Core/Src/littlefs/lfs.c ****             }
2803:Core/Src/littlefs/lfs.c **** 
2804:Core/Src/littlefs/lfs.c ****             err = lfs_dir_fetch(lfs, &dir->m, dir->m.tail);
2805:Core/Src/littlefs/lfs.c ****             if (err) {
2806:Core/Src/littlefs/lfs.c ****                 return err;
2807:Core/Src/littlefs/lfs.c ****             }
2808:Core/Src/littlefs/lfs.c **** 
2809:Core/Src/littlefs/lfs.c ****             dir->id = 0;
2810:Core/Src/littlefs/lfs.c ****         }
2811:Core/Src/littlefs/lfs.c **** 
2812:Core/Src/littlefs/lfs.c ****         int diff = lfs_min(dir->m.count - dir->id, off);
2813:Core/Src/littlefs/lfs.c ****         dir->id += diff;
2814:Core/Src/littlefs/lfs.c ****         dir->pos += diff;
2815:Core/Src/littlefs/lfs.c ****         off -= diff;
2816:Core/Src/littlefs/lfs.c ****     }
2817:Core/Src/littlefs/lfs.c **** 
2818:Core/Src/littlefs/lfs.c ****     return 0;
2819:Core/Src/littlefs/lfs.c **** }
