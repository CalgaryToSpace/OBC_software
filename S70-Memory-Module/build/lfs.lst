4401:Core/Src/littlefs/lfs.c **** 
4402:Core/Src/littlefs/lfs.c ****     // scan directory blocks for superblock and any global updates
4403:Core/Src/littlefs/lfs.c ****     lfs_mdir_t dir = {.tail = {0, 1}};
4404:Core/Src/littlefs/lfs.c ****     lfs_block_t tortoise[2] = {LFS_BLOCK_NULL, LFS_BLOCK_NULL};
4405:Core/Src/littlefs/lfs.c ****     lfs_size_t tortoise_i = 1;
4406:Core/Src/littlefs/lfs.c ****     lfs_size_t tortoise_period = 1;
4407:Core/Src/littlefs/lfs.c ****     while (!lfs_pair_isnull(dir.tail)) {
4408:Core/Src/littlefs/lfs.c ****         // detect cycles with Brent's algorithm
4409:Core/Src/littlefs/lfs.c ****         if (lfs_pair_issync(dir.tail, tortoise)) {
4410:Core/Src/littlefs/lfs.c ****             LFS_WARN("Cycle detected in tail list");
4411:Core/Src/littlefs/lfs.c ****             err = LFS_ERR_CORRUPT;
4412:Core/Src/littlefs/lfs.c ****             goto cleanup;
4413:Core/Src/littlefs/lfs.c ****         }
4414:Core/Src/littlefs/lfs.c ****         if (tortoise_i == tortoise_period) {
4415:Core/Src/littlefs/lfs.c ****             tortoise[0] = dir.tail[0];
4416:Core/Src/littlefs/lfs.c ****             tortoise[1] = dir.tail[1];
4417:Core/Src/littlefs/lfs.c ****             tortoise_i = 0;
4418:Core/Src/littlefs/lfs.c ****             tortoise_period *= 2;
4419:Core/Src/littlefs/lfs.c ****         }
4420:Core/Src/littlefs/lfs.c ****         tortoise_i += 1;
4421:Core/Src/littlefs/lfs.c **** 
4422:Core/Src/littlefs/lfs.c ****         // fetch next block in tail list
4423:Core/Src/littlefs/lfs.c ****         lfs_stag_t tag = lfs_dir_fetchmatch(lfs, &dir, dir.tail,
4424:Core/Src/littlefs/lfs.c ****                 LFS_MKTAG(0x7ff, 0x3ff, 0),
4425:Core/Src/littlefs/lfs.c ****                 LFS_MKTAG(LFS_TYPE_SUPERBLOCK, 0, 8),
4426:Core/Src/littlefs/lfs.c ****                 NULL,
4427:Core/Src/littlefs/lfs.c ****                 lfs_dir_find_match, &(struct lfs_dir_find_match){
4428:Core/Src/littlefs/lfs.c ****                     lfs, "littlefs", 8});
4429:Core/Src/littlefs/lfs.c ****         if (tag < 0) {
4430:Core/Src/littlefs/lfs.c ****             err = tag;
4431:Core/Src/littlefs/lfs.c ****             goto cleanup;
4432:Core/Src/littlefs/lfs.c ****         }
4433:Core/Src/littlefs/lfs.c **** 
4434:Core/Src/littlefs/lfs.c ****         // has superblock?
4435:Core/Src/littlefs/lfs.c ****         if (tag && !lfs_tag_isdelete(tag)) {
4436:Core/Src/littlefs/lfs.c ****             // update root
4437:Core/Src/littlefs/lfs.c ****             lfs->root[0] = dir.pair[0];
4438:Core/Src/littlefs/lfs.c ****             lfs->root[1] = dir.pair[1];
4439:Core/Src/littlefs/lfs.c **** 
4440:Core/Src/littlefs/lfs.c ****             // grab superblock
4441:Core/Src/littlefs/lfs.c ****             lfs_superblock_t superblock;
4442:Core/Src/littlefs/lfs.c ****             tag = lfs_dir_get(lfs, &dir, LFS_MKTAG(0x7ff, 0x3ff, 0),
4443:Core/Src/littlefs/lfs.c ****                     LFS_MKTAG(LFS_TYPE_INLINESTRUCT, 0, sizeof(superblock)),
4444:Core/Src/littlefs/lfs.c ****                     &superblock);
4445:Core/Src/littlefs/lfs.c ****             if (tag < 0) {
4446:Core/Src/littlefs/lfs.c ****                 err = tag;
4447:Core/Src/littlefs/lfs.c ****                 goto cleanup;
4448:Core/Src/littlefs/lfs.c ****             }
4449:Core/Src/littlefs/lfs.c ****             lfs_superblock_fromle32(&superblock);
4450:Core/Src/littlefs/lfs.c **** 
4451:Core/Src/littlefs/lfs.c ****             // check version
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 101


4452:Core/Src/littlefs/lfs.c ****             uint16_t major_version = (0xffff & (superblock.version >> 16));
4453:Core/Src/littlefs/lfs.c ****             uint16_t minor_version = (0xffff & (superblock.version >>  0));
4454:Core/Src/littlefs/lfs.c ****             if (major_version != lfs_fs_disk_version_major(lfs)
4455:Core/Src/littlefs/lfs.c ****                     || minor_version > lfs_fs_disk_version_minor(lfs)) {
4456:Core/Src/littlefs/lfs.c ****                 LFS_ERROR("Invalid version "
4457:Core/Src/littlefs/lfs.c ****                         "v%"PRIu16".%"PRIu16" != v%"PRIu16".%"PRIu16,
4458:Core/Src/littlefs/lfs.c ****                         major_version,
4459:Core/Src/littlefs/lfs.c ****                         minor_version,
4460:Core/Src/littlefs/lfs.c ****                         lfs_fs_disk_version_major(lfs),
4461:Core/Src/littlefs/lfs.c ****                         lfs_fs_disk_version_minor(lfs));
4462:Core/Src/littlefs/lfs.c ****                 err = LFS_ERR_INVAL;
4463:Core/Src/littlefs/lfs.c ****                 goto cleanup;
4464:Core/Src/littlefs/lfs.c ****             }
4465:Core/Src/littlefs/lfs.c **** 
4466:Core/Src/littlefs/lfs.c ****             // found older minor version? set an in-device only bit in the
4467:Core/Src/littlefs/lfs.c ****             // gstate so we know we need to rewrite the superblock before
4468:Core/Src/littlefs/lfs.c ****             // the first write
4469:Core/Src/littlefs/lfs.c ****             if (minor_version < lfs_fs_disk_version_minor(lfs)) {
