2374:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
2375:Core/Src/littlefs/lfs.c **** static int lfs_dir_orphaningcommit(lfs_t *lfs, lfs_mdir_t *dir,
2376:Core/Src/littlefs/lfs.c ****         const struct lfs_mattr *attrs, int attrcount) {
2377:Core/Src/littlefs/lfs.c ****     // check for any inline files that aren't RAM backed and
2378:Core/Src/littlefs/lfs.c ****     // forcefully evict them, needed for filesystem consistency
2379:Core/Src/littlefs/lfs.c ****     for (lfs_file_t *f = (lfs_file_t*)lfs->mlist; f; f = f->next) {
2380:Core/Src/littlefs/lfs.c ****         if (dir != &f->m && lfs_pair_cmp(f->m.pair, dir->pair) == 0 &&
2381:Core/Src/littlefs/lfs.c ****                 f->type == LFS_TYPE_REG && (f->flags & LFS_F_INLINE) &&
2382:Core/Src/littlefs/lfs.c ****                 f->ctz.size > lfs->cfg->cache_size) {
2383:Core/Src/littlefs/lfs.c ****             int err = lfs_file_outline(lfs, f);
2384:Core/Src/littlefs/lfs.c ****             if (err) {
2385:Core/Src/littlefs/lfs.c ****                 return err;
2386:Core/Src/littlefs/lfs.c ****             }
2387:Core/Src/littlefs/lfs.c **** 
2388:Core/Src/littlefs/lfs.c ****             err = lfs_file_flush(lfs, f);
2389:Core/Src/littlefs/lfs.c ****             if (err) {
2390:Core/Src/littlefs/lfs.c ****                 return err;
2391:Core/Src/littlefs/lfs.c ****             }
2392:Core/Src/littlefs/lfs.c ****         }
2393:Core/Src/littlefs/lfs.c ****     }
2394:Core/Src/littlefs/lfs.c **** 
2395:Core/Src/littlefs/lfs.c ****     lfs_block_t lpair[2] = {dir->pair[0], dir->pair[1]};
2396:Core/Src/littlefs/lfs.c ****     lfs_mdir_t ldir = *dir;
2397:Core/Src/littlefs/lfs.c ****     lfs_mdir_t pdir;
2398:Core/Src/littlefs/lfs.c ****     int state = lfs_dir_relocatingcommit(lfs, &ldir, dir->pair,
2399:Core/Src/littlefs/lfs.c ****             attrs, attrcount, &pdir);
2400:Core/Src/littlefs/lfs.c ****     if (state < 0) {
2401:Core/Src/littlefs/lfs.c ****         return state;
2402:Core/Src/littlefs/lfs.c ****     }
2403:Core/Src/littlefs/lfs.c **** 
2404:Core/Src/littlefs/lfs.c ****     // update if we're not in mlist, note we may have already been
2405:Core/Src/littlefs/lfs.c ****     // updated if we are in mlist
2406:Core/Src/littlefs/lfs.c ****     if (lfs_pair_cmp(dir->pair, lpair) == 0) {
2407:Core/Src/littlefs/lfs.c ****         *dir = ldir;
