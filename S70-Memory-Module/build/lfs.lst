4068:Core/Src/littlefs/lfs.c ****     }
4069:Core/Src/littlefs/lfs.c **** 
4070:Core/Src/littlefs/lfs.c ****     uint16_t id = lfs_tag_id(tag);
4071:Core/Src/littlefs/lfs.c ****     if (id == 0x3ff) {
4072:Core/Src/littlefs/lfs.c ****         // special case for root
4073:Core/Src/littlefs/lfs.c ****         id = 0;
