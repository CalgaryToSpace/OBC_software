 627:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
 628:Core/Src/littlefs/lfs.c **** static int lfs_alloc_scan(lfs_t *lfs) {
 629:Core/Src/littlefs/lfs.c ****     // move lookahead buffer to the first unused block
 630:Core/Src/littlefs/lfs.c ****     //
 631:Core/Src/littlefs/lfs.c ****     // note we limit the lookahead buffer to at most the amount of blocks
 632:Core/Src/littlefs/lfs.c ****     // checkpointed, this prevents the math in lfs_alloc from underflowing
 633:Core/Src/littlefs/lfs.c ****     lfs->lookahead.start = (lfs->lookahead.start + lfs->lookahead.next) 
 634:Core/Src/littlefs/lfs.c ****             % lfs->block_count;
 635:Core/Src/littlefs/lfs.c ****     lfs->lookahead.next = 0;
 636:Core/Src/littlefs/lfs.c ****     lfs->lookahead.size = lfs_min(
 637:Core/Src/littlefs/lfs.c ****             8*lfs->cfg->lookahead_size,
 638:Core/Src/littlefs/lfs.c ****             lfs->lookahead.ckpoint);
 639:Core/Src/littlefs/lfs.c **** 
 640:Core/Src/littlefs/lfs.c ****     // find mask of free blocks from tree
 641:Core/Src/littlefs/lfs.c ****     memset(lfs->lookahead.buffer, 0, lfs->cfg->lookahead_size);
 642:Core/Src/littlefs/lfs.c ****     int err = lfs_fs_traverse_(lfs, lfs_alloc_lookahead, lfs, true);
 643:Core/Src/littlefs/lfs.c ****     if (err) {
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 24


 644:Core/Src/littlefs/lfs.c ****         lfs_alloc_drop(lfs);
 645:Core/Src/littlefs/lfs.c ****         return err;
 646:Core/Src/littlefs/lfs.c ****     }
 647:Core/Src/littlefs/lfs.c **** 
 648:Core/Src/littlefs/lfs.c ****     return 0;
 649:Core/Src/littlefs/lfs.c **** }
 650:Core/Src/littlefs/lfs.c **** #endif
 651:Core/Src/littlefs/lfs.c **** 
 652:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
 653:Core/Src/littlefs/lfs.c **** static int lfs_alloc(lfs_t *lfs, lfs_block_t *block) {
 654:Core/Src/littlefs/lfs.c ****     while (true) {
 655:Core/Src/littlefs/lfs.c ****         // scan our lookahead buffer for free blocks
 656:Core/Src/littlefs/lfs.c ****         while (lfs->lookahead.next < lfs->lookahead.size) {
 657:Core/Src/littlefs/lfs.c ****             if (!(lfs->lookahead.buffer[lfs->lookahead.next / 8]
 658:Core/Src/littlefs/lfs.c ****                     & (1U << (lfs->lookahead.next % 8)))) {
 659:Core/Src/littlefs/lfs.c ****                 // found a free block
 660:Core/Src/littlefs/lfs.c ****                 *block = (lfs->lookahead.start + lfs->lookahead.next)
 661:Core/Src/littlefs/lfs.c ****                         % lfs->block_count;
 662:Core/Src/littlefs/lfs.c **** 
 663:Core/Src/littlefs/lfs.c ****                 // eagerly find next free block to maximize how many blocks
 664:Core/Src/littlefs/lfs.c ****                 // lfs_alloc_ckpoint makes available for scanning
 665:Core/Src/littlefs/lfs.c ****                 while (true) {
 666:Core/Src/littlefs/lfs.c ****                     lfs->lookahead.next += 1;
 667:Core/Src/littlefs/lfs.c ****                     lfs->lookahead.ckpoint -= 1;
 668:Core/Src/littlefs/lfs.c **** 
 669:Core/Src/littlefs/lfs.c ****                     if (lfs->lookahead.next >= lfs->lookahead.size
 670:Core/Src/littlefs/lfs.c ****                             || !(lfs->lookahead.buffer[lfs->lookahead.next / 8]
 671:Core/Src/littlefs/lfs.c ****                                 & (1U << (lfs->lookahead.next % 8)))) {
 672:Core/Src/littlefs/lfs.c ****                         return 0;
 673:Core/Src/littlefs/lfs.c ****                     }
 674:Core/Src/littlefs/lfs.c ****                 }
 675:Core/Src/littlefs/lfs.c ****             }
 676:Core/Src/littlefs/lfs.c **** 
 677:Core/Src/littlefs/lfs.c ****             lfs->lookahead.next += 1;
 678:Core/Src/littlefs/lfs.c ****             lfs->lookahead.ckpoint -= 1;
 679:Core/Src/littlefs/lfs.c ****         }
 680:Core/Src/littlefs/lfs.c **** 
 681:Core/Src/littlefs/lfs.c ****         // In order to keep our block allocator from spinning forever when our
 682:Core/Src/littlefs/lfs.c ****         // filesystem is full, we mark points where there are no in-flight
 683:Core/Src/littlefs/lfs.c ****         // allocations with a checkpoint before starting a set of allocations.
 684:Core/Src/littlefs/lfs.c ****         //
 685:Core/Src/littlefs/lfs.c ****         // If we've looked at all blocks since the last checkpoint, we report
 686:Core/Src/littlefs/lfs.c ****         // the filesystem as out of storage.
 687:Core/Src/littlefs/lfs.c ****         //
 688:Core/Src/littlefs/lfs.c ****         if (lfs->lookahead.ckpoint <= 0) {
 689:Core/Src/littlefs/lfs.c ****             LFS_ERROR("No more free space 0x%"PRIx32,
 690:Core/Src/littlefs/lfs.c ****                     (lfs->lookahead.start + lfs->lookahead.next)
 691:Core/Src/littlefs/lfs.c ****                         % lfs->cfg->block_count);
 692:Core/Src/littlefs/lfs.c ****             return LFS_ERR_NOSPC;
 693:Core/Src/littlefs/lfs.c ****         }
 694:Core/Src/littlefs/lfs.c **** 
 695:Core/Src/littlefs/lfs.c ****         // No blocks in our lookahead buffer, we need to scan the filesystem for
 696:Core/Src/littlefs/lfs.c ****         // unused blocks in the next lookahead window.
 697:Core/Src/littlefs/lfs.c ****         int err = lfs_alloc_scan(lfs);
 698:Core/Src/littlefs/lfs.c ****         if(err) {
 699:Core/Src/littlefs/lfs.c ****             return err;
 700:Core/Src/littlefs/lfs.c ****         }
ARM GAS  C:\Users\SAKSHA~1\AppData\Local\Temp\ccxInYJG.s 			page 25


 701:Core/Src/littlefs/lfs.c ****     }
 702:Core/Src/littlefs/lfs.c **** }
 703:Core/Src/littlefs/lfs.c **** #endif
