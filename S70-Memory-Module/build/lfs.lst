5408:Core/Src/littlefs/lfs.c ****         valid = true;
5409:Core/Src/littlefs/lfs.c **** 
5410:Core/Src/littlefs/lfs.c ****         // setup dir in case it's valid
5411:Core/Src/littlefs/lfs.c ****         dir->pair[0] = tpair[(i+0) % 2];
5412:Core/Src/littlefs/lfs.c ****         dir->pair[1] = tpair[(i+1) % 2];
5413:Core/Src/littlefs/lfs.c ****         dir->off = sizeof(dir->d);
5414:Core/Src/littlefs/lfs.c ****         dir->d = test;
5415:Core/Src/littlefs/lfs.c ****     }
5416:Core/Src/littlefs/lfs.c **** 
5417:Core/Src/littlefs/lfs.c ****     if (!valid) {
5418:Core/Src/littlefs/lfs.c ****         LFS_ERROR("Corrupted dir pair at {0x%"PRIx32", 0x%"PRIx32"}",
5419:Core/Src/littlefs/lfs.c ****                 tpair[0], tpair[1]);
5420:Core/Src/littlefs/lfs.c ****         return LFS_ERR_CORRUPT;
5421:Core/Src/littlefs/lfs.c ****     }
5422:Core/Src/littlefs/lfs.c **** 
5423:Core/Src/littlefs/lfs.c ****     return 0;
5424:Core/Src/littlefs/lfs.c **** }
5425:Core/Src/littlefs/lfs.c **** 
5426:Core/Src/littlefs/lfs.c **** static int lfs1_dir_next(lfs_t *lfs, lfs1_dir_t *dir, lfs1_entry_t *entry) {
5427:Core/Src/littlefs/lfs.c ****     while (dir->off + sizeof(entry->d) > (0x7fffffff & dir->d.size)-4) {
5428:Core/Src/littlefs/lfs.c ****         if (!(0x80000000 & dir->d.size)) {
5429:Core/Src/littlefs/lfs.c ****             entry->off = dir->off;
5430:Core/Src/littlefs/lfs.c ****             return LFS_ERR_NOENT;
5431:Core/Src/littlefs/lfs.c ****         }
5432:Core/Src/littlefs/lfs.c **** 
5433:Core/Src/littlefs/lfs.c ****         int err = lfs1_dir_fetch(lfs, dir, dir->d.tail);
5434:Core/Src/littlefs/lfs.c ****         if (err) {
5435:Core/Src/littlefs/lfs.c ****             return err;
5436:Core/Src/littlefs/lfs.c ****         }
5437:Core/Src/littlefs/lfs.c **** 
5438:Core/Src/littlefs/lfs.c ****         dir->off = sizeof(dir->d);
5439:Core/Src/littlefs/lfs.c ****         dir->pos += sizeof(dir->d) + 4;
5440:Core/Src/littlefs/lfs.c ****     }
5441:Core/Src/littlefs/lfs.c **** 
5442:Core/Src/littlefs/lfs.c ****     int err = lfs1_bd_read(lfs, dir->pair[0], dir->off,
5443:Core/Src/littlefs/lfs.c ****             &entry->d, sizeof(entry->d));
5444:Core/Src/littlefs/lfs.c ****     lfs1_entry_fromle32(&entry->d);
5445:Core/Src/littlefs/lfs.c ****     if (err) {
5446:Core/Src/littlefs/lfs.c ****         return err;
5447:Core/Src/littlefs/lfs.c ****     }
5448:Core/Src/littlefs/lfs.c **** 
5449:Core/Src/littlefs/lfs.c ****     entry->off = dir->off;
5450:Core/Src/littlefs/lfs.c ****     dir->off += lfs1_entry_size(entry);
5451:Core/Src/littlefs/lfs.c ****     dir->pos += lfs1_entry_size(entry);
5452:Core/Src/littlefs/lfs.c ****     return 0;
5453:Core/Src/littlefs/lfs.c **** }
