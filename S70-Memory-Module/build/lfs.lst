5302:Core/Src/littlefs/lfs.c ****         lfs_off_t off, void *buffer, lfs_size_t size) {
5303:Core/Src/littlefs/lfs.c ****     // if we ever do more than writes to alternating pairs,
5304:Core/Src/littlefs/lfs.c ****     // this may need to consider pcache
5305:Core/Src/littlefs/lfs.c ****     return lfs_bd_read(lfs, &lfs->pcache, &lfs->rcache, size,
5306:Core/Src/littlefs/lfs.c ****             block, off, buffer, size);
5307:Core/Src/littlefs/lfs.c **** }
5308:Core/Src/littlefs/lfs.c **** 
5309:Core/Src/littlefs/lfs.c **** static int lfs1_bd_crc(lfs_t *lfs, lfs_block_t block,
5310:Core/Src/littlefs/lfs.c ****         lfs_off_t off, lfs_size_t size, uint32_t *crc) {
5311:Core/Src/littlefs/lfs.c ****     for (lfs_off_t i = 0; i < size; i++) {
5312:Core/Src/littlefs/lfs.c ****         uint8_t c;
5313:Core/Src/littlefs/lfs.c ****         int err = lfs1_bd_read(lfs, block, off+i, &c, 1);
5314:Core/Src/littlefs/lfs.c ****         if (err) {
5315:Core/Src/littlefs/lfs.c ****             return err;
5316:Core/Src/littlefs/lfs.c ****         }
5317:Core/Src/littlefs/lfs.c **** 
5318:Core/Src/littlefs/lfs.c ****         lfs1_crc(crc, &c, 1);
5319:Core/Src/littlefs/lfs.c ****     }
5320:Core/Src/littlefs/lfs.c **** 
5321:Core/Src/littlefs/lfs.c ****     return 0;
5322:Core/Src/littlefs/lfs.c **** }
