4062:Core/Src/littlefs/lfs.c **** static lfs_ssize_t lfs_getattr_(lfs_t *lfs, const char *path,
4063:Core/Src/littlefs/lfs.c ****         uint8_t type, void *buffer, lfs_size_t size) {
4064:Core/Src/littlefs/lfs.c ****     lfs_mdir_t cwd;
