2450:Core/Src/littlefs/lfs.c ****         }
2451:Core/Src/littlefs/lfs.c **** 
2452:Core/Src/littlefs/lfs.c ****         // update internally tracked dirs
2453:Core/Src/littlefs/lfs.c ****         for (struct lfs_mlist *d = lfs->mlist; d; d = d->next) {
2454:Core/Src/littlefs/lfs.c ****             if (lfs_pair_cmp(lpair, d->m.pair) == 0) {
2455:Core/Src/littlefs/lfs.c ****                 d->m.pair[0] = ldir.pair[0];
2456:Core/Src/littlefs/lfs.c ****                 d->m.pair[1] = ldir.pair[1];
2457:Core/Src/littlefs/lfs.c ****             }
2458:Core/Src/littlefs/lfs.c **** 
2459:Core/Src/littlefs/lfs.c ****             if (d->type == LFS_TYPE_DIR &&
2460:Core/Src/littlefs/lfs.c ****                     lfs_pair_cmp(lpair, ((lfs_dir_t*)d)->head) == 0) {
2461:Core/Src/littlefs/lfs.c ****                 ((lfs_dir_t*)d)->head[0] = ldir.pair[0];
2462:Core/Src/littlefs/lfs.c ****                 ((lfs_dir_t*)d)->head[1] = ldir.pair[1];
