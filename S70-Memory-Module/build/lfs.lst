2066:Core/Src/littlefs/lfs.c **** 
2067:Core/Src/littlefs/lfs.c **** relocate:
2068:Core/Src/littlefs/lfs.c ****         // commit was corrupted, drop caches and prepare to relocate block
2069:Core/Src/littlefs/lfs.c ****         relocated = true;
