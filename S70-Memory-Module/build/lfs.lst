 283:Core/Src/littlefs/lfs.c **** 
 284:Core/Src/littlefs/lfs.c **** /// Small type-level utilities ///
 285:Core/Src/littlefs/lfs.c **** // operations on block pairs
 286:Core/Src/littlefs/lfs.c **** static inline void lfs_pair_swap(lfs_block_t pair[2]) {
 287:Core/Src/littlefs/lfs.c ****     lfs_block_t t = pair[0];
 288:Core/Src/littlefs/lfs.c ****     pair[0] = pair[1];
 289:Core/Src/littlefs/lfs.c ****     pair[1] = t;
 290:Core/Src/littlefs/lfs.c **** }
 291:Core/Src/littlefs/lfs.c **** 
 292:Core/Src/littlefs/lfs.c **** static inline bool lfs_pair_isnull(const lfs_block_t pair[2]) {
 293:Core/Src/littlefs/lfs.c ****     return pair[0] == LFS_BLOCK_NULL || pair[1] == LFS_BLOCK_NULL;
 294:Core/Src/littlefs/lfs.c **** }
 295:Core/Src/littlefs/lfs.c **** 
 296:Core/Src/littlefs/lfs.c **** static inline int lfs_pair_cmp(
