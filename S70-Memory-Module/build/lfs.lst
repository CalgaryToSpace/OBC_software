2267:Core/Src/littlefs/lfs.c ****         }
2268:Core/Src/littlefs/lfs.c **** 
2269:Core/Src/littlefs/lfs.c ****         // commit any global diffs if we have any
2270:Core/Src/littlefs/lfs.c ****         lfs_gstate_t delta = {0};
2271:Core/Src/littlefs/lfs.c ****         lfs_gstate_xor(&delta, &lfs->gstate);
