5124:Core/Src/littlefs/lfs.c **** #ifndef LFS_READONLY
5125:Core/Src/littlefs/lfs.c **** static int lfs_fs_gc_(lfs_t *lfs) {
5126:Core/Src/littlefs/lfs.c ****     // force consistency, even if we're not necessarily going to write,
5127:Core/Src/littlefs/lfs.c ****     // because this function is supposed to take care of janitorial work
5128:Core/Src/littlefs/lfs.c ****     // isn't it?
5129:Core/Src/littlefs/lfs.c ****     int err = lfs_fs_forceconsistency(lfs);
5130:Core/Src/littlefs/lfs.c ****     if (err) {
5131:Core/Src/littlefs/lfs.c ****         return err;
5132:Core/Src/littlefs/lfs.c ****     }
5133:Core/Src/littlefs/lfs.c **** 
5134:Core/Src/littlefs/lfs.c ****     // try to compact metadata pairs, note we can't really accomplish
5135:Core/Src/littlefs/lfs.c ****     // anything if compact_thresh doesn't at least leave a prog_size
5136:Core/Src/littlefs/lfs.c ****     // available
5137:Core/Src/littlefs/lfs.c ****     if (lfs->cfg->compact_thresh
5138:Core/Src/littlefs/lfs.c ****             < lfs->cfg->block_size - lfs->cfg->prog_size) {
5139:Core/Src/littlefs/lfs.c ****         // iterate over all mdirs
5140:Core/Src/littlefs/lfs.c ****         lfs_mdir_t mdir = {.tail = {0, 1}};
5141:Core/Src/littlefs/lfs.c ****         while (!lfs_pair_isnull(mdir.tail)) {
5142:Core/Src/littlefs/lfs.c ****             err = lfs_dir_fetch(lfs, &mdir, mdir.tail);
5143:Core/Src/littlefs/lfs.c ****             if (err) {
5144:Core/Src/littlefs/lfs.c ****                 return err;
5145:Core/Src/littlefs/lfs.c ****             }
5146:Core/Src/littlefs/lfs.c **** 
5147:Core/Src/littlefs/lfs.c ****             // not erased? exceeds our compaction threshold?
5148:Core/Src/littlefs/lfs.c ****             if (!mdir.erased || ((lfs->cfg->compact_thresh == 0)
5149:Core/Src/littlefs/lfs.c ****                     ? mdir.off > lfs->cfg->block_size - lfs->cfg->block_size/8
5150:Core/Src/littlefs/lfs.c ****                     : mdir.off > lfs->cfg->compact_thresh)) {
5151:Core/Src/littlefs/lfs.c ****                 // the easiest way to trigger a compaction is to mark
5152:Core/Src/littlefs/lfs.c ****                 // the mdir as unerased and add an empty commit
5153:Core/Src/littlefs/lfs.c ****                 mdir.erased = false;
5154:Core/Src/littlefs/lfs.c ****                 err = lfs_dir_commit(lfs, &mdir, NULL, 0);
5155:Core/Src/littlefs/lfs.c ****                 if (err) {
5156:Core/Src/littlefs/lfs.c ****                     return err;
5157:Core/Src/littlefs/lfs.c ****                 }
5158:Core/Src/littlefs/lfs.c ****             }
