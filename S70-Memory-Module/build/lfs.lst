3522:Core/Src/littlefs/lfs.c ****         if (err) {
3523:Core/Src/littlefs/lfs.c ****             return err;
3524:Core/Src/littlefs/lfs.c ****         }
3525:Core/Src/littlefs/lfs.c ****     }
3526:Core/Src/littlefs/lfs.c **** #endif
3527:Core/Src/littlefs/lfs.c **** 
3528:Core/Src/littlefs/lfs.c ****     return lfs_file_flushedread(lfs, file, buffer, size);
