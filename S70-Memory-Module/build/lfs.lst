2250:Core/Src/littlefs/lfs.c ****             .end = (lfs->cfg->metadata_max ?
2251:Core/Src/littlefs/lfs.c ****                 lfs->cfg->metadata_max : lfs->cfg->block_size) - 8,
2252:Core/Src/littlefs/lfs.c ****         };
2253:Core/Src/littlefs/lfs.c **** 
