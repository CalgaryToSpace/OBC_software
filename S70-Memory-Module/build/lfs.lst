2682:Core/Src/littlefs/lfs.c ****     }
2683:Core/Src/littlefs/lfs.c **** 
2684:Core/Src/littlefs/lfs.c ****     return 0;
2685:Core/Src/littlefs/lfs.c **** }
2686:Core/Src/littlefs/lfs.c **** #endif
