2345:Core/Src/littlefs/lfs.c ****                         d->id -= 1;
2346:Core/Src/littlefs/lfs.c ****                         if (d->type == LFS_TYPE_DIR) {
2347:Core/Src/littlefs/lfs.c ****                             ((lfs_dir_t*)d)->pos -= 1;
2348:Core/Src/littlefs/lfs.c ****                         }
